---
/**
 * BaseLayout — shared HTML skeleton for all pages.
 *
 * Thin orchestrator. The actual content of each section was extracted
 * into partial components on 2026-05-08:
 *
 *   - partials/SeoHead.astro    : <head> contents (meta, OG, Twitter, GA4, JSON-LD)
 *   - partials/WhatsAppFab.astro: floating WhatsApp chat button
 *   - partials/StickyCta.astro  : "Talk to engineering" sticky banner (DS-10 #1)
 *   - partials/PageScript.astro : 19 client-side JS modules (sticky header,
 *                                 mobile drawer, scroll-reveal, RFQ validation,
 *                                 compare-table sort, analytics surface, etc.)
 *
 * Consumers (SnapshotLayout, etc.) pass a `seo` prop (PageSeoData)
 * and inject page content via the default <slot />.
 */
import type { PageSeoData } from "../lib/seo";
import "../styles/codex.css";
// Critical tokens inlined in <head> so :root { --codex-* } resolve before
// the main BaseLayout.css finishes downloading. ?inline runs the file
// through Vite's CSS pipeline (minification, autoprefixer) and returns
// the result as a string literal embedded in the emitted HTML. No extra
// HTTP request. See perf/critical-tokens-inline (May 2026).
import codexTokensCss from "../styles/codex-tokens.css?inline";

import SeoHead from "./partials/SeoHead.astro";
import WhatsAppFab from "./partials/WhatsAppFab.astro";
import StickyCta from "./partials/StickyCta.astro";
import PageScript from "./partials/PageScript.astro";

interface Props {
  seo: PageSeoData;
  machineJsonPath?: string;
  machineTextPath?: string;
  /** Sticky-CTA overrides (CRO 2026-06-11): EditorialPageLayout points the
   *  bar at the on-page inline RFQ; undefined keeps the engineering default
   *  declared in StickyCta.astro. */
  stickyCtaHref?: string;
  stickyCtaLabel?: string;
}

const { seo, machineJsonPath, machineTextPath, stickyCtaHref, stickyCtaLabel } = Astro.props;
---

<!doctype html>
<html {...seo.htmlAttrs}>
  <head>
    <SeoHead seo={seo} machineJsonPath={machineJsonPath} machineTextPath={machineTextPath} />
    <style set:html={codexTokensCss}></style>
    <slot name="head" />
  </head>
  <body {...seo.bodyAttrs}>
    {/* Skip-link (PR-5 a11y P0): WCAG 2.4.1 Bypass Blocks. Visually
        hidden until focused; first Tab press lifts it into view at
        the top-left. Targets #main which exists on every page (WP
        snapshot bodyHtml has <main id="main">; native Astro pages
        like /rfq/, /blog/, /compare/ all use the same id="main"). */}
    <a class="codex-skip-link" href="#main">Skip to main content</a>
    <slot />
    <WhatsAppFab />
    <StickyCta href={stickyCtaHref} label={stickyCtaLabel} />
    <PageScript />
  </body>
</html>
