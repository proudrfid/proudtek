---
/**
 * "On this page" jump-link navigation.
 *
 * Shadow component (Stage 2). Mirrors `renderJumpNav(links)` in
 * editorial-pages.ts (~line 1755). Renders nothing when links is empty.
 */
interface JumpLink {
  id: string;
  label: string;
}

interface Props {
  links: JumpLink[];
}

const { links } = Astro.props;
---
{links.length > 0 && (
  <nav class="codex-editorial-jump-nav" aria-label="On this page">
    <p class="codex-editorial-kicker">On this page</p>
    <div class="codex-editorial-jump-links">
      {links.map((link) => (
        <a class="codex-editorial-jump-link" href={`#${link.id}`}>{link.label}</a>
      ))}
    </div>
  </nav>
)}
