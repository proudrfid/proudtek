---
import SnapshotLayout from "../layouts/SnapshotLayout.astro";
import HomePageLayout from "../layouts/HomePageLayout.astro";
import { getPageByRoute } from "../lib/site-data";
import { getRouteRollout } from "../lib/rollout";

const page = await getPageByRoute("/");

if (!page) {
  throw new Error("Missing homepage snapshot. Run `npm run fetch` first.");
}

const useHomeV2 = getRouteRollout(page.route).body === "native-home";
---

{useHomeV2 ? <HomePageLayout page={page} /> : <SnapshotLayout page={page} />}
