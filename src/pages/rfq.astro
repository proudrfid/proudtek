---
/**
 * /rfq/ — Request-for-Quote wizard.
 *
 * A 5-step procurement wizard that walks B2B buyers through the four
 * questions Proud Tek's specialists ask on every first call (product
 * family, frequency, quantity, printing/encoding), then collects the
 * contact info on step 5. All five steps live in one <form>; JS toggles
 * step visibility and serializes the structured answers into a hidden
 * `message` field, then submits via fetch() to Formspree (same endpoint
 * as InlineRfqForm.astro — this is a static site, there is no WP/Kadence
 * backend). No-JS fallback: a <noscript> style override reveals all five
 * steps + the submit button and the form posts natively to Formspree
 * (Formspree renders its own thank-you page). If the fetch fails, an
 * on-page error note offers a prefilled mailto: draft so the lead is
 * never lost.
 *
 * Architecture note: this is a native Astro page (not editorial /
 * snapshot) because the wizard needs raw <form> + <fieldset> markup +
 * inline JS. The page still gets the standard BaseLayout chrome
 * (header, footer, sticky CTA, WhatsApp FAB) and a proper SEO payload
 * derived by buildPageSeo() from a minimal SnapshotPage stub.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildPageSeo, buildMachineRoute } from "../lib/seo";
import type { SnapshotPage } from "../lib/site-data";

const route = "/rfq/";
const pageStub: SnapshotPage = {
  route,
  sourceUrl: `https://proudtek.com${route}`,
  title: "Request a Quote — Custom RFID & NFC Manufacturing | Proud Tek",
  htmlAttrs: { lang: "en-US" },
  bodyAttrs: {},
  headHtml: "",
  bodyHtml:
    `<main id="main">` +
    `<h1>Request a quote for custom RFID &amp; NFC manufacturing</h1>` +
    `<p>A 5-step wizard that captures the four answers Proud Tek's specialists need before they can return a real quote — product family, frequency, annual quantity, printing &amp; encoding. Submit once and a Proud Tek RFID specialist replies within one business day with a unit price, MOQ ladder, lead time and the matching sample-pack subset.</p>` +
    `</main>`,
};
const seo = buildPageSeo(pageStub);
const machineJsonPath = buildMachineRoute(route, "json");
const machineTextPath = buildMachineRoute(route, "txt");
---

<BaseLayout seo={seo} machineJsonPath={machineJsonPath} machineTextPath={machineTextPath}>
  <Fragment set:html={seo.bodyHtml.split("<main")[0]} />

  <main id="main" class="codex-rfq-main">
    {/* PR-S1-B: visible breadcrumb. BreadcrumbList JSON-LD is emitted
        upstream by buildPageSeo; this is its user-visible counterpart. */}
    <nav class="codex-rfq-breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">Request a Quote</li>
      </ol>
    </nav>
    <section class="codex-rfq-hero">
      <p class="codex-rfq-hero__eyebrow">Quote in one form</p>
      <h1 class="codex-rfq-hero__title">Request a quote for custom RFID &amp; NFC manufacturing</h1>
      <p class="codex-rfq-hero__lede">Five short steps. Five fields. Most buyers finish in under two minutes. A Proud Tek RFID specialist replies within one business day with a unit price, MOQ ladder, lead time and a matching sample-pack subset.</p>
      <ul class="codex-rfq-hero__pill-row">
        <li>1. Product family</li>
        <li>2. Frequency band</li>
        <li>3. Annual quantity</li>
        <li>4. Printing &amp; encoding</li>
        <li>5. Contact</li>
      </ul>
    </section>

    {/* novalidate is set by JS at init (custom per-step validation). Without
        JS it stays off, so the browser's native required/email validation
        guards the visible-all-steps fallback before the native POST. */}
    <form id="rfq-wizard" class="codex-rfq" action="https://formspree.io/f/xlgorlog" method="POST">
      <input type="hidden" name="_subject" value="RFQ — proudtek.com" />
      <input type="hidden" id="rfq-payload" name="message" value="" />

      <noscript>
        {/* No-JS fallback: reveal every step + the real submit button and
            let the form POST natively to Formspree (its hosted thank-you
            page is the confirmation). The Continue/Back buttons and the
            progress rail are JS-only chrome, so hide them. */}
        <style is:inline>
          .codex-rfq__step { display: block !important; padding: 0 0 24px !important; }
          #rfq-progress, #rfq-next, #rfq-back { display: none !important; }
          #rfq-submit { display: inline-block !important; }
        </style>
        <p class="codex-rfq__help">All five steps are shown below as one form. After you press “Send my quote request” you'll see a confirmation page.</p>
      </noscript>

      <ol class="codex-rfq__progress" aria-label="Wizard progress" id="rfq-progress">
        <li class="is-active" data-step="1"><span>1</span>Product</li>
        <li data-step="2"><span>2</span>Frequency</li>
        <li data-step="3"><span>3</span>Quantity</li>
        <li data-step="4"><span>4</span>Printing</li>
        <li data-step="5"><span>5</span>Contact</li>
      </ol>

      <!-- Step 1 — product family -->
      <fieldset class="codex-rfq__step is-active" data-step="1" aria-label="Step 1 of 5: product family">
        <legend>What product family do you need?</legend>
        <p class="codex-rfq__help">Pick the closest match. We'll narrow further on step 4.</p>
        <div class="codex-rfq__grid">
          <label><input type="radio" name="rfq_product" value="RFID Cards" required /> <span><strong>RFID Cards</strong><em>MIFARE / NTAG / EM4100 / Hotel keys / Membership / Smart cards</em></span></label>
          <label><input type="radio" name="rfq_product" value="RFID Tags" /> <span><strong>RFID Tags</strong><em>Anti-metal · High-temp · Animal ear · Laundry · Tool · Asset</em></span></label>
          <label><input type="radio" name="rfq_product" value="RFID Labels / Inlays" /> <span><strong>RFID Labels / Inlays</strong><em>NFC stickers · Windshield · Apparel hang tag · Brand authentication</em></span></label>
          <label><input type="radio" name="rfq_product" value="RFID Wristbands" /> <span><strong>RFID Wristbands</strong><em>Silicone · Tyvek / Fabric · Hotel · Event · Hospital</em></span></label>
          <label><input type="radio" name="rfq_product" value="RFID Keyfobs" /> <span><strong>RFID Keyfobs</strong><em>Proximity · DESFire · T5577 · Multi-protocol</em></span></label>
          <label><input type="radio" name="rfq_product" value="RFID Readers / Encoders" /> <span><strong>RFID Readers / Encoders</strong><em>ACR122U · Desktop · Fixed UHF · Handheld · Bluetooth</em></span></label>
          <label><input type="radio" name="rfq_product" value="Not sure yet" /> <span><strong>Not sure yet</strong><em>We'll help you scope it on the follow-up call.</em></span></label>
        </div>
      </fieldset>

      <!-- Step 2 — frequency -->
      <fieldset class="codex-rfq__step" data-step="2" aria-label="Step 2 of 5: frequency band">
        <legend>Which frequency band?</legend>
        <p class="codex-rfq__help">If you already have a reader fleet, match its band. If not, pick the closest application; we'll confirm.</p>
        <div class="codex-rfq__grid">
          <label><input type="radio" name="rfq_frequency" value="LF 125 kHz" required /> <span><strong>LF — 125 kHz</strong><em>EM4100 · EM4305 · T5577 · HID Prox · Hotel proximity · Animal ID · Legacy access</em></span></label>
          <label><input type="radio" name="rfq_frequency" value="HF 13.56 MHz / NFC" /> <span><strong>HF — 13.56 MHz / NFC</strong><em>MIFARE Classic / Plus / DESFire · NTAG21x · NTAG424 DNA · ICODE SLIX · Hotel · Library · Smartphone tap</em></span></label>
          <label><input type="radio" name="rfq_frequency" value="UHF RAIN 860–960 MHz" /> <span><strong>UHF — 860–960 MHz RAIN</strong><em>Impinj Monza · NXP UCODE · Alien Higgs · Retail apparel · Industrial laundry · Logistics · Events</em></span></label>
          <label><input type="radio" name="rfq_frequency" value="Dual-frequency (LF+HF)" /> <span><strong>Dual-frequency (LF + HF)</strong><em>Migration deployments · Multi-reader buildings</em></span></label>
          <label><input type="radio" name="rfq_frequency" value="Not sure" /> <span><strong>Not sure</strong><em>We'll recommend based on your application.</em></span></label>
        </div>
      </fieldset>

      <!-- Step 3 — quantity -->
      <fieldset class="codex-rfq__step" data-step="3" aria-label="Step 3 of 5: annual quantity">
        <legend>Estimated annual quantity?</legend>
        <p class="codex-rfq__help">Pick the tier closest to year 1. Multi-year volume commitments unlock additional pricing.</p>
        <div class="codex-rfq__grid codex-rfq__grid--tight">
          <label><input type="radio" name="rfq_quantity" value="Under 5,000" required /> <span><strong>&lt; 5,000</strong><em>Pilot / proof of concept</em></span></label>
          <label><input type="radio" name="rfq_quantity" value="5,000 – 50,000" /> <span><strong>5k – 50k</strong><em>Single-site or single-event programme</em></span></label>
          <label><input type="radio" name="rfq_quantity" value="50,000 – 250,000" /> <span><strong>50k – 250k</strong><em>Multi-site / regional rollout</em></span></label>
          <label><input type="radio" name="rfq_quantity" value="250,000 – 1,000,000" /> <span><strong>250k – 1M</strong><em>Mid-tier enterprise programme</em></span></label>
          <label><input type="radio" name="rfq_quantity" value="1,000,000+" /> <span><strong>1M+</strong><em>Tier-1 enterprise / mass-volume</em></span></label>
        </div>
      </fieldset>

      <!-- Step 4 — printing & encoding -->
      <fieldset class="codex-rfq__step" data-step="4" aria-label="Step 4 of 5: printing and encoding">
        <legend>Printing &amp; encoding requirements?</legend>
        <p class="codex-rfq__help">Tick all that apply. We'll quote each item explicitly in the response.</p>
        <div class="codex-rfq__checkbox-grid">
          <label><input type="checkbox" name="rfq_options" value="CMYK 1-side printing" /> <span>CMYK 1-side printing</span></label>
          <label><input type="checkbox" name="rfq_options" value="CMYK 2-side printing" /> <span>CMYK 2-side printing</span></label>
          <label><input type="checkbox" name="rfq_options" value="Spot UV / specialty finish" /> <span>Spot UV / specialty finish</span></label>
          <label><input type="checkbox" name="rfq_options" value="Variable data / serial number print" /> <span>Variable data / serial number print</span></label>
          <label><input type="checkbox" name="rfq_options" value="Sector / EPC pre-encoding" /> <span>Sector / EPC pre-encoding</span></label>
          <label><input type="checkbox" name="rfq_options" value="NDEF / NFC URL programming" /> <span>NDEF / NFC URL programming</span></label>
          <label><input type="checkbox" name="rfq_options" value="GS1 SGTIN-96 encoding" /> <span>GS1 SGTIN-96 encoding</span></label>
          <label><input type="checkbox" name="rfq_options" value="Magnetic stripe" /> <span>Magnetic stripe</span></label>
          <label><input type="checkbox" name="rfq_options" value="Hole punch / lanyard slot" /> <span>Hole punch / lanyard slot</span></label>
          <label><input type="checkbox" name="rfq_options" value="None — chip + blank body only" /> <span>None — chip + blank body only</span></label>
        </div>
        <label class="codex-rfq__text-field">
          <span>Target launch date <em>(optional)</em></span>
          <input type="text" name="rfq_launch" placeholder="e.g. Q3 2026, or 8 weeks from PO" />
        </label>
      </fieldset>

      <!-- Step 5 — contact -->
      <fieldset class="codex-rfq__step" data-step="5" aria-label="Step 5 of 5: contact details">
        <legend>How should the specialist reach you?</legend>
        <p class="codex-rfq__help">Five fields, business email accepted. We do not share contact data with third parties.</p>
        <label class="codex-rfq__text-field">
          <span>Your name <em>*</em></span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label class="codex-rfq__text-field">
          <span>Business email <em>*</em></span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label class="codex-rfq__text-field">
          <span>Country / region <em>*</em></span>
          <input type="text" name="country" autocomplete="country-name" placeholder="e.g. United States, Germany, UAE" required />
        </label>
        <label class="codex-rfq__text-field">
          <span>Company name <em>(optional)</em></span>
          <input type="text" name="company" autocomplete="organization" />
        </label>
        <label class="codex-rfq__text-field">
          <span>Anything else we should know? <em>(optional)</em></span>
          <textarea name="rfq_notes" rows="3" placeholder="Reader vendor, lock platform, chip preference, regulatory regime, or any constraint that should shape the quote."></textarea>
        </label>
        <!-- Honeypot — `_gotcha` is Formspree's native trap: submissions
             that fill it are silently discarded server-side, JS or no JS. -->
        <input class="codex-rfq__hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
      </fieldset>

      <div class="codex-rfq__actions">
        <button type="button" class="codex-rfq__btn codex-rfq__btn--back" id="rfq-back" disabled>← Back</button>
        <button type="button" class="codex-rfq__btn codex-rfq__btn--next" id="rfq-next">Continue →</button>
        <button type="submit" class="codex-rfq__btn codex-rfq__btn--submit" id="rfq-submit" hidden>Send my quote request</button>
      </div>

      {/* Shown only if the Formspree fetch fails — keeps the form intact and
          offers a mailto: draft prefilled with the wizard answers (the
          no-backend safety net; href is set by JS just before reveal). */}
      <p class="codex-rfq__error-note" id="rfq-error" role="alert" hidden>
        Sorry — your request couldn't be sent just now. Please try again in a minute, or
        <a id="rfq-error-mailto" href="mailto:info@proudtek.com">email your answers to info@proudtek.com</a>
        (the link opens a draft with everything you entered already filled in).
      </p>

      <p class="codex-rfq__small">Reply window: one business day, Mon–Fri, GMT+8. For an urgent reply WhatsApp <a href="https://wa.me/8618665820632">+86 186 6582 0632</a>.</p>
    </form>

    {/* Success panel — swapped in for the form after a confirmed Formspree
        202/200 response. tabindex=-1 lets JS move focus here for SR users. */}
    <section class="codex-rfq codex-rfq-success" id="rfq-success" tabindex="-1" aria-label="Request received" hidden>
      <h2>Request received</h2>
      <p>Thanks — your RFQ is with our specialists. We reply within <strong>one business day</strong> (Mon–Fri, GMT+8) with a unit price, MOQ ladder, lead time and the matching sample-pack subset.</p>
      <p>Need it faster, or want to attach artwork or specs?
        <a id="rfq-success-mailto" href="mailto:info@proudtek.com">Email info@proudtek.com</a> or
        WhatsApp <a href="https://wa.me/8618665820632">+86 186 6582 0632</a>.</p>
    </section>

    <aside class="codex-rfq-aside" aria-label="Before you send">
      <h2>Before you send</h2>
      <ul>
        <li><a href="/sample-pack/">Request a free sample pack</a> first if you haven't held a chip in your hand. Most procurement teams short-list with samples in week 1 and send the RFQ in week 2.</li>
        <li><a href="/case-studies/">Read a case study</a> in your industry — chip choice, alternatives rejected, volume and measured results from a comparable deployment.</li>
        <li><a href="/compare/">Settle the chip-family question</a> first in the compare library. Saves a round of clarifying email.</li>
      </ul>
    </aside>
  </main>

  <script is:inline>
    (function () {
      const wizard = document.getElementById("rfq-wizard");
      if (!wizard) return;
      // JS path owns validation (per-step, custom error styling) — switch
      // off the browser's native bubbles. No-JS keeps native validation.
      wizard.setAttribute("novalidate", "novalidate");
      const steps = Array.from(wizard.querySelectorAll(".codex-rfq__step"));
      const progress = Array.from(document.querySelectorAll("#rfq-progress li"));
      const backBtn = document.getElementById("rfq-back");
      const nextBtn = document.getElementById("rfq-next");
      const submitBtn = document.getElementById("rfq-submit");
      const payloadInput = document.getElementById("rfq-payload");

      let current = 0;
      const total = steps.length;

      // Query-param prefill: /rfq/?product=rfid-cards&freq=uhf&qty=mid
      // Lets a product/solution page deep-link into the wizard pre-answered
      // (see CommercialTerms.astro, which passes ?product=<cluster slug> from
      // every SKU page's "Full terms in your quote" link) so the buyer sees
      // "we already know what you're looking at" instead of re-entering it.
      // Each param is checked independently and silently ignored if missing
      // or unrecognized — this only ever helps, never blocks the manual flow.
      // The wizard only jumps PAST a step once every step before it is also
      // answered (steps are sequential radios, all required), so a lone
      // ?freq= or ?qty= with no ?product= still pre-selects that radio for
      // whenever the buyer manually reaches it, without skipping step 1.
      const PRODUCT_PARAM_MAP = {
        "rfid-cards": "RFID Cards",
        "rfid-tags": "RFID Tags",
        "rfid-labels": "RFID Labels / Inlays",
        "rfid-wristbands": "RFID Wristbands",
        "rfid-keyfobs": "RFID Keyfobs",
        "rfid-readers": "RFID Readers / Encoders",
      };
      const FREQ_PARAM_MAP = {
        lf: "LF 125 kHz",
        hf: "HF 13.56 MHz / NFC",
        uhf: "UHF RAIN 860–960 MHz",
        dual: "Dual-frequency (LF+HF)",
      };
      const QTY_PARAM_MAP = {
        pilot: "Under 5,000",
        small: "5,000 – 50,000",
        mid: "50,000 – 250,000",
        large: "250,000 – 1,000,000",
        enterprise: "1,000,000+",
      };

      function checkRadioByValue(name, value) {
        if (!value) return false;
        const el = wizard.querySelector(
          'input[name="' + name + '"][value="' + value + '"]',
        );
        if (!el) return false;
        el.checked = true;
        return true;
      }

      const searchParams = new URLSearchParams(window.location.search);
      const productPrefilled = checkRadioByValue(
        "rfq_product",
        PRODUCT_PARAM_MAP[searchParams.get("product")],
      );
      const freqPrefilled = checkRadioByValue(
        "rfq_frequency",
        FREQ_PARAM_MAP[searchParams.get("freq")],
      );
      const qtyPrefilled = checkRadioByValue(
        "rfq_quantity",
        QTY_PARAM_MAP[searchParams.get("qty")],
      );
      if (productPrefilled && freqPrefilled && qtyPrefilled) current = 3;
      else if (productPrefilled && freqPrefilled) current = 2;
      else if (productPrefilled) current = 1;

      // dataLayer push + guarded gtag bridge. The site loads plain gtag.js
      // (no GTM container), and gtag.js ignores plain-object dataLayer
      // pushes — mirror each event through gtag() so GA4 actually records
      // the funnel. Strict no-op when gtag is absent.
      function pushRfqEvent(eventName, payload) {
        try {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(Object.assign({ event: eventName }, payload));
        } catch (err) { /* ignore */ }
        try {
          if (typeof window.gtag === "function") window.gtag("event", eventName, payload || {});
        } catch (err) { /* ignore */ }
      }

      function show(index) {
        steps.forEach((s, i) => s.classList.toggle("is-active", i === index));
        progress.forEach((p, i) => p.classList.toggle("is-active", i <= index));
        backBtn.disabled = index === 0;
        nextBtn.hidden = index === total - 1;
        submitBtn.hidden = index !== total - 1;
        const firstField = steps[index].querySelector("input, textarea");
        if (firstField) setTimeout(() => firstField.focus({ preventScroll: false }), 30);
        pushRfqEvent("rfq_step_view", { rfq_step: index + 1 });
      }

      function validateCurrent() {
        const step = steps[current];
        const requiredRadios = step.querySelectorAll('input[type="radio"][required]');
        if (requiredRadios.length) {
          const name = requiredRadios[0].name;
          if (!step.querySelector('input[name="' + name + '"]:checked')) {
            step.classList.add("has-error");
            return false;
          }
        }
        const requiredText = step.querySelectorAll("input[required], textarea[required]");
        for (const f of requiredText) {
          if (!f.value.trim()) {
            f.classList.add("has-error");
            f.focus();
            return false;
          }
        }
        step.classList.remove("has-error");
        return true;
      }

      function collectAnswers() {
        const fd = new FormData(wizard);
        const lines = [
          "── Proud Tek RFQ Wizard submission ──",
          "Product family: " + (fd.get("rfq_product") || "(skipped)"),
          "Frequency band: " + (fd.get("rfq_frequency") || "(skipped)"),
          "Annual quantity: " + (fd.get("rfq_quantity") || "(skipped)"),
          "Printing & encoding: " + (fd.getAll("rfq_options").join(", ") || "None selected"),
          "Target launch: " + (fd.get("rfq_launch") || "(not specified)"),
          "Company: " + (fd.get("company") || "(not specified)"),
          "",
          "Additional notes:",
          (fd.get("rfq_notes") || "(none)"),
        ];
        payloadInput.value = lines.join("\n");
      }

      // mailto: safety net — a prefilled draft carrying the structured
      // answers + contact fields, used by both the fetch-error note and
      // the success panel's "attach artwork" link. Works with zero backend.
      function buildMailtoHref() {
        const fd = new FormData(wizard);
        const body =
          (payloadInput.value || "") +
          "\n\nName: " + (fd.get("name") || "") +
          "\nEmail: " + (fd.get("email") || "") +
          "\nCountry / region: " + (fd.get("country") || "");
        return (
          "mailto:info@proudtek.com" +
          "?subject=" + encodeURIComponent("RFQ — proudtek.com") +
          "&body=" + encodeURIComponent(body)
        );
      }

      nextBtn.addEventListener("click", () => {
        if (!validateCurrent()) return;
        if (current < total - 1) {
          current += 1;
          show(current);
        }
      });

      backBtn.addEventListener("click", () => {
        if (current > 0) {
          current -= 1;
          show(current);
        }
      });

      wizard.addEventListener("submit", (e) => {
        // JS path: always intercept and fetch() to Formspree so the buyer
        // stays on-page. (No-JS uses the native POST via the <noscript>
        // override — Formspree then shows its own thank-you page.)
        e.preventDefault();
        if (!validateCurrent()) return;
        collectAnswers();

        const errorNote = document.getElementById("rfq-error");
        if (errorNote) errorNote.hidden = true;
        const originalLabel = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";

        let request;
        try {
          request = fetch(wizard.getAttribute("action"), {
            method: "POST",
            body: new FormData(wizard),
            headers: { Accept: "application/json" },
          });
        } catch (err) {
          // fetch unavailable (very old browser): degrade to the native
          // POST — Formspree renders its hosted thank-you page instead.
          wizard.submit();
          return;
        }
        request
          .then((res) => {
            if (!res.ok) throw new Error("Formspree HTTP " + res.status);
            // Confirmed delivery: swap the form for the success panel.
            const success = document.getElementById("rfq-success");
            const successMailto = document.getElementById("rfq-success-mailto");
            if (successMailto) successMailto.setAttribute("href", buildMailtoHref());
            wizard.hidden = true;
            if (success) {
              success.hidden = false;
              success.focus();
            }
            // Funnel event fires on CONFIRMED delivery, not on attempt.
            pushRfqEvent("rfq_submit", { rfq_step: total });
            // GA4-standard lead event. `rfq_submit` is a custom name GA4's
            // lead-gen model doesn't recognize, so the Generate-leads report
            // and its "Qualified leads / Converted" tiles read 0 without this.
            // Same confirmed-delivery trigger; mark `generate_lead` as a key
            // event in GA4 Admin. Fires alongside rfq_submit (no double-count:
            // different event names).
            pushRfqEvent("generate_lead", { lead_source: "rfq_wizard", currency: "USD", value: 0 });
          })
          .catch(() => {
            // Network / endpoint failure: keep the form (nothing the buyer
            // typed is lost) and surface the mailto fallback.
            submitBtn.disabled = false;
            submitBtn.textContent = originalLabel;
            const errorMailto = document.getElementById("rfq-error-mailto");
            if (errorMailto) errorMailto.setAttribute("href", buildMailtoHref());
            if (errorNote) {
              errorNote.hidden = false;
              errorNote.scrollIntoView({ block: "nearest" });
            }
          });
      });

      wizard.addEventListener("input", (e) => {
        if (e.target instanceof HTMLElement) e.target.classList.remove("has-error");
      });

      show(current);
    })();
  </script>
</BaseLayout>
