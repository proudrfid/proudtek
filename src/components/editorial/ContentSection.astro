---
/**
 * Generic content section (h2 + mixed content blocks).
 *
 * Renders all standard fields PLUS the 8 extended section fields
 * (statBar, comparePanel, featureGrid, dataHighlight, timeline,
 * testimonial, checklist, layout) that were previously defined in
 * the schema but never rendered.
 */
import type { EditorialSectionData } from "../../lib/editorial-types";
import { detectSectionType, renderInlineLinks } from "../../lib/editorial-types";
import SectionList from "./SectionList.astro";
import DataTable from "./DataTable.astro";

interface Props {
  section: EditorialSectionData;
  id: string;
}

const { section, id } = Astro.props;
const sectionType = detectSectionType(section.title);
const typeAttr = sectionType ? { "data-section-type": sectionType } : {};

// Layout variants
const layoutClass = section.layout && section.layout !== "default"
  ? `codex-editorial-section--${section.layout}`
  : "";
---

<section
  class:list={["codex-editorial-section", layoutClass]}
  {...typeAttr}
  id={id}
>
  <h2>{section.title}</h2>

  {/* ── Intro ── */}
  {section.intro && (
    <p class="codex-editorial-section-intro">
      <Fragment set:html={renderInlineLinks(section.intro)} />
    </p>
  )}

  {/* ── Data highlight (key statistic callout) ── */}
  {section.dataHighlight && (
    <div class="codex-data-highlight">
      <span class="codex-data-highlight__value">{section.dataHighlight.value}</span>
      <div class="codex-data-highlight__body">
        <strong>{section.dataHighlight.heading}</strong>
        <p>{section.dataHighlight.text}</p>
        {section.dataHighlight.source && (
          <cite class="codex-data-highlight__source">{section.dataHighlight.source}</cite>
        )}
      </div>
    </div>
  )}

  {/* ── Stat bar (multi-stat row) ── */}
  {section.statBar && section.statBar.items.length > 0 && (
    <div class="codex-stat-bar">
      {section.statBar.items.map((item) => (
        <div class="codex-stat-bar__item">
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </div>
      ))}
    </div>
  )}

  {/* ── Image ── */}
  {section.image && (
    <figure class="codex-editorial-figure">
      <img src={section.image.src} alt={section.image.alt} loading="lazy" decoding="async" />
    </figure>
  )}

  {/* ── Paragraphs ── */}
  {(section.paragraphs ?? []).map((paragraph) => (
    <p><Fragment set:html={renderInlineLinks(paragraph)} /></p>
  ))}

  {/* ── Bullets / step list ── */}
  {section.bullets && section.bullets.length > 0 && (
    <SectionList bullets={section.bullets} sectionTitle={section.title} />
  )}

  {/* ── Feature grid ── */}
  {section.featureGrid && section.featureGrid.features.length > 0 && (
    <div class="codex-feature-grid">
      {section.featureGrid.features.map((f) => (
        <div class="codex-feature-grid__item">
          <span class="codex-feature-grid__icon" aria-hidden="true">{f.icon}</span>
          <strong>{f.title}</strong>
          <p>{f.text}</p>
        </div>
      ))}
    </div>
  )}

  {/* ── Compare panel (before / after) ── */}
  {section.comparePanel && (
    <div class="codex-compare-panel">
      <div class="codex-compare-panel__col codex-compare-panel__before">
        <h3>{section.comparePanel.beforeHeading ?? "Without"}</h3>
        <ul>
          {section.comparePanel.before.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="codex-compare-panel__col codex-compare-panel__after">
        <h3>{section.comparePanel.afterHeading ?? "With"}</h3>
        <ul>
          {section.comparePanel.after.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  )}

  {/* ── Timeline ── */}
  {section.timeline && section.timeline.items.length > 0 && (
    <ol class="codex-timeline">
      {section.timeline.items.map((item) => (
        <li class="codex-timeline__item">
          <strong class="codex-timeline__label">{item.label}</strong>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  )}

  {/* ── Checklist ── */}
  {section.checklist && section.checklist.length > 0 && (
    <ul class="codex-checklist">
      {section.checklist.map((item) => (
        <li class="codex-checklist__item">{item}</li>
      ))}
    </ul>
  )}

  {/* ── Data table ── */}
  {section.table && <DataTable table={section.table} />}

  {/* ── Testimonial ── */}
  {section.testimonial && (
    <blockquote class="codex-testimonial">
      <p>{section.testimonial.text}</p>
      <cite>{section.testimonial.source}</cite>
    </blockquote>
  )}

  {/* ── Callout ── */}
  {section.callout && (
    <aside class="codex-editorial-callout">
      <strong>{section.callout.label}</strong>
      <p><Fragment set:html={renderInlineLinks(section.callout.text)} /></p>
      {section.callout.href && (
        <a href={section.callout.href} class="codex-editorial-callout__link">Learn more &rarr;</a>
      )}
    </aside>
  )}
</section>
