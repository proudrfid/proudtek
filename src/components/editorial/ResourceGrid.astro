---
/**
 * Grid of resource link cards.
 * Replaces renderResourceGrid() from editorial-pages.ts.
 */
import type { EditorialResourceCard } from "../../lib/editorial-types";
import ResourceCard from "./ResourceCard.astro";

interface Props {
  cards: EditorialResourceCard[];
  id: string;
}

const { cards, id } = Astro.props;
---

<section class="codex-editorial-section codex-editorial-resource-shell" id={id}>
  <h2>Useful next pages</h2>
  <p class="codex-editorial-section-intro">Use these linked product, guide and comparison pages to keep the next click specific and practical.</p>
  <div class="codex-editorial-resource-grid">
    {cards.map((card) => <ResourceCard card={card} />)}
  </div>
</section>
