---
/**
 * StickyCta — DS-10 #1: highest-commitment tier of the hero /
 * action-bar / sticky CTA ladder.
 *
 *   - Hero asks for samples (low)
 *   - Action Bar asks for a quote (medium)
 *   - Sticky (this) asks for an engineering call (high)
 *
 * The intent= query string is read by /contact/ to preselect the
 * right form variant; data-cta-tier is read by the click handler
 * in PageScript.astro to push a window.dataLayer event.
 *
 * CRO 2026-06-11: editorial pages retarget the bar at the on-page
 * inline RFQ (`#quick-quote`, rendered unconditionally by
 * EditorialArticle) via the href/label props — converting in place
 * beats bouncing to /contact/. Snapshot pages keep the engineering
 * default. Dismissal stays on the single shared localStorage key in
 * PageScript (a visitor who closed the bar closed the bar — the slot
 * and annoyance are identical across both variants).
 *
 * Show/hide logic + dismiss handling live in PageScript.astro.
 *
 * Extracted from BaseLayout.astro on 2026-05-08.
 */
interface Props {
  href?: string;
  label?: string;
}

const { href = "/contact/?intent=engineering", label = "Talk to engineering" } = Astro.props;
---
<div class="codex-banner codex-sticky-cta" role="region" aria-label={label}>
  <span class="codex-banner__message">Hit a spec wall? Talk it through with our engineers.</span>
  <a class="codex-banner__action codex-sticky-cta__btn" data-cta-tier="sticky" href={href}>{label}</a>
  <button class="codex-banner__dismiss codex-sticky-cta__dismiss" aria-label="Dismiss" type="button">&times;</button>
</div>
