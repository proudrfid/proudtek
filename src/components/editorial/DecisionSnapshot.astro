---
/**
 * "At a glance" decision snapshot — 3-card grid at the top of editorial body.
 *
 * Shadow component (Stage 2). Mirrors `renderDecisionSnapshot(definition, id)`
 * in editorial-pages.ts (~line 1768).
 *
 * Card data is built by `buildDecisionSnapshotCards()` which has group-
 * specific branching (compare group uses table + decision sections; others
 * use brief fields + sections). That logic stays in editorial-pages.ts; this
 * component is just rendering.
 *
 * Extra brief fields (beyond the first 2 already in cards) render as a
 * supplementary `<dl>` below the card grid.
 */
import BriefField from "./BriefField.astro";
import type { EditorialDefinition } from "../../lib/editorial-types";
import { buildDecisionSnapshotCards } from "../../lib/editorial-pages";
import { rewriteContactHref } from "../../lib/editorial-shadow-normalizers";

interface Props {
  definition: EditorialDefinition;
  id: string;
}

const { definition, id } = Astro.props;
const rawCards = buildDecisionSnapshotCards(definition);
const extraBriefFields = (definition.brief ?? []).slice(2);

// Stage 3 shadow normalizer (sprint 1): snapshot-card links that target the
// generic /contact/ route are rewritten by the legacy cheerio post-process
// to the routed inquiry path (e.g. /contact/rfid-labels-tags/). Apply the
// same rewrite at render time so the card href matches production output.
const cards = rawCards.map((card) => {
  if (!card.link) return card;
  return {
    ...card,
    link: { ...card.link, href: rewriteContactHref(card.link.href, definition.route, definition.title) },
  };
});
---
<section class="codex-editorial-section codex-editorial-snapshot" id={id}>
  <h2>At a glance</h2>
  <p class="codex-editorial-section-intro">Use these short answers to decide whether this page matches the project before moving into the detail.</p>
  <div class="codex-editorial-snapshot-grid">
    {cards.map((card) => (
      <article class="codex-card codex-editorial-snapshot-card">
        <p class="codex-editorial-answer-label">{card.label}</p>
        <p>{card.text}</p>
        {card.link && (
          <a class="codex-editorial-snapshot-link" href={card.link.href}>{card.link.label}</a>
        )}
      </article>
    ))}
  </div>
  {extraBriefFields.length > 0 && (
    <dl class="codex-editorial-brief-grid codex-editorial-brief-grid--extra">
      {extraBriefFields.map((field) => (
        <BriefField field={field} />
      ))}
    </dl>
  )}
</section>
