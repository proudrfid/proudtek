---
/**
 * Editorial section variant — horizontal row of mini-stat cells.
 *
 * Shadow component (Stage 2). Mirrors the inline expression in
 * editorial-pages.ts `const statBarHtml = section.statBar?.items?.length ? ... : ""`.
 *
 * Schema: src/lib/editorial-types.ts → EditorialSectionData["statBar"]
 *   items: Array<{ value: string; label: string }>
 *
 * Both value and label are plain-text (no inline markdown). Astro's default
 * auto-escape on `{expression}` matches the TS side's `escapeHtml()` call.
 */
interface StatBarItem {
  value: string;
  label: string;
}

interface Props {
  items: StatBarItem[];
}

const { items } = Astro.props;
---
{items.length > 0 && (
  <ul class="codex-editorial-stat-bar" role="list">
    {items.map((item) => (
      <li class="codex-editorial-stat-bar__item">
        <span class="codex-editorial-stat-bar__value">{item.value}</span>
        <span class="codex-editorial-stat-bar__label">{item.label}</span>
      </li>
    ))}
  </ul>
)}
