---
/**
 * Single brief field — one `<div>` inside the Brief `<dl>` grid.
 *
 * Shadow component (Stage 2). Mirrors `renderBriefField(field)` in
 * editorial-pages.ts (~line 2066).
 *
 * Schema: src/lib/editorial-types.ts → EditorialBriefField
 *   label:  string
 *   text?:  string                                            // optional body paragraph
 *   items?: string[]                                          // optional ul list
 *   links?: Array<{ href, label, description? }>              // optional link row
 */
interface BriefLink {
  href: string;
  label: string;
  description?: string;
}

interface BriefFieldData {
  label: string;
  text?: string;
  items?: string[];
  links?: BriefLink[];
}

interface Props {
  field: BriefFieldData;
}

const { field } = Astro.props;
---
<div class="codex-card codex-editorial-brief-card">
  <dt>{field.label}</dt>
  <dd>
    {field.text && <p>{field.text}</p>}
    {field.items && field.items.length > 0 && (
      <ul class="codex-editorial-list">
        {field.items.map((item) => <li>{item}</li>)}
      </ul>
    )}
    {field.links && field.links.length > 0 && (
      <div class="codex-editorial-brief-links">
        {field.links.map((link) => (
          <a class="codex-editorial-brief-link" href={link.href}>{link.label}</a>
        ))}
      </div>
    )}
  </dd>
</div>
