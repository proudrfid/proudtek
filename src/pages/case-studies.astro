---
/**
 * /case-studies/ — custom-designed case studies hub.
 *
 * Native .astro hub (path-3 pattern, mirrors /solutions/index.astro). Replaces
 * the previous WP-snapshot rendering of /case-studies/ with a bespoke design
 * (hero, stats, featured spotlight, 6-card story grid, industries strip,
 * testimonials, CTA). The design's own <header>/<footer> are intentionally
 * dropped — this page borrows the real WP masthead + footer via
 * extractChromeFromSnapshot() so its chrome matches the rest of the site.
 *
 * All design CSS is scoped under `.pt-cs` (see the <style is:global> block) so
 * the standalone page's global reset / body / section rules cannot leak onto
 * the shared site chrome.
 *
 * /case-studies/ must also be added to NATIVE_HUB_ROUTES in [...slug].astro
 * (so the catch-all slug generator doesn't also build it) and in
 * src/lib/seo-feeds.ts (so it still appears in the sitemap).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import type { PageSeoData } from "../lib/seo";
import { extractChromeFromSnapshot } from "../lib/seo/snapshot-chrome";
import { getPageByRoute } from "../lib/site-data";
import { SITE_ORIGIN } from "../lib/seo-content";

const ROUTE = "/case-studies/";
const CANONICAL_URL = `${SITE_ORIGIN}${ROUTE}`;

// Inter web font — matches the design. Kept in headHtml so it lands in <head>;
// the CSS keeps a system-font fallback if this fails to load.
const FONT_HEAD =
  '<link rel="preconnect" href="https://fonts.googleapis.com" />' +
  '<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />' +
  '<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />';

// ── SEO (built manually, mirroring solutions/index.astro) ──
// Reuse the real /case-studies/ snapshot title; description taken from the
// approved design's <meta name="description">.
const CS_TITLE = "Case Studies — Real RFID & NFC Deployments | Proud Tek";
const CS_DESCRIPTION =
  "See how organizations across hospitality, industry, and events use Proud Tek RFID & NFC to cut losses, speed up operations, and secure access — with measurable results.";

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE_ORIGIN + "/" },
    { "@type": "ListItem", position: 2, name: "Case Studies", item: CANONICAL_URL },
  ],
});

const collectionLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": CANONICAL_URL,
  name: "Proud Tek RFID & NFC Case Studies",
  description: CS_DESCRIPTION,
  url: CANONICAL_URL,
  isPartOf: { "@type": "WebSite", name: "Proud Tek", url: SITE_ORIGIN + "/" },
});

const seo: PageSeoData = {
  htmlAttrs: { lang: "en" },
  bodyAttrs: { class: "page-case-studies-hub" },
  headHtml: "",
  bodyHtml: "",
  kind: "collection",
  contentTitle: "Case Studies",
  title: CS_TITLE,
  description: CS_DESCRIPTION,
  canonicalUrl: CANONICAL_URL,
  robots: "index, follow",
  indexable: true,
  jsonLd: [breadcrumbLd, collectionLd],
  imageUrl: "",
  imageAlt: "Proud Tek RFID and NFC case studies",
  imageGallery: [],
  faqEntries: [],
  procurementFields: [],
  collectionSummary: [],
  collectionGuidanceFields: [],
  collectionRelatedPages: [],
  collectionSourceLinks: [],
  coreSummary: [],
  coreGuidanceFields: [],
  coreRelatedPages: [],
  coreSourceLinks: [],
  articleSummary: [],
  articleGuidanceFields: [],
  articleRelatedPages: [],
  articleSourceLinks: [],
  productRelatedPages: [],
  productSourceLinks: [],
  ogType: "website",
  articleMeta: null,
};

// ── WP chrome donor ──
// Prefer the /case-studies/ snapshot so the masthead + footer match the rest
// of the site. Fall back to /resources/ then /about/ (mirrors solutions).
const donorPage =
  (await getPageByRoute("/case-studies/")) ||
  (await getPageByRoute("/resources/")) ||
  (await getPageByRoute("/about/"));
if (!donorPage) {
  throw new Error(
    "case-studies.astro: no chrome donor snapshot (/case-studies/, /resources/, /about/ all missing)",
  );
}
const chrome = extractChromeFromSnapshot(donorPage, ROUTE);
seo.htmlAttrs = { ...chrome.htmlAttrs, ...seo.htmlAttrs };
seo.bodyAttrs = {
  ...chrome.bodyAttrs,
  ...seo.bodyAttrs,
  class: [chrome.bodyAttrs.class, seo.bodyAttrs.class].filter(Boolean).join(" "),
};
seo.headHtml = chrome.headHtml + FONT_HEAD + (seo.headHtml ?? "");
---

<BaseLayout seo={seo}>
  <Fragment set:html={chrome.beforeMainHtml} />

  <main id="main">
    <div class="pt-cs">
    <!-- HERO -->
    <section class="hero" style="padding:0">
      <span class="blob a"></span><span class="blob b"></span>
      <div class="wrap hero-inner">
        <span class="eyebrow">Case Studies</span>
        <h1>Real deployments.<br><span class="grad">Measurable results.</span></h1>
        <p class="lead">See how teams across hospitality, industry, and events put Proud Tek RFID &amp; NFC to work — cutting losses, speeding up operations, and securing access at scale, in the harshest field conditions.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#contact">Start your project
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="btn btn-ghost" href="#stories">Browse the stories</a>
        </div>
        <div class="hero-trust">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Manufacturing custom RFID since 2008 &nbsp;·&nbsp; Shipped to 40+ countries worldwide
        </div>
      </div>
    </section>

    <!-- STATS -->
    <div class="wrap stats">
      <div class="stats-grid reveal">
        <div class="stat"><div class="num">2008</div><div class="lbl">Building RFID since</div></div>
        <div class="stat"><div class="num">40<span>+</span></div><div class="lbl">Countries shipped to</div></div>
        <div class="stat"><div class="num">500M<span>+</span></div><div class="lbl">Tags produced annually</div></div>
        <div class="stat"><div class="num">99.9<span>%</span></div><div class="lbl">Field read reliability</div></div>
      </div>
    </div>

    <!-- SPOTLIGHT -->
    <section class="spotlight" id="spotlight">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">Featured deployment</span>
          <h2>How a national linen operator cut losses 73%</h2>
          <p>A closer look at a large-scale industrial laundry rollout — from the counting problem to a tag that outlives the linen it tracks.</p>
        </div>

        <div class="spot-card reveal">
          <div class="spot-media">
            <span class="badge">Industrial Laundry &amp; Hospitality</span>
            <img src="https://proudtek.com/site-assets/wp-content/uploads/2024/09/PPS_laundry_tag.jpg" alt="Proud Tek UHF RFID laundry tag heat-sealed into a hospitality linen item" loading="lazy" />
          </div>
          <div class="spot-body">
            <h3>Giving two million linens a digital identity that survives the wash</h3>
            <div class="csr">
              <div class="row"><div class="tag">Challenge</div><div class="txt">A national linen-rental operator managed <strong>2M+ items across six processing plants</strong> using manual counts. Annual shrinkage ran 8–12%, and disputes with hotel clients over delivered-vs-returned counts were constant.</div></div>
              <div class="row"><div class="tag">Solution</div><div class="txt">Proud Tek <strong>UHF laundry tags rated for 200+ industrial wash-and-press cycles</strong> were heat-sealed into every item. Tunnel readers at sortation and handheld audits captured each item automatically — no line-of-sight, no manual scanning.</div></div>
              <div class="row"><div class="tag">Results</div><div class="txt">Within two quarters, inventory accuracy reached <strong>99.6%</strong>, client billing disputes effectively disappeared, and sorting throughput climbed as staff stopped hand-counting.</div></div>
            </div>
            <div class="metrics">
              <div class="metric"><div class="m-num">99.6<span>%</span></div><div class="m-lbl">Inventory accuracy</div></div>
              <div class="metric"><div class="m-num">73<span>%</span></div><div class="m-lbl">Less linen loss</div></div>
              <div class="metric"><div class="m-num">9<span>mo</span></div><div class="m-lbl">Payback period</div></div>
            </div>
            <div class="quote">
              <p>"We finally know exactly what we own and where it is. The tags outlast the linen they're sewn into."</p>
              <div class="who">— Operations Director, national linen-rental operator</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CASE GRID -->
    <section id="stories">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow" style="justify-content:center">More customer stories</span>
          <h2>One technology, deployed across industries</h2>
          <p>From encrypted hotel keys to anti-metal tags on aerospace tooling — a selection of representative Proud Tek deployments and the numbers behind them.</p>
        </div>

        <div class="grid">

          <!-- Hotel -->
          <article class="card reveal">
            <div class="card-media">
              <span class="chip">Hospitality</span>
              <img src="https://proudtek.com/site-assets/wp-content/uploads/2023/12/rfid_hotel_key_card.jpg" alt="Custom-printed RFID hotel key card" loading="lazy" />
            </div>
            <div class="card-body">
              <h3>Encrypted key cards end cloning at a 220-property group</h3>
              <p>A hotel group running legacy 125 kHz cards faced key-cloning and slow front desks. Migrating to MIFARE DESFire EV3 encrypted cards closed the gap — and the durable print cut reorders.</p>
              <div class="card-metrics">
                <div><div class="cm-num">-35<span>%</span></div><div class="cm-lbl">Check-in time</div></div>
                <div><div class="cm-num">~0</div><div class="cm-lbl">Clone incidents</div></div>
              </div>
              <a class="card-link" href="/solutions/hotel-key-cards/">Read the story <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </article>

          <!-- Events (SVG tile) -->
          <article class="card reveal">
            <div class="tile">
              <span class="chip">Events &amp; Venues</span>
              <svg class="art" viewBox="0 0 400 196" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs><linearGradient id="g1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#1d5cff"/><stop offset="1" stop-color="#00b8bd"/></linearGradient></defs>
                <rect width="400" height="196" fill="url(#g1)"/>
                <g fill="none" stroke="#fff" stroke-opacity="0.9" stroke-width="3" stroke-linecap="round">
                  <rect x="150" y="58" width="100" height="80" rx="18"/>
                  <path d="M150 92 h100 M150 104 h100"/>
                  <circle cx="200" cy="120" r="8"/>
                </g>
                <g fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="4" stroke-linecap="round">
                  <path d="M270 70a44 44 0 0 1 0 56"/><path d="M290 55a70 70 0 0 1 0 86"/>
                  <path d="M130 70a44 44 0 0 0 0 56"/><path d="M110 55a70 70 0 0 0 0 86"/>
                </g>
              </svg>
            </div>
            <div class="card-body">
              <h3>One wristband for entry and cashless pay at a 60k festival</h3>
              <p>Gate queues and cash-handling fraud capped growth. NFC silicone wristbands merged access control with pre-loaded cashless top-ups, moving crowds and lifting on-site spend.</p>
              <div class="card-metrics">
                <div><div class="cm-num">2.5<span>×</span></div><div class="cm-lbl">Gate throughput</div></div>
                <div><div class="cm-num">+28<span>%</span></div><div class="cm-lbl">Cashless spend</div></div>
              </div>
              <a class="card-link" href="/solutions/rfid-event-wristbands/">Read the story <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </article>

          <!-- Manufacturing (SVG tile) -->
          <article class="card reveal">
            <div class="tile">
              <span class="chip">Manufacturing</span>
              <svg class="art" viewBox="0 0 400 196" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs><linearGradient id="g2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0a1a3c"/><stop offset="1" stop-color="#1d5cff"/></linearGradient></defs>
                <rect width="400" height="196" fill="url(#g2)"/>
                <g fill="none" stroke="#fff" stroke-opacity="0.92" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M175 70l-9 9a15 15 0 0 0 20 20l34 34a8 8 0 0 0 11-11l-34-34a15 15 0 0 0-20-20z"/>
                  <path d="M215 118l18 18"/>
                </g>
                <g fill="none" stroke="#00e0e6" stroke-opacity="0.6" stroke-width="4" stroke-linecap="round">
                  <path d="M250 66a48 48 0 0 1 0 64"/><path d="M272 50a76 76 0 0 1 0 96"/>
                </g>
                <circle cx="160" cy="150" r="4" fill="#fff" fill-opacity="0.8"/><circle cx="140" cy="60" r="4" fill="#fff" fill-opacity="0.5"/>
              </svg>
            </div>
            <div class="card-body">
              <h3>Anti-metal tags cut tool-search time 85% in aerospace MRO</h3>
              <p>A maintenance shop kept losing calibrated tools and dreaded audits. Anti-metal UHF asset tags plus fixed portals turned tool control into a background process.</p>
              <div class="card-metrics">
                <div><div class="cm-num">-85<span>%</span></div><div class="cm-lbl">Search time</div></div>
                <div><div class="cm-num">0</div><div class="cm-lbl">Lost-tool FOD</div></div>
              </div>
              <a class="card-link" href="/solutions/rfid-tool-tracking/">Read the story <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </article>

          <!-- Brand / Eco -->
          <article class="card reveal">
            <div class="card-media">
              <span class="chip">Brand Protection</span>
              <img src="https://proudtek.com/site-assets/wp-content/uploads/2024/10/Eco_RFID_card.jpg" alt="Eco-friendly wooden NFC card" loading="lazy" />
            </div>
            <div class="card-body">
              <h3>Tap-to-verify NFC cuts counterfeit reports 64%</h3>
              <p>A premium spirits brand paired tamper-evident NFC tags with sustainable wooden cards linking to a Digital Product Passport — letting buyers authenticate a bottle with one tap.</p>
              <div class="card-metrics">
                <div><div class="cm-num">300k<span>+</span></div><div class="cm-lbl">Verify scans</div></div>
                <div><div class="cm-num">-64<span>%</span></div><div class="cm-lbl">Counterfeits</div></div>
              </div>
              <a class="card-link" href="/solutions/nfc-brand-authentication/">Read the story <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </article>

          <!-- Access / MIFARE upgrade -->
          <article class="card reveal">
            <div class="card-media">
              <span class="chip">Education &amp; Access</span>
              <img src="https://proudtek.com/site-assets/wp-content/uploads/2025/11/2329aa5d-56de-495a-ae1b-e226cf35c4c7.jpg" alt="MIFARE Plus smart card for campus access control" loading="lazy" />
            </div>
            <div class="card-body">
              <h3>A campus moves 45,000 credentials to AES-128 security</h3>
              <p>Dorm access on vulnerable MIFARE Classic invited clone attacks. Migrating to MIFARE Plus EV2 / DESFire EV3 gave one secure card for doors, printing, and campus payments.</p>
              <div class="card-metrics">
                <div><div class="cm-num">-90<span>%</span></div><div class="cm-lbl">Access incidents</div></div>
                <div><div class="cm-num">45k</div><div class="cm-lbl">Credentials</div></div>
              </div>
              <a class="card-link" href="/solutions/rfid-access-control/">Read the story <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </article>

          <!-- Healthcare (SVG tile) -->
          <article class="card reveal">
            <div class="tile">
              <span class="chip">Healthcare</span>
              <svg class="art" viewBox="0 0 400 196" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs><linearGradient id="g3" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#00b8bd"/><stop offset="1" stop-color="#1d5cff"/></linearGradient></defs>
                <rect width="400" height="196" fill="url(#g3)"/>
                <g fill="none" stroke="#fff" stroke-opacity="0.95" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M120 98h34l10-22 16 44 12-30 8 16h60"/>
                </g>
                <g fill="none" stroke="#fff" stroke-opacity="0.3" stroke-width="3" stroke-linecap="round">
                  <rect x="96" y="60" width="208" height="76" rx="16"/>
                </g>
              </svg>
            </div>
            <div class="card-body">
              <h3>Wristband tags speed patient ID and end equipment hunts</h3>
              <p>A regional hospital adopted RFID patient wristbands and asset tags — cutting time spent hunting for pumps and wheelchairs while enforcing positive mother-baby matching.</p>
              <div class="card-metrics">
                <div><div class="cm-num">-60<span>%</span></div><div class="cm-lbl">Equipment search</div></div>
                <div><div class="cm-num">100<span>%</span></div><div class="cm-lbl">ID match rate</div></div>
              </div>
              <a class="card-link" href="/solutions/rfid-patient-tracking/">Read the story <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- INDUSTRIES -->
    <section id="industries" style="padding-top:20px">
      <div class="wrap">
        <div class="industries reveal">
          <div class="in-inner">
            <div>
              <span class="eyebrow" style="color:#8fb4ff">Where we deploy</span>
              <h2 style="margin-top:12px">Built for the places tags get tested</h2>
              <p>High heat, metal, moisture, chemicals, crowds. If the environment is tough on electronics, that's exactly where our engineering earns its keep.</p>
            </div>
            <div class="chips">
              <span>Hospitality</span><span>Healthcare</span><span>Events &amp; Venues</span>
              <span>Manufacturing</span><span>Retail &amp; Apparel</span><span>Logistics</span>
              <span>Laundry Services</span><span>Education</span><span>Agriculture</span>
              <span>Luxury &amp; Brand Protection</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section id="testimonials" style="background:var(--bg-alt)">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow" style="justify-content:center">In their words</span>
          <h2>Engineers who sweat the RFID physics</h2>
        </div>
        <div class="tgrid">
          <div class="tcard reveal">
            <div class="stars">★★★★★</div>
            <p>"Proud Tek engineered a tag that survives our autoclave. Nobody else would even quote it."</p>
            <div class="who"><span class="av">PL</span><div><div class="nm">Plant Manager</div><div class="rl">Industrial Laundry Group</div></div></div>
          </div>
          <div class="tcard reveal">
            <div class="stars">★★★★★</div>
            <p>"Samples in a week, production in a month. Their team actually understands read-range and antenna tuning."</p>
            <div class="who"><span class="av">SI</span><div><div class="nm">Systems Integrator</div><div class="rl">Access Control Partner</div></div></div>
          </div>
          <div class="tcard reveal">
            <div class="stars">★★★★★</div>
            <p>"Read rates held up on metal assets where our previous supplier's tags simply failed in the field."</p>
            <div class="who"><span class="av">RL</span><div><div class="nm">Reliability Lead</div><div class="rl">Aerospace MRO</div></div></div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="contact">
      <div class="wrap">
        <div class="cta-band reveal">
          <div class="c-inner">
            <span class="eyebrow" style="color:#cfe0ff;justify-content:center">Start your project</span>
            <h2 style="margin-top:14px">Have a similar challenge?</h2>
            <p>Tell us about your environment — wash cycles, materials, read range, volumes — and our engineers will spec the right tag and send free samples before you commit.</p>
            <div class="cta-actions">
              <a class="btn btn-white" href="/rfq/?route=/case-studies/" id="case-study-rfq">Request a quote
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
              <a class="btn btn-light" href="/contact/?intent=engineering&route=/case-studies/">Talk to engineering</a>
            </div>
          </div>
        </div>
      </div>
    </section>
    </div>
  </main>

  <Fragment set:html={chrome.afterMainHtml} />
</BaseLayout>

<style is:global>

  .pt-cs{
    --bg:#ffffff;
    --bg-soft:#f4f8ff;
    --bg-alt:#f7f9fc;
    --ink:#0a1a3c;
    --ink-2:#1b2a49;
    --muted:#5a6b8c;
    --muted-2:#7c89a6;
    --primary:#1d5cff;
    --primary-dark:#123fce;
    --primary-soft:#e7f0ff;
    --accent:#00b8bd;
    --border:#e6ecf5;
    --border-2:#eef2f8;
    --shadow-sm:0 1px 2px rgba(16,32,74,.05);
    --shadow-md:0 10px 30px -12px rgba(16,32,74,.18);
    --shadow-lg:0 30px 60px -22px rgba(16,32,74,.28);
    --radius:18px;
    --radius-sm:12px;
    --maxw:1200px;
  }
  .pt-cs *{box-sizing:border-box;margin:0;padding:0}
  
  .pt-cs{
    scroll-behavior:smooth;-webkit-text-size-adjust:100%;
    font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    color:var(--ink-2);
    background:var(--bg);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
  }
  .pt-cs a{color:inherit;text-decoration:none}
  .pt-cs img{max-width:100%;display:block}
  .pt-cs .wrap{width:100%;max-width:var(--maxw);margin:0 auto;padding:0 24px}
  .pt-cs h1, .pt-cs h2, .pt-cs h3{color:var(--ink);letter-spacing:-.02em;line-height:1.1;font-weight:800}
  .pt-cs .eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-size:12.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
    color:var(--primary);
  }
  .pt-cs .eyebrow::before{content:"";width:22px;height:2px;border-radius:2px;background:var(--primary)}
  .pt-cs .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:9px;
    font-weight:600;font-size:15px;line-height:1;
    padding:14px 22px;border-radius:12px;border:1px solid transparent;
