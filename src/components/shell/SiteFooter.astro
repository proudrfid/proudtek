---
import { FOOTER_SECTIONS } from "../../lib/menu-structure";
import { SITE_CONTACT } from "../../lib/seo-content";
---
<footer id="colophon" class="site-footer codex-native-footer">
  <div class="codex-native-footer__qualification">
    <div>
      <p class="codex-native-footer__eyebrow">Supplier qualification</p>
      <h2>Verify the evidence before you shortlist the tag.</h2>
      <p>Review certificate scope, manufacturing information and testing methodology—or send the project constraints directly to engineering.</p>
    </div>
    <div class="codex-native-footer__qualification-actions">
      <a class="codex-cta--primary" href="/about/certifications/">Verify credentials</a>
      <a class="codex-cta--secondary" href="/rfq/">Start an RFQ</a>
    </div>
  </div>
  <div class="codex-native-footer__main">
    <section class="codex-native-footer__brand" aria-label="Proud Tek company details">
      <a href="/" aria-label="Proud Tek home">
        <img src="/site-assets/wp-content/uploads/2024/04/proudtek-logo.png" alt="Proud Tek" width="220" height="60" loading="lazy" decoding="async" />
      </a>
      <p>Custom RFID and NFC manufacturing support for global sourcing, integration and deployment programs.</p>
      <address>
        <span>{SITE_CONTACT.address.line1}, {SITE_CONTACT.address.line2}</span>
        <span>{SITE_CONTACT.address.region}, {SITE_CONTACT.address.city}, {SITE_CONTACT.address.country}</span>
        <a href={`mailto:${SITE_CONTACT.email}`}>{SITE_CONTACT.email}</a>
        <a href={`tel:${SITE_CONTACT.phoneE164}`}>{SITE_CONTACT.phoneDisplay}</a>
        <span>{SITE_CONTACT.hours}</span>
      </address>
    </section>
    <nav class="codex-native-footer__nav" aria-label="Footer navigation">
      {FOOTER_SECTIONS.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          <ul>
            {section.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </section>
      ))}
    </nav>
  </div>
  <div class="codex-native-footer__bottom">
    <p>© {new Date().getUTCFullYear()} Proud Tek Co., Limited.</p>
    <nav aria-label="Legal">
      <a href="/about/privacy-policy/">Privacy</a>
      <a href="/about/terms-of-use/">Terms</a>
      <a href="/about/disclosures/">Disclosures</a>
    </nav>
  </div>
</footer>
