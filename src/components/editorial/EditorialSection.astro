---
/**
 * Editorial section composer — assembles all 13 sub-variant components
 * inside the `<section class="codex-editorial-section">` wrapper.
 *
 * Shadow component (Stage 2). Mirrors `renderSection()` in
 * editorial-pages.ts (~line 1865).
 *
 * Rendering order must match the TS function exactly (lines 1993-2007):
 *   1. <h2>title</h2>
 *   2. intro
 *   3. statBar
 *   3a. evidenceCards (claim / tier / verify — 2026-09-05)
 *   4. image (figure)
 *   5. paragraphs
 *   6. dataHighlight
 *   7. featureGrid
 *   8. comparePanel
 *   9. timeline
 *  10. bullets (workflow-vs-plain switch)
 *  11. checklist
 *  12. table
 *  13. testimonial
 *  14. callout
 *
 * Wrapper attributes:
 *   - `data-section-type` from detectSectionType(title) if non-empty
 *   - `data-section-layout` from section.layout if non-default
 *   - `id` from caller-provided id
 *
 * Schema: src/lib/editorial-types.ts → EditorialSectionData
 */
import {
  detectSectionType,
  type CitationCtx,
  type EditorialSectionData,
} from "../../lib/editorial-types";

import SectionIntro from "./SectionIntro.astro";
import SectionParagraphs from "./SectionParagraphs.astro";
import SectionList from "./SectionList.astro";
import StatBar from "./StatBar.astro";
import EvidenceCards from "./EvidenceCards.astro";
import EditorialFigure from "./EditorialFigure.astro";
import DataHighlight from "./DataHighlight.astro";
import FeatureGrid from "./FeatureGrid.astro";
import ComparePanel from "./ComparePanel.astro";
import Timeline from "./Timeline.astro";
import Checklist from "./Checklist.astro";
import EditorialTable from "./EditorialTable.astro";
import Testimonial from "./Testimonial.astro";
import EditorialCallout from "./EditorialCallout.astro";

interface Props {
  section: EditorialSectionData;
  id: string;
  citations?: CitationCtx;
  /**
   * Page route — when provided, EditorialFigure performs the
   * PAGE_IMAGE_OVERRIDES alt rewrite mirrored from normalize-body.ts
   * (Stage 3 sprint 1). Omit on contexts that don't need the override.
   */
  route?: string;
}

const { section, id, citations, route } = Astro.props;

const sectionType = detectSectionType(section.title);
const sectionLayout =
  section.layout && section.layout !== "default" ? section.layout : null;
---
<section
  class="codex-editorial-section"
  data-section-type={sectionType || null}
  data-section-layout={sectionLayout}
  id={id}
>
  <h2>{section.title}</h2>
  {section.intro && <SectionIntro text={section.intro} citations={citations} />}
  {section.statBar?.items?.length && <StatBar items={section.statBar.items} />}
  {section.evidenceCards?.length && <EvidenceCards cards={section.evidenceCards} />}
  {section.image && <EditorialFigure src={section.image.src} alt={section.image.alt} route={route} />}
  {section.paragraphs && section.paragraphs.length > 0 && (
    <SectionParagraphs paragraphs={section.paragraphs} citations={citations} />
  )}
  {section.dataHighlight && (
    <DataHighlight
      value={section.dataHighlight.value}
      heading={section.dataHighlight.heading}
      text={section.dataHighlight.text}
      source={section.dataHighlight.source}
      citations={citations}
    />
  )}
  {section.featureGrid?.features?.length && (
    <FeatureGrid features={section.featureGrid.features} citations={citations} />
  )}
  {section.comparePanel && (
    <ComparePanel
      beforeHeading={section.comparePanel.beforeHeading}
      afterHeading={section.comparePanel.afterHeading}
      before={section.comparePanel.before}
      after={section.comparePanel.after}
      citations={citations}
    />
  )}
  {section.timeline?.items?.length && (
    <Timeline items={section.timeline.items} citations={citations} />
  )}
  {section.bullets && section.bullets.length > 0 && (
    <SectionList title={section.title} bullets={section.bullets} citations={citations} />
  )}
  {section.checklist?.length && <Checklist items={section.checklist} citations={citations} />}
  {section.table && <EditorialTable table={section.table} />}
  {section.testimonial && (
    <Testimonial
      text={section.testimonial.text}
      source={section.testimonial.source}
      citations={citations}
    />
  )}
  {section.callout && (
    <EditorialCallout
      label={section.callout.label}
      text={section.callout.text}
      href={section.callout.href}
      citations={citations}
    />
  )}
</section>
