ialTable.astro\\" data-astro-source-loc=\\"84:13\\"> <th scope=\\"row\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"85:27\\">Operating temperature</th> <td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">-40 °C to +85 °C</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">-40 °C to +85 °C</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">-40 °C to +85 °C</td> </tr><tr data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"84:13\\"> <th scope=\\"row\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"85:27\\">Data retention</th> <td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">≥ 50 years</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">≥ 50 years</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">≥ 50 years</td> </tr><tr data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"84:13\\"> <th scope=\\"row\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"85:27\\">Endurance (writes)</th> <td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">100,000 cycles</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">100,000 cycles</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">100,000 cycles</td> </tr><tr data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"84:13\\"> <th scope=\\"row\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"85:27\\">Max read range (large antenna)</th> <td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">~1.5 m</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">~1.5 m</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">~1.2 m</td> </tr> </tbody> </table> </div>   </section> <section class=\\"codex-editorial-section codex-editorial-resource-shell\\" id=\\"useful-next-pages\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceGrid.astro\\" data-astro-source-loc=\\"31:81\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceGrid.astro\\" data-astro-source-loc=\\"32:7\\">Useful next pages</h2> <p class=\\"codex-editorial-section-intro\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceGrid.astro\\" data-astro-source-loc=\\"33:44\\">Use these linked product, guide and comparison pages to keep the next click specific and practical.</p> <div class=\\"codex-editorial-resource-grid\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceGrid.astro\\" data-astro-source-loc=\\"34:46\\"> <section class=\\"codex-card codex-editorial-card\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"31:50\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"32:7\\">ICODE SLIX product pages</h2> <p data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"33:6\\">Proud Tek HF SKUs built on ICODE SLIX / SLIX2 silicon.</p> <div class=\\"codex-editorial-link-list\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"34:42\\"> <a class=\\"codex-editorial-link-card\\" href=\\"/products/rfid-cards/icode-slix-card/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">ICODE SLIX card</strong>  </a><a class=\\"codex-editorial-link-card\\" href=\\"/products/rfid-tags/rfid-library-book-tag/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">RFID library book tag</strong>  </a><a class=\\"codex-editorial-link-card\\" href=\\"/products/rfid-tags/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">RFID tags pillar</strong>  </a><a class=\\"codex-editorial-link-card\\" href=\\"/products/rfid-labels/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">RFID labels pillar</strong>  </a><a class=\\"codex-editorial-link-card\\" href=\\"/products/rfid-tags/rfid-high-temp-silicone-tag/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">RFID high-temperature silicone tag (HF variant)</strong>  </a><a class=\\"codex-editorial-link-card\\" href=\\"/products/rfid-tags/rfid-pps-laundry-chip/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">RFID PPS laundry chip</strong>  </a> </div> </section><section class=\\"codex-card codex-editorial-card\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"31:50\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"32:7\\">Related comparisons and guides</h2> <p data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"33:6\\">ICODE SLIX in context. HF ecosystem, NFC Forum Type 5, and library deployments.</p> <div class=\\"codex-editorial-link-list\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"34:42\\"> <a class=\\"codex-editorial-link-card\\" href=\\"/guides/iso-14443-explained/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">ISO 14443 explained (proximity neighbor)</strong>  </a><a class=\\"codex-editorial-link-card\\" href=\\"/compare/uhf-vs-hf-rfid/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">UHF vs HF RFID</strong>  </a><a class=\\"codex-editorial-link-card\\" href=\\"/compare/uhf-vs-hf-rfid-laundry-tags/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">UHF vs HF laundry tags</strong>  </a><a class=\\"codex-editorial-link-card\\" href=\\"/compare/125khz-vs-13.56mhz-rfid/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">125 kHz vs 13.56 MHz RFID</strong>  </a><a class=\\"codex-editorial-link-card\\" href=\\"/guides/nfc-ndef-format-explained/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">NFC NDEF format explained</strong>  </a><a class=\\"codex-editorial-link-card\\" href=\\"/solutions/rfid-laundry-tags/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">RFID laundry tags solution</strong>  </a><a class=\\"codex-editorial-link-card\\" href=\\"/case-studies/library-icode-slix2-self-service/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">47-branch ICODE SLIX2 self-service migration</strong>  </a> </div> </section><section class=\\"codex-card codex-editorial-card\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"31:50\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"32:7\\">Authoritative external references</h2> <p data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"33:6\\">NXP, ISO, and NFC Forum documents that define ICODE SLIX.</p> <div class=\\"codex-editorial-link-list\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"34:42\\"> <a class=\\"codex-editorial-link-card\\" href=\\"https://www.nxp.com/products/rfid-nfc/nfc-hf/icode/icode-slix-standard-label-ic-is-iso-15693-compliant:SL2S2002\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">NXP ICODE SLIX product page</strong>  </a><a class=\\"codex-editorial-link-card\\" href=\\"https://www.iso.org/standard/73602.html\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"36:61\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/ResourceCard.astro\\" data-astro-source-loc=\\"37:17\\">ISO/IEC 15693-3 standard</strong>  </a> </div> </section> </div> </section> <section class=\\"codex-editorial-section\\" id=\\"faq\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"24:50\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"25:7\\">FAQ</h2> <div class=\\"codex-editorial-faq\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"26:36\\"> <details data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"28:16\\"> <summary data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"29:18\\">What&#39;s the difference between ICODE SLIX and ICODE SLIX2?</summary> <p data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"30:12\\">Memory and security. SLIX has 896 bits (112 bytes) of user memory and no password protection. SLIX2 has 2,528 bits (316 bytes) of user memory (in 79 × 4-byte blocks per NXP SL2S2602 datasheet; 2,560-bit total EEPROM including system block) plus 64-bit passwords for EAS, PRIVACY mode, and DESTROY. For most library deployments SLIX is sufficient. SLIX2 is the right choice when memory-constrained library schemas hit SLIX&#39;s 112-byte ceiling or when EAS/PRIVACY password protection is required by the library&#39;s threat model.</p> </details><details data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"28:16\\"> <summary data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"29:18\\">Can an NFC phone read ICODE SLIX tags?</summary> <p data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"30:12\\">Yes, as NFC Forum Type 5 tags. Android phones with NFC reader mode support ISO 15693 natively (since Android 4.4 Kit-Kat). iPhone supports ISO 15693 via Core NFC starting iOS 13. A SLIX tag formatted with NDEF records in NFC Type 5 layout responds to standard consumer NFC taps. Opening URLs, triggering Apple Shortcuts, launching apps. Note that the proprietary EAS and PRIVACY commands are NOT accessible to stock phone apps; only standard NFC reads/writes work.</p> </details><details data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"28:16\\"> <summary data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"29:18\\">How far can an ICODE SLIX tag be read?</summary> <p data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"30:12\\">Up to ~1.5 m with a large library-gate antenna (50 × 50 cm portal) and a typical book-inlay size tag (70 × 40 mm). Typical library gate deployment is 80-100 cm effective range on a 30 × 30 cm reader antenna. This long range is the main structural advantage over ISO 14443 (MIFARE), which is proximity-only (0-10 cm) due to its different air interface. ICODE SLIX&#39;s range comes at the cost of slower data rates and no crypto. It&#39;s a vicinity RFID, not a secure card.</p> </details><details data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"28:16\\"> <summary data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"29:18\\">What is the EAS bit used for?</summary> <p data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"30:12\\">Library anti-theft. The EAS (Electronic Article Surveillance) bit is a single hardware flag readable by the fast EAS Check command. Library staff set the bit on books currently on loan and reset it on checkout. Library gates continuously interrogate tags via EAS Check and alarm if any tag&#39;s EAS is still set when the book tries to leave the library. Because EAS Check is lightweight (no full memory read), gates process dozens of books in a patron&#39;s bag in parallel without slowing down traffic.</p> </details><details data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"28:16\\"> <summary data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"29:18\\">Is ICODE SLIX suitable for access control?</summary> <p data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"30:12\\">Not recommended for new deployments. ISO 15693 has no cryptographic authentication; SLIX2&#39;s 64-bit password is protection against casual tampering but not against determined attack. For access-control use cases, ISO 14443 with MIFARE Plus or DESFire EV3 is the standard choice; they operate at the same 13.56 MHz but with proper AES authentication. ICODE SLIX&#39;s strengths (long range, fast anti-collision, EAS) are tangential to access control.</p> </details><details data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"28:16\\"> <summary data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"29:18\\">How many ICODE SLIX tags can be read in a single inventory scan?</summary> <p data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"30:12\\">Typically 50-100 tags per 100 ms scan with a well-tuned reader, using the 16-slot anti-collision algorithm. For larger batches (500+ tags in a library tote), the reader performs multiple sequential scans and accumulates the UID list. Compared to UHF Gen2, ISO 15693&#39;s anti-collision is slower (higher read time per tag), but for the book-tag use case (50-item bag at gate) it is more than adequate.</p> </details><details data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"28:16\\"> <summary data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"29:18\\">Can I use ICODE SLIX on metal surfaces or in water?</summary> <p data-astro-source-file=\\"<project-root>/src/components/editorial/Faq.astro\\" data-astro-source-loc=\\"30:12\\">Metal requires a ferrite-backed inlay, same as any HF tag. With a 0.3-1 mm ferrite spacer, SLIX works on metal with 2-5 dB sensitivity penalty. Water is generally fine. HF is robust through moisture (books returned in wet weather read correctly). For harsh conditions (industrial laundry autoclaves, chemical immersion), use the PPS-housing or silicone-encapsulated SLIX tag variants rather than paper-inlay book labels.</p> </details> </div> </section> <section id=\\"sources\\" class=\\"codex-sources\\" aria-labelledby=\\"sources-heading\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"55:76\\"><h2 id=\\"sources-heading\\" class=\\"codex-sources-heading\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"56:60\\">Sources &amp; references</h2><p class=\\"codex-sources-lead\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"57:35\\">Primary standards, OEM datasheets and regulatory documents cited by this article. All URLs were verified on the access date shown below.</p><ol class=\\"codex-sources-list\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"58:36\\"><li id=\\"sources-1\\" class=\\"codex-sources-item\\" tabindex=\\"-1\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"60:71\\"><span class=\\"codex-sources-num\\" aria-hidden=\\"true\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"61:62\\">1.</span><a class=\\"codex-sources-link\\" href=\\"https://www.nxp.com/products/rfid-nfc/nfc-hf/icode/icode-slix-label-ic:SL2ICS2002\\" rel=\\"noopener external\\" target=\\"_blank\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"62:97\\">NXP ICODE SLIX Product Page — SL2S2002</a><span class=\\"codex-sources-meta\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"63:44\\"><span class=\\"codex-sources-publisher\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:51\\">NXP Semiconductors</span><span class=\\"codex-sources-accessed\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:208\\"> · accessed Apr 20, 2026</span></span><p class=\\"codex-sources-note\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"65:62\\">Canonical NXP product page for ICODE SLIX. Authority for the 896-bit user memory, password-protected read/write, AFI and DSFID fields, and ISO/IEC 15693 compliance referenced throughout the guide.</p></li><li id=\\"sources-2\\" class=\\"codex-sources-item\\" tabindex=\\"-1\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"60:71\\"><span class=\\"codex-sources-num\\" aria-hidden=\\"true\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"61:62\\">2.</span><a class=\\"codex-sources-link\\" href=\\"https://www.nxp.com/products/rfid-nfc/nfc-hf/icode/icode-slix2-label-ic:SL2S2602\\" rel=\\"noopener external\\" target=\\"_blank\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"62:97\\">NXP ICODE SLIX2 Product Page (SL2S2602)</a><span class=\\"codex-sources-meta\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"63:44\\"><span class=\\"codex-sources-publisher\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:51\\">NXP Semiconductors</span><span class=\\"codex-sources-accessed\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:208\\"> · accessed Apr 20, 2026</span></span><p class=\\"codex-sources-note\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"65:62\\">Product page for the next-generation ICODE SLIX2 — authority for the 2528-bit EEPROM, Fast Read capability, and NFC Forum Type 5 tag compliance discussed in the generational comparison.</p></li><li id=\\"sources-3\\" class=\\"codex-sources-item\\" tabindex=\\"-1\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"60:71\\"><span class=\\"codex-sources-num\\" aria-hidden=\\"true\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"61:62\\">3.</span><a class=\\"codex-sources-link\\" href=\\"https://www.nxp.com/docs/en/data-sheet/SL2S2002_SL2S2102.pdf\\" rel=\\"noopener external\\" target=\\"_blank\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"62:97\\">NXP ICODE SLIX Short Data Sheet (SL2S2002_SL2S2102)</a><span class=\\"codex-sources-meta\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"63:44\\"><span class=\\"codex-sources-publisher\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:51\\">NXP Semiconductors</span><span class=\\"codex-sources-accessed\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:208\\"> · accessed Apr 20, 2026</span></span><p class=\\"codex-sources-note\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"65:62\\">Short datasheet covering memory organization (32-bit blocks, AFI, DSFID, PRIVACY, PROTECT/DESTROY passwords), ISO 15693 command support and electrical characteristics used in the encyclopedia&#39;s reference tables.</p></li><li id=\\"sources-4\\" class=\\"codex-sources-item\\" tabindex=\\"-1\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"60:71\\"><span class=\\"codex-sources-num\\" aria-hidden=\\"true\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"61:62\\">4.</span><a class=\\"codex-sources-link\\" href=\\"https://www.iso.org/standard/73601.html\\" rel=\\"noopener external\\" target=\\"_blank\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"62:97\\">ISO/IEC 15693-3:2019 — Cards and security devices for personal identification — Contactless vicinity objects — Part 3: Anticollision and transmission protocol</a><span class=\\"codex-sources-meta\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"63:44\\"><span class=\\"codex-sources-publisher\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:51\\">ISO</span><span class=\\"codex-sources-date\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:126\\"> · Aug 1, 2019</span><span class=\\"codex-sources-accessed\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:208\\"> · accessed Apr 20, 2026</span></span><p class=\\"codex-sources-note\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"65:62\\">Authority for the 15693 slotted anticollision (16 slots), flag byte, UID framing and command set (Inventory, Read Single Block, Write Single Block, Lock Block) implemented by ICODE SLIX.</p></li><li id=\\"sources-5\\" class=\\"codex-sources-item\\" tabindex=\\"-1\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"60:71\\"><span class=\\"codex-sources-num\\" aria-hidden=\\"true\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"61:62\\">5.</span><a class=\\"codex-sources-link\\" href=\\"https://www.iso.org/standard/73600.html\\" rel=\\"noopener external\\" target=\\"_blank\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"62:97\\">ISO/IEC 15693-2:2019 — Part 2: Air interface and initialization</a><span class=\\"codex-sources-meta\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"63:44\\"><span class=\\"codex-sources-publisher\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:51\\">ISO</span><span class=\\"codex-sources-date\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:126\\"> · Aug 1, 2019</span><span class=\\"codex-sources-accessed\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:208\\"> · accessed Apr 20, 2026</span></span><p class=\\"codex-sources-note\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"65:62\\">Specifies the 13.56 MHz carrier, 1/256 or 1/4 pulse-position forward-link coding, and single/dual-subcarrier reverse link. Basis for the vicinity-coupling physical-layer discussion.</p></li><li id=\\"sources-6\\" class=\\"codex-sources-item\\" tabindex=\\"-1\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"60:71\\"><span class=\\"codex-sources-num\\" aria-hidden=\\"true\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"61:62\\">6.</span><a class=\\"codex-sources-link\\" href=\\"https://nfc-forum.org/our-work/specification-releases/\\" rel=\\"noopener external\\" target=\\"_blank\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"62:97\\">NFC Forum — Type 5 Tag Technical Specification</a><span class=\\"codex-sources-meta\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"63:44\\"><span class=\\"codex-sources-publisher\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:51\\">NFC Forum</span><span class=\\"codex-sources-accessed\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:208\\"> · accessed Apr 20, 2026</span></span><p class=\\"codex-sources-note\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"65:62\\">NFC Forum Type 5 tag specification that ICODE SLIX2 targets — authority for smartphone NDEF access to ISO 15693 vicinity tags on NFC-V-capable devices.</p></li><li id=\\"sources-7\\" class=\\"codex-sources-item\\" tabindex=\\"-1\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"60:71\\"><span class=\\"codex-sources-num\\" aria-hidden=\\"true\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"61:62\\">7.</span><a class=\\"codex-sources-link\\" href=\\"https://www.nxp.com/docs/en/application-note/AN11597.pdf\\" rel=\\"noopener external\\" target=\\"_blank\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"62:97\\">NXP AN11809 / AN11597 — ICODE SLIX and ICODE DNA Anti-Counterfeiting Features</a><span class=\\"codex-sources-meta\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"63:44\\"><span class=\\"codex-sources-publisher\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:51\\">NXP Semiconductors</span><span class=\\"codex-sources-accessed\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"64:208\\"> · accessed Apr 20, 2026</span></span><p class=\\"codex-sources-note\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Sources.astro\\" data-astro-source-loc=\\"65:62\\">NXP application note covering the originality signature and privacy-mode features of the ICODE family. Referenced where the guide discusses library anti-theft and supply-chain anti-counterfeiting use cases.</p></li></ol></section> <section class=\\"codex-trust-signals\\" data-astro-source-file=\\"<project-root>/src/components/editorial/TrustSignals.astro\\" data-astro-source-loc=\\"10:38\\"> <div class=\\"codex-trust-stats\\" data-astro-source-file=\\"<project-root>/src/components/editorial/TrustSignals.astro\\" data-astro-source-loc=\\"11:34\\"> <div class=\\"codex-trust-stat\\" data-astro-source-file=\\"<project-root>/src/components/editorial/TrustSignals.astro\\" data-astro-source-loc=\\"12:35\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/TrustSignals.astro\\" data-astro-source-loc=\\"13:15\\">Since 2008</strong> <span data-astro-source-file=\\"<project-root>/src/components/editorial/TrustSignals.astro\\" data-astro-source-loc=\\"14:13\\">RFID Manufacturing</span> </div> <div class=\\"codex-trust-stat\\" data-astro-source-file=\\"<project-root>/src/components/editorial/TrustSignals.astro\\" data-astro-source-loc=\\"16:35\\"> <strong data-astro-source-file=\\"<project-root>/src/components/editorial/TrustSignals.astro\\" data-astro-source-loc=\\"17:15\\">ISO 9001</strong> <span data-astro-source-file=\\"<project-root>/src/components/editorial/TrustSignals.astro\\" data-