From 3f636f90d6563e892d31c4633bcdda649d9b88a3 Mon Sep 17 00:00:00 2001
From: proudrfid <proudrfid@gmail.com>
Date: Sat, 5 Sep 2026 07:04:19 -0400
Subject: [PATCH 1/3] fix(footer): copyright uses ORGANIZATION_NAME (Shenzhen
 Proud Tek Co., Ltd)

The footer hard-coded "Proud Tek Co., Limited" while the Organization
node, certificates page and llms.txt already use the certificate holder
name "Shenzhen Proud Tek Co., Ltd" (Phase 3 C1, PR #1714). One legal
name in the visible footer; "Proud Tek Co., Limited" stays in
alternateName for entity resolution.
---
 src/components/shell/SiteFooter.astro | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/components/shell/SiteFooter.astro b/src/components/shell/SiteFooter.astro
index 8e5ef6aa..1cdd70d9 100644
--- a/src/components/shell/SiteFooter.astro
+++ b/src/components/shell/SiteFooter.astro
@@ -1,6 +1,6 @@
 ---
 import { FOOTER_SECTIONS } from "../../lib/menu-structure";
-import { SITE_CONTACT } from "../../lib/seo-content";
+import { ORGANIZATION_NAME, SITE_CONTACT } from "../../lib/seo-content";
 ---
 <footer id="colophon" class="site-footer codex-native-footer">
   <div class="codex-native-footer__qualification">
@@ -40,7 +40,7 @@ import { SITE_CONTACT } from "../../lib/seo-content";
     </nav>
   </div>
   <div class="codex-native-footer__bottom">
-    <p>© {new Date().getUTCFullYear()} Proud Tek Co., Limited.</p>
+    <p>© {new Date().getUTCFullYear()} {ORGANIZATION_NAME}.</p>
     <nav aria-label="Legal">
       <a href="/about/privacy-policy/">Privacy</a>
       <a href="/about/terms-of-use/">Terms</a>
-- 
2.34.1

