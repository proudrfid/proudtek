---
/**
 * Custom 404 page — shown for all unmatched routes.
 *
 * Provides helpful navigation:
 *  - Search-like product category links
 *  - Popular product recommendations
 *  - Clear breadcrumb back to home
 *  - Correct HTTP 404 status code (handled by Astro automatically)
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import type { PageSeoData } from "../lib/seo";

const seo: PageSeoData = {
  title: "Page Not Found | Proud Tek",
  description: "The page you're looking for doesn't exist or has been moved. Browse our RFID and NFC product catalog or contact us for help.",
  robots: "noindex,follow",
  indexable: false,
  canonicalUrl: "https://proudtek.com/404/",
  imageUrl: "https://proudtek.com/site-assets/wp-content/uploads/proudtek-og-default.jpg",
  imageAlt: "Proud Tek — Custom RFID & NFC Products",
  ogType: "website",
  kind: "page",
  htmlAttrs: { lang: "en" },
  bodyAttrs: {},
  headHtml: "",
  jsonLd: [],
  imageGallery: [],
};
---

<BaseLayout seo={seo}>
  <style>
    .error-page {
      max-width: 960px;
      margin: 0 auto;
      padding: 80px 24px 100px;
      text-align: center;
      font-family: "Inter", system-ui, -apple-system, sans-serif;
    }
    .error-code {
      font-size: clamp(5rem, 15vw, 10rem);
      font-weight: 800;
      color: #e5e7eb;
      line-height: 1;
      margin: 0;
    }
    .error-title {
      font-family: "Lora", Georgia, serif;
      font-size: clamp(1.5rem, 4vw, 2.25rem);
      font-weight: 700;
      color: #1a1a2e;
      margin: 0.5rem 0 1rem;
    }
    .error-desc {
      font-size: 1.125rem;
      color: #6b7280;
      max-width: 540px;
      margin: 0 auto 2.5rem;
      line-height: 1.6;
    }
    .error-actions {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 3.5rem;
    }
    .error-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .error-btn--primary {
      background: #c8a951;
      color: #fff;
    }
    .error-btn--primary:hover {
      background: #b8963f;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(200, 169, 81, 0.3);
    }
    .error-btn--secondary {
      background: #f3f4f6;
      color: #374151;
    }
    .error-btn--secondary:hover {
      background: #e5e7eb;
    }
    .error-divider {
      width: 60px;
      height: 3px;
      background: #c8a951;
      margin: 0 auto 2.5rem;
      border-radius: 2px;
    }
    .error-categories-title {
      font-size: 0.875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #9ca3af;
      margin: 0 0 1.25rem;
    }
    .error-categories {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
    }
    .error-cat-link {
      display: inline-block;
      padding: 10px 20px;
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 24px;
      color: #374151;
      text-decoration: none;
      font-size: 0.9375rem;
      font-weight: 500;
      transition: all 0.2s ease;
    }
    .error-cat-link:hover {
      border-color: #c8a951;
      color: #c8a951;
      box-shadow: 0 2px 8px rgba(200, 169, 81, 0.12);
    }
    .error-breadcrumb {
      margin-top: 3rem;
      font-size: 0.875rem;
      color: #9ca3af;
    }
    .error-breadcrumb a {
      color: #c8a951;
      text-decoration: none;
    }
    .error-breadcrumb a:hover {
      text-decoration: underline;
    }
  </style>

  <main class="error-page">
    <p class="error-code">404</p>
    <h1 class="error-title">Page not found</h1>
    <p class="error-desc">
      The page you're looking for doesn't exist or has been moved.
      Let's get you back on track.
    </p>

    <div class="error-actions">
      <a href="/" class="error-btn error-btn--primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Back to Home
      </a>
      <a href="/products/all/" class="error-btn error-btn--secondary">
        Browse All Products
      </a>
      <a href="/contact/" class="error-btn error-btn--secondary">
        Contact Us
      </a>
    </div>

    <div class="error-divider"></div>

    <p class="error-categories-title">Browse by category</p>
    <div class="error-categories">
      <a href="/products/rfid-cards/" class="error-cat-link">RFID Cards</a>
      <a href="/products/rfid-labels/" class="error-cat-link">RFID Labels</a>
      <a href="/products/rfid-tags/" class="error-cat-link">RFID Tags</a>
      <a href="/products/rfid-wristbands/" class="error-cat-link">RFID Wristbands</a>
      <a href="/products/rfid-keyfobs/" class="error-cat-link">RFID Keyfobs</a>
      <a href="/products/rfid-readers/" class="error-cat-link">RFID Readers</a>
      <a href="/solutions/" class="error-cat-link">Solutions</a>
      <a href="/blog/" class="error-cat-link">Blog & Guides</a>
    </div>

    <nav class="error-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> &rsaquo; Page not found
    </nav>
  </main>
</BaseLayout>
