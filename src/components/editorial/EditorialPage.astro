---
/**
 * EditorialPage — master orchestrator component.
 *
 * Composes all editorial sub-components in the correct order.
 * Applies thin-content reduction rules:
 *  - TrustSignals: only on product + industry pages (high purchase intent)
 *  - InlineRfqForm: only on product pages (direct conversion)
 *  - Sections that duplicate brief data are automatically skipped
 *  - ResourceCards that duplicate brief links are collapsed
 */
import type { EditorialDefinition, EditorialSectionData, EditorialBriefField } from "../../lib/editorial-types";
import { buildEditorialOutline, resolvePageType } from "../../lib/editorial-types";

import { getCollection } from "astro:content";
import type { EditorialAuthor } from "../../lib/editorial-types";

import Breadcrumb from "./Breadcrumb.astro";
import JumpNav from "./JumpNav.astro";
import DecisionSnapshot from "./DecisionSnapshot.astro";
import ContentSection from "./ContentSection.astro";
import ResourceGrid from "./ResourceGrid.astro";
import FaqSection from "./FaqSection.astro";
import TrustSignals from "./TrustSignals.astro";
import InlineRfqForm from "./InlineRfqForm.astro";
import ActionBar from "./ActionBar.astro";
import IndustryProductGrid from "./IndustryProductGrid.astro";
import AuthorByline from "./AuthorByline.astro";
import SourceList from "./SourceList.astro";

interface Props {
  definition: EditorialDefinition;
  illustration: { src: string; alt: string } | null;
  editorialImageMap: Map<string, { title: string; heroImage: string }>;
  wpProductImageMap: Map<string, { title: string; image: string }>;
}

const { definition, illustration, editorialImageMap, wpProductImageMap } = Astro.props;
const isContact = definition.group === "contact";

// ---------------------------------------------------------------------------
// Thin-content reduction: deduplicate sections vs brief
// ---------------------------------------------------------------------------

/** Normalize text for comparison (lowercase, collapse whitespace, strip punctuation). */
function norm(s: string): string {
  return s.toLowerCase().replace(/[^a-z0-9\s]/g, "").replace(/\s+/g, " ").trim();
}

/** Collect all brief bullet texts for dedup comparison. */
function collectBriefTexts(brief: EditorialBriefField[] | undefined): Set<string> {
  const texts = new Set<string>();
  for (const field of brief ?? []) {
    for (const item of field.items ?? []) texts.add(norm(item));
    if (field.text) texts.add(norm(field.text));
  }
  return texts;
}

/** Check if a section's content is >80% duplicated from brief data. */
function isSectionDuplicateOfBrief(
  section: EditorialSectionData,
  briefTexts: Set<string>,
): boolean {
  const bullets = section.bullets ?? [];
  if (bullets.length === 0) return false;
  const matchCount = bullets.filter((b) => briefTexts.has(norm(b))).length;
  return matchCount / bullets.length > 0.8;
}

const briefTexts = collectBriefTexts(definition.brief);

// ---------------------------------------------------------------------------
// Thin-content reduction: deduplicate resourceCards vs brief links
// ---------------------------------------------------------------------------

/** Collect all brief link hrefs for dedup. */
function collectBriefLinkHrefs(brief: EditorialBriefField[] | undefined): Set<string> {
  const hrefs = new Set<string>();
  for (const field of brief ?? []) {
    for (const link of field.links ?? []) hrefs.add(link.href);
  }
  return hrefs;
}

const briefLinkHrefs = collectBriefLinkHrefs(definition.brief);

/** Filter out resourceCards whose links are entirely covered by brief. */
const dedupedResourceCards = definition.resourceCards.filter((card) => {
  const uniqueLinks = card.links.filter((link) => !briefLinkHrefs.has(link.href));
  return uniqueLinks.length > 0;
});

// ---------------------------------------------------------------------------
// Build outline from deduped content
// ---------------------------------------------------------------------------

/** Definition with deduped sections for outline building. */
const dedupedDefinition: EditorialDefinition = {
  ...definition,
  sections: definition.sections.filter(
    (s) => !isSectionDuplicateOfBrief(s, briefTexts),
  ),
  resourceCards: dedupedResourceCards,
};

const outline = buildEditorialOutline(dedupedDefinition);
const pageType = resolvePageType(definition.group);

// ---------------------------------------------------------------------------
// Conditional rendering rules for boilerplate components
// ---------------------------------------------------------------------------

/** TrustSignals: only on high purchase-intent pages (products, industries). */
const isProductPage = definition.route.startsWith("/products/");
const isIndustryPage = definition.route.startsWith("/industries/");
const showTrustSignals = !isContact && (isProductPage || isIndustryPage);

/** InlineRfqForm: only on product pages (direct conversion intent). */
const showRfqForm = !isContact && isProductPage;

// ---------------------------------------------------------------------------
// Authority JSON-LD: emit Article.author / reviewedBy / citation when present
// ---------------------------------------------------------------------------

let authorLd: Record<string, unknown> | null = null;
let reviewerLd: Record<string, unknown> | null = null;

if (definition.authorSlug || definition.reviewedBySlug) {
  const authors = await getCollection("authors");
  const byId = new Map<string, EditorialAuthor>(
    authors.map((a) => [a.data.slug, a.data as EditorialAuthor]),
  );
  const authorEntry = definition.authorSlug ? byId.get(definition.authorSlug) : undefined;
  const reviewerEntry = definition.reviewedBySlug ? byId.get(definition.reviewedBySlug) : undefined;

  if (authorEntry) {
    authorLd = {
      "@type": "Person",
      name: authorEntry.name,
      jobTitle: authorEntry.jobTitle,
      ...(authorEntry.url ? { url: authorEntry.url } : {}),
      ...(authorEntry.sameAs && authorEntry.sameAs.length ? { sameAs: authorEntry.sameAs } : {}),
    };
  }
  if (reviewerEntry) {
    reviewerLd = {
      "@type": "Person",
      name: reviewerEntry.name,
      jobTitle: reviewerEntry.jobTitle,
      ...(reviewerEntry.url ? { url: reviewerEntry.url } : {}),
    };
  }
}
if (!authorLd && definition.author) {
  authorLd = { "@type": "Person", name: definition.author };
}
if (!reviewerLd && definition.reviewedBy) {
  reviewerLd = { "@type": "Person", name: definition.reviewedBy };
}

const citationLd = (definition.sources ?? []).map((src) => ({
  "@type": "CreativeWork",
  name: src.label,
  url: src.url,
  ...(src.publisher ? { publisher: { "@type": "Organization", name: src.publisher } } : {}),
  ...(src.publishedAt ? { datePublished: src.publishedAt } : {}),
}));

/** Build Article JSON-LD only if we have ≥1 authority signal; otherwise
 * the page-level BaseLayout JSON-LD keeps control. */
const hasAuthorityLd = !!authorLd || !!reviewerLd || citationLd.length > 0;
const articleLd = hasAuthorityLd
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: definition.title,
      description: definition.summary,
      ...(authorLd ? { author: authorLd } : {}),
      ...(reviewerLd ? { reviewedBy: reviewerLd, lastReviewed: definition.reviewedAt } : {}),
      ...(citationLd.length ? { citation: citationLd } : {}),
      ...(definition.publishedAt ? { datePublished: definition.publishedAt } : {}),
      ...(definition.modifiedAt ? { dateModified: definition.modifiedAt } : {}),
    }
  : null;
---

<div class="woocommerce kadence-woo-messages-none-woo-pages woocommerce-notices-wrapper"></div>
<div class="content-wrap">
  <article class="entry content-bg single-entry page type-page status-publish hentry codex-editorial-page">
    <div class="entry-content-wrap">
      <div class="entry-content single-content">
        <Breadcrumb definition={definition} />

        <section class="codex-editorial-hero" data-page-type={pageType}>
          <div class="codex-editorial-hero-copy">
            <p class="codex-editorial-kicker">{definition.kicker}</p>
            <h1>{definition.title}</h1>
            <div class="codex-editorial-answer" aria-label="Quick answer">
              <p class="codex-editorial-answer-label">Quick answer</p>
              <p class="codex-editorial-summary">{definition.summary}</p>
            </div>
            <ul class="codex-editorial-points">
              {definition.heroPoints.map((item) => <li>{item}</li>)}
            </ul>
            {!isContact && (
              <>
                <div class="codex-hero-cta">
                  <a class="codex-hero-cta-btn" href={definition.primaryAction.href}>{definition.primaryAction.label}</a>
                </div>
                <div class="codex-hero-trust-bar">
                  <span><strong>10+</strong> Years</span>
                  <span><strong>ISO 9001</strong></span>
                  <span><strong>500+</strong> Clients</span>
                  <span><strong>50+</strong> Countries</span>
                </div>
              </>
            )}
          </div>
          {illustration && (
            <figure class="codex-editorial-figure">
              {/* DS-15 Phase 6 #2 + #6 — width/height intrinsics give the
                  browser a 16:9 box reservation from the HTML stream
                  before CSS parses; <picture>/<source> ships the WebP
                  variant first (30–55% smaller than JPG sibling) with
                  graceful JPG fallback for the 3% of browsers without
                  WebP. WebPs are pre-built by scripts/build-image-variants.py
                  and live alongside originals in /landing-images/. */}
              {illustration.src.startsWith("/landing-images/") ? (
                <picture>
                  <source srcset={illustration.src.replace(/\.(jpe?g|png)$/i, ".webp")} type="image/webp" />
                  <img src={illustration.src} alt={illustration.alt} width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
                </picture>
              ) : (
                <img src={illustration.src} alt={illustration.alt} width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
              )}
            </figure>
          )}
        </section>

        <AuthorByline definition={definition} />

        <IndustryProductGrid
          definition={definition}
          editorialImageMap={editorialImageMap}
          wpProductImageMap={wpProductImageMap}
        />

        <DecisionSnapshot definition={dedupedDefinition} id={outline.snapshotId} />

        <JumpNav links={outline.jumpLinks} />

        {outline.filteredSections.map((section, index) => (
          <ContentSection section={section} id={outline.sectionLinks[index]?.id ?? "section"} />
        ))}

        {dedupedResourceCards.length > 0 && (
          <ResourceGrid cards={dedupedResourceCards} id={outline.resourcesId} />
        )}

        {definition.faq.length > 0 && outline.faqId && (
          <FaqSection faq={definition.faq} id={outline.faqId} />
        )}

        {outline.sourcesId && <SourceList definition={definition} id={outline.sourcesId} />}

        {showTrustSignals && <TrustSignals />}

        {showRfqForm && <InlineRfqForm title={definition.title} />}

        <ActionBar definition={definition} id={outline.nextStepId} />
      </div>
    </div>
  </article>
</div>

{articleLd && (
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
)}
