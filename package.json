{
  "name": "proudtek-astro-static",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "fetch": "node scripts/fetch-proudtek.mjs",
    "generate:fallbacks": "node scripts/generate-fallback-pages.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "prebuild": "node scripts/build-kadence-css-bundle.mjs && (if [ -n \"$VERCEL\" ] || [ -n \"$CI\" ]; then echo 'Skipping WebP gen on Vercel/CI (227 webp files pre-committed)'; else npm run images:build-webp -- --quiet; fi)",
    "build:kadence-bundle": "node scripts/build-kadence-css-bundle.mjs",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:site": "npm run fetch && npm run build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.{ts,tsx,astro}' 'eslint-rules/**/*.js'",
    "lint:fix": "npm run lint -- --fix",
    "lint:chip-claims": "node scripts/lint-chip-claims.mjs",
    "lint:chip-placeholder-drift": "node scripts/lint-chip-placeholder-drift.mjs",
    "audit:site-contract": "node scripts/site-contract-audit.mjs",
    "audit:site-contract:write": "node scripts/site-contract-audit.mjs --write-baseline",
    "chip-specs:next": "node scripts/chip-specs-next.mjs",
    "blog-voice:next": "node scripts/blog-voice-next.mjs",
    "page-voice:next": "node scripts/page-voice-next.mjs",
    "content-audit": "node scripts/content-quality-audit.mjs",
    "content-audit:worst": "node scripts/content-quality-audit.mjs --worst 40",
    "content-audit:json": "node scripts/content-quality-audit.mjs --json",
    "image-audit:next": "node scripts/image-audit-next.mjs",
    "image-audit:status": "node scripts/image-audit-next.mjs --status",
    "image-audit:report": "node scripts/image-audit-next.mjs --report",
    "lh:baseline": "npm run build && lhci autorun --config=./lighthouserc.cjs",
    "lh:collect": "lhci collect --config=./lighthouserc.cjs",
    "lh:assert": "lhci assert --config=./lighthouserc.cjs",
    "lh:ci": "lhci autorun --config=./lighthouserc.ci.cjs",
    "images:build-webp": "python3 scripts/build-image-variants.py",
    "images:rebuild-webp": "python3 scripts/build-image-variants.py --force"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^6.0.4",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.5.5",
    "tinyexec": "^1.1.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.13.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "sharp": "^0.34.5",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
