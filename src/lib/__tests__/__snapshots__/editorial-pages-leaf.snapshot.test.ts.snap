exports[`Faq.astro > 3 FAQ entries 1`] = `"<section class="codex-editorial-section" id="typical-faq" data-astro-source-file="/Users/zhangping/Projects/Playground/src/components/editorial/Faq.astro" data-astro-source-loc="24:50"> <h2 data-astro-source-file="/Users/zhangping/Projects/Playground/src/components/editorial/Faq.astro" data-astro-source-loc="25:7">FAQ</h2> <div class="codex-editorial-faq" data-astro-source-file="/Users/zhangping/Projects/Playground/src/components/editorial/Faq.astro" data-astro-source-loc="26:36"> <details data-astro-source-file="/Users/zhangping/Projects/Playground/src/components/editorial/Faq.astro" data-astro-source-loc="28:16"> <summary data-astro-source-file="/Users/zhangping/Projects/Playground/src/components/editorial/Faq.astro" data-astro-source-loc="29:18">What is RFID?</summary> <p data-astro-source-file="/Users/zhangping/Projects/Playground/src/components/editorial/Faq.astro" data-astro-source-loc="30:12">Radio-frequency identification — wireless tag-and-reader tech.</p> </details><details data-astro-source-file="/Users/zhangping/Projects/Playground/src/components/editorial/Faq.astro" data-astro-source-loc="28:16"> <summary data-astro-source-file="/Users/zhangping/Projects/Playground/src/components/editorial/Faq.astro" data-astro-source-loc="29:18">How far can a UHF RFID tag be read?</summary> <p data-astro-source-file="/Users/zhangping/Projects/Playground/src/components/editorial/Faq.astro" data-astro-source-loc="30:12">Typically 3–10 m for passive UHF tags; up to 30 m for fixed portals.</p> </details><details data-astro-source-file="/Users/zhangping/Projects/Playground/src/components/editorial/Faq.astro" data-astro-source-loc="28:16"> <summary data-astro-source-file="/Users/zhangping/Projects/Playground/src/components/editorial/Faq.astro" data-astro-source-loc="29:18">Are Walmart and Target RFID requirements interchangeable?</summary> <p data-astro-source-file="/Users/zhangping/Projects/Playground/src/components/editorial/Faq.astro" data-astro-source-loc="30:12">Mostly yes for chip and inlay; differences are in placement and EDI.</p> </details> </div> </section>"`;

