---
/**
 * Bottom-of-page "Next step" action bar.
 *
 * Shadow component (Stage 2). Mirrors `renderActionBar(definition, id)` in
 * editorial-pages.ts (~line 2413).
 *
 * Heading and description switch on `group === "contact"`. The primary CTA
 * href routes through `buildIntentHref` (intent=quote) for analytics
 * attribution per DS-10 #1.
 */
import type { EditorialDefinition, EditorialLink, EditorialGroup } from "../../lib/editorial-types";
import { buildIntentHref } from "../../lib/editorial-pages";
import { resolveArticleInquiryAction } from "../../lib/seo/normalize-body";
import { rewriteContactHref } from "../../lib/editorial-shadow-normalizers";

interface Props {
  group: EditorialGroup;
  title: string;
  route: string;
  primaryAction: EditorialLink;
  secondaryActions: EditorialLink[];
  id: string;
}

const { group, title, route, primaryAction, secondaryActions, id } = Astro.props;

// Stage 3 shadow normalizer (sprint 1): mirror normalize-body.ts's
// `a[href="/contact/"]` rewrite. The legacy cheerio selector matches
// only BARE `/contact/` hrefs (no query string), so:
//
//   - The PRIMARY CTA is routed through `buildIntentHref` below, which
//     appends `?intent=quote&route=...` BEFORE the legacy cheerio pass
//     runs. By the time cheerio scans the DOM, the primary anchor's href
//     is `/contact/?intent=quote&...` — not a bare match, no rewrite. So
//     the shadow must NOT rewrite the primary href either; the only
//     transformation is buildIntentHref. Over-rewriting here would emit
//     `/contact/<routed>/?intent=quote...`, which the legacy pipeline
//     never produces and would break the parity diff.
//
//   - SECONDARY actions are rendered with their bare href intact, so the
//     cheerio rewrite DOES match them. Apply the rewrite here.
const secondaryActionsRouted = secondaryActions.map((link) => ({
  ...link,
  href: rewriteContactHref(link.href, route, title),
}));

const isContact = group === "contact";
const heading = isContact ? "Send your project details" : "Ready to discuss your project?";
const description = isContact
  ? "The main button opens a prefilled email for this route. Use it if the project already fits, or keep reviewing the linked product and reference pages first."
  : "Use the structured RFQ when you are ready for pricing and production guidance, request samples when validation comes first, or continue into the linked product and comparison pages below.";

const mailtoSubject = encodeURIComponent(`Inquiry: ${title}`);
const mailtoBody = encodeURIComponent(
  `Hi Proud Tek,\n\nI'm interested in: ${title}\n\nProject details:\n- Application:\n- Chip / frequency requirement:\n- Quantity:\n- Target date:\n\nPlease advise on next steps.\n\nThanks`,
);
const mailtoHref = `mailto:info@proudtek.com?subject=${mailtoSubject}&body=${mailtoBody}`;
const resolvedQuoteHref = resolveArticleInquiryAction(route, title).href;
const primaryHref = buildIntentHref(
  primaryAction.href.startsWith("/contact/") ? resolvedQuoteHref : primaryAction.href,
  "quote",
  route,
);
---
<section class="codex-editorial-action-bar" id={id}>
  <div>
    <p class="codex-editorial-kicker">Next step</p>
    <h2>{heading}</h2>
    <p>{description}</p>
  </div>
  <div class="codex-editorial-action-links">
    <a class="codex-editorial-primary" data-cta-tier="action" href={primaryHref}>{primaryAction.label}</a>
    <a class="codex-editorial-secondary" href={mailtoHref}>✉ Email inquiry directly</a>
    {secondaryActionsRouted.map((link) => (
      <a class="codex-editorial-secondary" href={link.href}>{link.label}</a>
    ))}
  </div>
</section>
