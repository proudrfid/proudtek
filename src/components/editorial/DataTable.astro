---
/**
 * Comparison/data table.
 * Replaces renderTable() from editorial-pages.ts.
 */
import type { EditorialTable } from "../../lib/editorial-types";

interface Props {
  table: EditorialTable;
}

const { table } = Astro.props;
---

<div class="codex-editorial-table-wrap">
  <table class="codex-editorial-table">
    <thead>
      <tr>
        {table.columns.map((column) => (
          <th scope="col">{column}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {table.rows.map((row) => {
        const [first, ...rest] = row;
        return (
          <tr>
            <th scope="row">{first}</th>
            {rest.map((value) => <td>{value}</td>)}
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
