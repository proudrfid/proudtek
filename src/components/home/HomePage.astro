---
import {
  HOME_CASES,
  HOME_EVIDENCE,
  HOME_FAMILIES,
  HOME_PATHWAYS,
  HOME_PROCESS,
} from "../../data/home-v2";
---
<main id="main" class="codex-home-v2">
  <section class="codex-home-v2__hero" aria-labelledby="home-v2-title">
    <div class="codex-home-v2__hero-copy">
      <p class="codex-home-v2__kicker">Verification-first RFID/NFC manufacturing</p>
      <h1 id="home-v2-title">Specify the tag. Verify the evidence. Move to samples.</h1>
      <p class="codex-home-v2__lede">Tell us the application, reader environment, material and annual volume. Proud Tek turns that brief into a manufacturable RFID/NFC specification, sample plan, MOQ ladder and lead time.</p>
      <div class="codex-home-v2__actions">
        <a class="codex-cta--primary" data-cta-tier="hero" href="/rfq/">Start an RFQ <span aria-hidden="true">→</span></a>
        <a class="codex-cta--secondary" href="/sample-pack/">Request a sample pack</a>
      </div>
      <p class="codex-home-v2__microcopy">Full contact details come last. Share only the constraints you already know.</p>
    </div>
    <div class="codex-home-v2__brief-card" aria-label="What the engineering team needs first">
      <p class="codex-home-v2__brief-label">Send the inputs that change the specification</p>
      <div class="codex-home-v2__brief-list">
        <span>Application</span>
        <span>Reader or lock</span>
        <span>Surface / material</span>
        <span>Annual quantity</span>
      </div>
      <div class="codex-home-v2__brief-result">
        <span class="codex-home-v2__status-dot" aria-hidden="true"></span>
        <div><strong>What comes back</strong><span>Matched SKU · sample path · MOQ · lead time</span></div>
      </div>
    </div>
  </section>

  <section class="codex-home-v2__evidence" aria-labelledby="home-v2-evidence-title">
    <div class="codex-home-v2__section-heading">
      <p class="codex-home-v2__kicker">Proof, not promises</p>
      <h2 id="home-v2-evidence-title">Know what is verified before you shortlist.</h2>
      <p>Evidence has a status. The scope matters. The source is linked so your procurement team can check it without taking a marketing claim on trust.</p>
    </div>
    <div class="codex-home-v2__evidence-grid">
      {HOME_EVIDENCE.map((item) => (
        <article class="codex-home-v2__evidence-card">
          <p class="codex-home-v2__evidence-status">{item.status}</p>
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
          <a href={item.href}>{item.linkLabel} <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="codex-home-v2__pathways" aria-labelledby="home-v2-pathways-title">
    <div class="codex-home-v2__section-heading">
      <p class="codex-home-v2__kicker">Start where your project is</p>
      <h2 id="home-v2-pathways-title">Four ways into the procurement path.</h2>
    </div>
    <div class="codex-home-v2__pathway-grid">
      {HOME_PATHWAYS.map((pathway, index) => (
        <a class="codex-home-v2__pathway" href={pathway.href}>
          <span class="codex-home-v2__pathway-index">0{index + 1}</span>
          <p>{pathway.eyebrow}</p>
          <h3>{pathway.title}</h3>
          <span>{pathway.description}</span>
          <strong>{pathway.linkLabel} <span aria-hidden="true">→</span></strong>
        </a>
      ))}
    </div>
  </section>

  <section class="codex-home-v2__families" aria-labelledby="home-v2-families-title">
    <div class="codex-home-v2__section-heading codex-home-v2__section-heading--split">
      <div><p class="codex-home-v2__kicker">Product architecture</p><h2 id="home-v2-families-title">Six families. One specification conversation.</h2></div>
      <a class="codex-home-v2__text-link" href="/products/all/">Browse the full product catalog <span aria-hidden="true">→</span></a>
    </div>
    <div class="codex-home-v2__family-grid">
      {HOME_FAMILIES.map((family) => (
        <a class="codex-home-v2__family" href={family.href}>
          <span class="codex-home-v2__family-fit">{family.fit}</span>
          <h3>{family.name}</h3>
          <p>{family.description}</p>
          <span class="codex-home-v2__text-link">Explore family <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="codex-home-v2__qualification" aria-labelledby="home-v2-qualification-title">
    <div class="codex-home-v2__qualification-copy">
      <p class="codex-home-v2__kicker">Qualification matrix</p>
      <h2 id="home-v2-qualification-title">The right tag is defined by its environment.</h2>
      <p>Frequency is only the beginning. Confirm the substrate, exposure, encoding workflow and reader fleet before choosing a SKU.</p>
      <a class="codex-cta--secondary" href="/compare/">Compare the decision axes</a>
    </div>
    <dl class="codex-home-v2__matrix">
      <div><dt>Air interface</dt><dd>LF · HF/NFC · UHF</dd></div>
      <div><dt>Carrier</dt><dd>Paper · plastic · textile · metal</dd></div>
      <div><dt>Exposure</dt><dd>Wash · heat · chemicals · outdoor</dd></div>
      <div><dt>Data workflow</dt><dd>UID · NDEF · EPC · numbering</dd></div>
      <div><dt>Compatibility</dt><dd>Phone · reader · lock · portal</dd></div>
      <div><dt>Commercial fit</dt><dd>Sample · MOQ · lead time</dd></div>
    </dl>
  </section>

  <section class="codex-home-v2__cases" aria-labelledby="home-v2-cases-title">
    <div class="codex-home-v2__section-heading"><p class="codex-home-v2__kicker">Deployment context</p><h2 id="home-v2-cases-title">Choose the proof path that matches the risk.</h2></div>
    <div class="codex-home-v2__case-grid">
      {HOME_CASES.map((item) => (
        <a class="codex-home-v2__case" href={item.href}><p>{item.label}</p><h3>{item.title}</h3><span>{item.description}</span><strong>Review the deployment path <span aria-hidden="true">→</span></strong></a>
      ))}
    </div>
  </section>

  <section class="codex-home-v2__process" aria-labelledby="home-v2-process-title">
    <div class="codex-home-v2__section-heading"><p class="codex-home-v2__kicker">From brief to reorder</p><h2 id="home-v2-process-title">A specification trail your whole team can follow.</h2></div>
    <ol class="codex-home-v2__process-list">
      {HOME_PROCESS.map(([title, description], index) => (
        <li><span>0{index + 1}</span><div><h3>{title}</h3><p>{description}</p></div></li>
      ))}
    </ol>
  </section>

  <section class="codex-home-v2__final" aria-labelledby="home-v2-final-title">
    <div><p class="codex-home-v2__kicker">Ready when the brief is ready</p><h2 id="home-v2-final-title">Bring the constraints. Leave with a sample plan.</h2><p>Use the structured RFQ for pricing and production guidance, or request a sample pack first when physical validation comes before the PO.</p></div>
    <div class="codex-home-v2__actions"><a class="codex-cta--primary" data-cta-tier="action" href="/rfq/">Request a production quote <span aria-hidden="true">→</span></a><a class="codex-cta--ghost" href="/sample-pack/">Request samples</a></div>
  </section>
</main>
