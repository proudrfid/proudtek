---
/**
 * Section body slot — opening intro paragraph.
 *
 * Shadow component (Stage 2). Mirrors:
 *   const introHtml = section.intro
 *     ? `<p class="codex-editorial-section-intro">${renderInlineLinks(section.intro, citations)}</p>`
 *     : "";
 */
import { renderInlineLinks, type CitationCtx } from "../../lib/editorial-types";

interface Props {
  text: string;
  citations?: CitationCtx;
}

const { text, citations } = Astro.props;
---
<p class="codex-editorial-section-intro" set:html={renderInlineLinks(text, citations)} />
