      "memory.tid_bits": "Total TID bank size in bits.",
      "memory.tid_unique_bits": "Unique-serial portion of TID in bits.",
      "memory.user_bytes": "User NDEF memory in bytes (HF NFC chips). Distinct from totalEEPROM_bytes.",
      "memory.totalEEPROM_bytes": "Total EEPROM including config / UID / lock (HF NFC chips). user_bytes is what payload-sizing uses.",
      "memory.totalMemory_bits": "Total EEPROM in bits, where the chip is bit-counted (ICODE / Higgs).",
      "rf.read_sensitivity_dbm": "Forward-link sensitivity per vendor datasheet typical conditions.",
      "rf.write_sensitivity_dbm": "Backscatter / write sensitivity.",
      "crypto.algorithm": "On-chip crypto algorithm: AES-128 / 3DES / PRESENT-80 / null.",
      "crypto.standard": "ISO crypto-suite standard if applicable.",
      "status": "active / discontinued — discontinued chips should NOT be recommended for new programmes.",
      "knownFabrications": "Common hallucination claims caught in sweeps — used by lint:chip-claims script."
    }
  },
