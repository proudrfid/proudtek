---
/**
 * Featured product grid for an industry landing page.
 *
 * Shadow component (Stage 2 optimization). Mirrors `renderIndustryProductGrid`
 * in editorial-pages.ts (~line 1072). Card data is prepared by
 * `buildIndustryProductGridData(definition)` so this component is a pure
 * renderer.
 *
 * Heading copy is parameterized on `categoryTitle` — the human-readable
 * industry name pulled from `INDUSTRY_CATEGORIES`.
 */
import type { EditorialProductGridCard } from "../../lib/editorial-pages";

interface Props {
  categoryTitle: string;
  cards: EditorialProductGridCard[];
}

const { categoryTitle, cards } = Astro.props;
const lowerTitle = categoryTitle.toLowerCase();
---
<section class="codex-industries-cat-products" aria-label={`Products for ${categoryTitle}`}>
  <h2 class="codex-industries-cat-products__title">Featured {categoryTitle} Products</h2>
  <p class="codex-industries-cat-products__sub">Explore our complete range of RFID solutions for {lowerTitle}.</p>
  <div class="codex-industries-cat-products__grid">
    {cards.map((card) => (
      <a href={card.route} class="codex-card codex-card--media codex-industries-cat-card">
        {card.img ? (
          <img src={card.img} alt={card.shortName} width="1200" height="675" loading="eager" />
        ) : (
          <div class="codex-industries-cat-card__placeholder" />
        )}
        <div class="codex-industries-cat-card__body">
          <h3>{card.shortName}</h3>
          <span class="codex-industries-cat-card__arrow">&rarr;</span>
        </div>
      </a>
    ))}
  </div>
</section>
