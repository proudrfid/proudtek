---
import { PRIMARY_MENU_DROPDOWNS } from "../../lib/menu-structure";
import DesktopNav from "./DesktopNav.astro";
import MobileNav from "./MobileNav.astro";

interface Props {
  currentRoute: string;
}

const { currentRoute } = Astro.props;
---
<header id="masthead" class="site-header codex-native-header" data-native-shell-header>
  <div id="main-header" class="codex-native-header__bar">
    <div class="site-container codex-native-header__inner">
      <a class="site-branding codex-native-brand" href="/" aria-label="Proud Tek home">
        <img
          class="custom-logo"
          src="/site-assets/wp-content/uploads/2024/04/proudtek-logo.png"
          alt="Proud Tek"
          width="220"
          height="60"
          decoding="async"
        />
      </a>
      <DesktopNav menus={PRIMARY_MENU_DROPDOWNS} currentRoute={currentRoute} />
      <div class="codex-native-header__actions">
        <a class="codex-native-header__quote" href="/rfq/">Request quote</a>
        <button
          type="button"
          class="drawer-toggle menu-toggle-open codex-native-header__menu"
          aria-label="Open menu"
          aria-controls="mobile-drawer"
          aria-expanded="false"
          data-native-drawer-open
        >
          <span class="menu-toggle-icon" aria-hidden="true"><span></span></span>
          <span class="codex-sr-only">Open menu</span>
        </button>
      </div>
    </div>
  </div>
  <MobileNav menus={PRIMARY_MENU_DROPDOWNS} currentRoute={currentRoute} />
</header>

<style is:global>
  #masthead[data-native-shell-header] #main-header {
    display: block;
  }
</style>

<script>
  const body = document.body;
  const drawer = document.getElementById("mobile-drawer");
  const openButton = document.querySelector<HTMLElement>("[data-native-drawer-open]");
  const closeButtons = document.querySelectorAll("[data-native-drawer-close]");
  let openingTrigger: HTMLElement | null = null;
  let drawerChange = 0;

  function canRestoreFocus(element: HTMLElement | null): element is HTMLElement {
    return !!element
      && element.isConnected
      && !element.hasAttribute("disabled")
      && element.getAttribute("aria-disabled") !== "true"
      && element.tabIndex >= 0;
  }

  function restoreFocus(element: HTMLElement | null): void {
    if (canRestoreFocus(element)) element.focus({ preventScroll: true });
  }

  function isFocusable(element: HTMLElement): boolean {
    if (!element.isConnected
      || element.hasAttribute("disabled")
      || element.getAttribute("aria-disabled") === "true"
      || element.tabIndex < 0) return false;

    let ancestor: HTMLElement | null = element;
    while (ancestor) {
      if (ancestor.hidden
        || ancestor.hasAttribute("inert")
        || ancestor.getAttribute("aria-hidden") === "true"
        || (ancestor.tagName === "DETAILS" && !(ancestor as HTMLDetailsElement).open)) {
        return false;
      }
      ancestor = ancestor.parentElement;
    }
    return true;
  }

  function setDrawer(open: boolean) {
    if (!drawer || !openButton) return;
    const change = ++drawerChange;

    if (open) openingTrigger = openButton;
    body.classList.toggle("drawer-open", open);
    drawer.setAttribute("aria-hidden", open ? "false" : "true");
    openButton.setAttribute("aria-expanded", open ? "true" : "false");

    if (open) {
      requestAnimationFrame(() => {
        if (change !== drawerChange || !body.classList.contains("drawer-open")) return;
        const closeButton = Array.from(
          drawer.querySelectorAll<HTMLElement>("[data-native-drawer-close]"),
        ).find(isFocusable);
        const firstFocusable = Array.from(
          drawer.querySelectorAll<HTMLElement>(
            'a[href], button, [tabindex]:not([tabindex="-1"])',
          ),
        ).find(isFocusable);
        (closeButton ?? firstFocusable)?.focus();
      });
      return;
    }

    const trigger = openingTrigger;
    restoreFocus(trigger);
    openingTrigger = null;
    requestAnimationFrame(() => {
      if (change !== drawerChange) return;
      restoreFocus(trigger);
      if (!canRestoreFocus(trigger) && drawer.contains(document.activeElement)) {
        (document.activeElement as HTMLElement).blur();
      }
    });
  }

  openButton?.addEventListener("click", () => setDrawer(true));
  closeButtons.forEach((button) => button.addEventListener("click", () => setDrawer(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && body.classList.contains("drawer-open")) setDrawer(false);
  });
</script>
