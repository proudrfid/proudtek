   text-decoration: none;
@@ -168,7 +168,7 @@
   gap: var(--codex-space-6) var(--codex-space-8);
 }
 
-.codex-native-nav__group h2 {
+.codex-native-nav__group .codex-nav-group-label {
   margin-bottom: var(--codex-space-3);
