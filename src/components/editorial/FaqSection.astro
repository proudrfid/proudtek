---
/**
 * FAQ accordion section.
 * Replaces renderFaq() from editorial-pages.ts.
 */
import type { EditorialFaq } from "../../lib/editorial-types";

interface Props {
  faq: EditorialFaq[];
  id: string;
}

const { faq, id } = Astro.props;
---

<section class="codex-editorial-section" id={id}>
  <h2>FAQ</h2>
  <div class="codex-editorial-faq">
    {faq.map((entry) => (
      <details>
        <summary>{entry.question}</summary>
        <p>{entry.answer}</p>
      </details>
    ))}
  </div>
</section>
