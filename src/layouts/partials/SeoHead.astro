---
/**
 * SeoHead — all <head> content for the site.
 *
 * Driven by the seo prop (PageSeoData) returned by buildPageSeo().
 * Emits charset/viewport, resource hints, font preloads, LCP image
 * preload (for non-home/contact pages), all SEO meta (title /
 * description / robots / canonical / OG / Twitter / Article), GA4,
 * machine-readable alternates, and JSON-LD blocks.
 *
 * Extracted from BaseLayout.astro on 2026-05-08 to keep the layout
 * file focused on structure rather than meta-tag plumbing.
 */
import type { PageSeoData } from "../../lib/seo";
import { SITE_ORIGIN } from "../../lib/seo-content";

interface Props {
  seo: PageSeoData;
  machineJsonPath?: string;
  machineTextPath?: string;
}

const { seo, machineJsonPath, machineTextPath } = Astro.props;

// seo.imageUrl is ABSOLUTE (image-utils wraps every selection in
// absoluteUrl()), so gates on a "/landing-images/" prefix must parse the
// pathname first — a startsWith() on the full URL never matches and left
// the WebP-preload branch below dead (the page preloaded the .jpg while
// <picture> served the .webp = double download).
const imagePathname = (() => {
  try {
    return new URL(seo.imageUrl ?? "", `${SITE_ORIGIN}/`).pathname;
  } catch {
    return "";
  }
})();
const isLandingHeroImage = imagePathname.startsWith("/landing-images/");

// og:image:type from the file extension. Hero source dimensions vary per
// page (no fixed 16:9 contract), so width/height are deliberately not
// emitted — a wrong declared size is worse than none.
const ogImageType = /\.jpe?g$/i.test(imagePathname)
  ? "image/jpeg"
  : /\.png$/i.test(imagePathname)
    ? "image/png"
    : /\.webp$/i.test(imagePathname)
      ? "image/webp"
      : "";
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

{/* ── Resource hints: speed up external connections ──
    P0-P2 / baseline finding: preconnect already includes DNS resolution
    in all evergreen browsers, so an additional dns-prefetch to the same
    origin is redundant. sanitize-html.ts strips dns-prefetch hints from
    the WP chrome snapshot for the same reason.

    PSI 2026-06-11: the former region1.google-analytics.com preconnect
    was flagged "unused" — GA4 beacons only fire after consent/interaction,
    long past the preconnect's ~10s TTL, so the early TLS handshake was
    wasted work on every load. Keep only the gtag.js origin. */}
<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

{/* Preload critical fonts (Latin subsets for Inter body + Lora headings) */}
<link rel="preload" href="/site-assets/wp-content/fonts/inter/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/site-assets/wp-content/fonts/lora/0QIvMX1D_JOuMwr7Iw.woff2" as="font" type="font/woff2" crossorigin />

{/* DS-15 #1 — preload hero image to accelerate LCP. Skipped on contact
    (form-only, no hero figure). Home WAS skipped ("video hero, not
    image") — reversed 2026-06-11: with the video deferred behind
    data-src, the LCP element on home is the video's poster jpg, which
    equals seo.imageUrl (rfid_factories.jpg); PSI flagged it as needing
    fetchpriority=high + early discovery.
    DS-15 #6 — when the image lives in /landing-images/, prefer
    the WebP variant via imagesrcset+imagetype so the browser
    downloads the smaller file (~30–55% byte savings). Browsers
    without WebP ignore the imagesrcset hint and the <picture>
    fallback in the <body> still works.

    PR-3 P0-P1 — also emit `href` pointing at the original JPG/PNG.
    Safari and Firefox versions older than 2023 drop the entire
    preload when imagesrcset is the only source, leaving LCP to
    wait for the <img> tag to be discovered. Including href as a
    canonical fallback gives those browsers something to fetch —
    modern Chromium-based browsers still prefer the WebP via the
    imagesrcset+imagetype hint. */}
{seo.imageUrl && seo.kind !== "contact" ? (
  isLandingHeroImage ? (
    // @ts-expect-error — Astro's LinkHTMLAttributes type predates the
    // responsive-image preload attributes (imagesrcset, imagetype) per
    // HTML Living Standard. Both attributes are valid; Astro emits them
    // verbatim. Remove the suppression once the upstream types catch up.
    <link
      rel="preload"
      as="image"
      href={seo.imageUrl}
      imagesrcset={seo.imageUrl.replace(/\.(jpe?g|png)$/i, ".webp")}
      imagetype="image/webp"
      fetchpriority="high"
    />
  ) : (
    <link rel="preload" as="image" href={seo.imageUrl} fetchpriority="high" />
  )
) : null}

{/* P0-S1 — SEO-critical tags MUST appear BEFORE the WP-derived headHtml
    so that HTML5 "first occurrence wins" parsing rules give our canonical
    values precedence over any duplicates that might leak through chrome
    injection. The 7 native Astro hubs concatenate `chrome.headHtml + seo.headHtml`
    (see compatibility/solutions/blog/guides/compare hub `index.astro` files);
    keeping our overrides first means we never need to re-sanitize the chrome
    fragment at the call sites. */}
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content={seo.robots} />
<link rel="canonical" href={seo.canonicalUrl} />

{/* Favicons — emitted once here for every page (native Astro hubs + WP-mirrored
    pages alike); the matching WP `<link rel="icon">` copies are stripped in
    sanitizeHead so mirrored pages don't double up. Assets are the original WP
    site icons under public/site-assets. */}
<link rel="icon" href="/site-assets/wp-content/uploads/2024/09/cropped-favicon-32x32.png" sizes="32x32" />
<link rel="icon" href="/site-assets/wp-content/uploads/2024/09/cropped-favicon-192x192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="/site-assets/wp-content/uploads/2024/09/cropped-favicon-180x180.png" />

<Fragment set:html={seo.headHtml} />

{/* GA4 — PR-3 P0-P2:
    Order matters. dataLayer + Consent Mode v2 defaults MUST execute
    before gtag.js loads (`async` script could arrive first otherwise).
    Consent Mode v2 is GDPR-required: without `default { ad_storage:
    'denied', analytics_storage: 'denied' }` we leak PII to Google
    Analytics before the user has any chance to opt out. Update this
    block to call `gtag('consent', 'update', { ... })` from your
    cookie-consent UI when the user accepts. Once that's wired,
    Lighthouse Best Practices (currently warning on the /blog/ hub)
    should green up. */}
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    ad_storage: 'denied',
    analytics_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    functionality_storage: 'denied',
    personalization_storage: 'denied',
    security_storage: 'granted',
    wait_for_update: 500
  });
  // Re-apply a previously saved cookie-banner choice before gtag.js loads.
  // The banner UI itself lives in PageScript.astro (#codex-consent).
  try {
    if (localStorage.getItem('codex-consent') === 'granted') {
      gtag('consent', 'update', { analytics_storage: 'granted' });
    }
  } catch (e) {}
  gtag('js', new Date());
  gtag('config', 'G-QB63MNYN52');

  /* PSI 2026-06-11: gtag.js (156 KiB, ~65 KiB unused) was the largest
     third-party on the critical window. Load it on first interaction —
     or after a 3.5 s idle fallback — instead of at parse time. All
     gtag()/codexPushEvent calls made before the script arrives queue
     safely in window.dataLayer and flush when it loads, so no events
     are lost; only the network fetch is deferred. */
  (function () {
    // Host-gate (2026-07-13): load gtag.js ONLY on the production domain, so
    // Vercel preview deploys (*.vercel.app) and local dev never send page
    // views to the live GA4 property. Consent defaults + config above still
    // run, but gtag.js never fetches off-prod, so nothing is transmitted —
    // this removes the vercel.com/referral traffic that dominated the
    // Jun–Jul 2026 GA reports. Add hosts here if the site gains another
    // production domain.
    var h = location.hostname;
    if (h !== 'proudtek.com' && h !== 'www.proudtek.com') return;
    var loaded = false;
    function loadGtag() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-QB63MNYN52';
      document.head.appendChild(s);
      ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (t) {
        removeEventListener(t, loadGtag, true);
      });
    }
    ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (t) {
      addEventListener(t, loadGtag, { capture: true, passive: true, once: false });
    });
    setTimeout(loadGtag, 3500);
  })();
</script>

{seo.indexable && machineJsonPath ? <link rel="alternate" type="application/json" href={machineJsonPath} /> : null}
{seo.indexable && machineTextPath ? <link rel="alternate" type="text/plain" href={machineTextPath} /> : null}

<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="Proud Tek" />
<meta property="og:type" content={seo.ogType} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonicalUrl} />
<meta property="og:image" content={seo.imageUrl} />
<meta property="og:image:alt" content={seo.imageAlt} />
{ogImageType ? <meta property="og:image:type" content={ogImageType} /> : null}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.imageUrl} />
<meta name="twitter:image:alt" content={seo.imageAlt} />

{seo.kind === "article" && seo.articleMeta ? <meta name="author" content={seo.articleMeta.authorName} /> : null}
{seo.kind === "article" && seo.articleMeta ? (
  <meta property="article:published_time" content={seo.articleMeta.publishedAt} />
) : null}
{seo.kind === "article" && seo.articleMeta ? (
  <meta property="article:modified_time" content={seo.articleMeta.modifiedAt} />
) : null}
{seo.kind === "article" && seo.articleMeta ? (
  <meta property="article:author" content={seo.articleMeta.authorName} />
) : null}

{seo.jsonLd.map((entry) => <script type="application/ld+json" set:html={entry} />)}
