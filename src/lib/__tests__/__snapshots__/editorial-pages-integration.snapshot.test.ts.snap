\"147:58\\">Additional details</label> <span id=\\"codex-rfq-compare-google-review-nfc-card-v-message-hint\\" class=\\"codex-inline-rfq-hint\\" data-astro-source-file=\\"<project-root>/src/components/editorial/InlineRfqForm.astro\\" data-astro-source-loc=\\"148:65\\">Chip preference, timeline, special requirements...</span> <textarea id=\\"codex-rfq-compare-google-review-nfc-card-v-message\\" name=\\"message\\" rows=\\"3\\" aria-describedby=\\"codex-rfq-compare-google-review-nfc-card-v-message-hint codex-rfq-compare-google-review-nfc-card-v-message-error\\" data-astro-source-file=\\"<project-root>/src/components/editorial/InlineRfqForm.astro\\" data-astro-source-loc=\\"149:12\\"></textarea> <span id=\\"codex-rfq-compare-google-review-nfc-card-v-message-error\\" class=\\"codex-inline-rfq-error\\" role=\\"alert\\" aria-live=\\"polite\\" data-astro-source-file=\\"<project-root>/src/components/editorial/InlineRfqForm.astro\\" data-astro-source-loc=\\"157:12\\"></span> </div> <button type=\\"submit\\" class=\\"codex-inline-rfq-submit\\" data-astro-source-file=\\"<project-root>/src/components/editorial/InlineRfqForm.astro\\" data-astro-source-loc=\\"161:59\\">Get My Quote</button> </form> </section> <section class=\\"codex-editorial-action-bar\\" id=\\"next-step\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ActionBar.astro\\" data-astro-source-loc=\\"60:53\\"> <div data-astro-source-file=\\"<project-root>/src/components/editorial/ActionBar.astro\\" data-astro-source-loc=\\"61:8\\"> <p class=\\"codex-editorial-kicker\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ActionBar.astro\\" data-astro-source-loc=\\"62:39\\">Next step</p> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/ActionBar.astro\\" data-astro-source-loc=\\"63:9\\">Ready to discuss your project?</h2> <p data-astro-source-file=\\"<project-root>/src/components/editorial/ActionBar.astro\\" data-astro-source-loc=\\"64:8\\">Use the contact route when you are ready for pricing, samples, or compatibility help, or continue into the linked product and comparison pages below.</p> </div> <div class=\\"codex-editorial-action-links\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ActionBar.astro\\" data-astro-source-loc=\\"66:45\\"> <a class=\\"codex-editorial-primary\\" data-cta-tier=\\"action\\" href=\\"/contact/nfc-branding-cards/?intent=quote&#38;route=%2Fcompare%2Fgoogle-review-nfc-card-vs-nfc-sticker%2F\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ActionBar.astro\\" data-astro-source-loc=\\"67:82\\">Choose card or sticker</a> <a class=\\"codex-editorial-secondary\\" href=\\"mailto:info@proudtek.com?subject=Inquiry%3A%20Google%20Review%20NFC%20Card%20vs%20NFC%20Sticker&#38;body=Hi%20Proud%20Tek%2C%0A%0AI'm%20interested%20in%3A%20Google%20Review%20NFC%20Card%20vs%20NFC%20Sticker%0A%0AProject%20details%3A%0A-%20Application%3A%0A-%20Chip%20%2F%20frequency%20requirement%3A%0A-%20Quantity%3A%0A-%20Target%20date%3A%0A%0APlease%20advise%20on%20next%20steps.%0A%0AThanks\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ActionBar.astro\\" data-astro-source-loc=\\"68:60\\">✉ Email inquiry directly</a> <a class=\\"codex-editorial-secondary\\" href=\\"/products/rfid-cards/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ActionBar.astro\\" data-astro-source-loc=\\"70:61\\">Browse RFID cards</a><a class=\\"codex-editorial-secondary\\" href=\\"/products/rfid-labels/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/ActionBar.astro\\" data-astro-source-loc=\\"70:61\\">Browse RFID labels</a> </div> </section> </div> </div> </article> </div>"`;

exports[`EditorialArticle.astro — full-page integration snapshots > guides group: locks full page HTML for representative fixture (guides/icode-slix-chip-encyclopedia.json) 1`] = `"<div class=\\"woocommerce kadence-woo-messages-none-woo-pages woocommerce-notices-wrapper\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialArticle.astro\\" data-astro-source-loc=\\"173:2\\"></div>   <div class=\\"content-wrap codex-editorial-pillar--with-rail\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialArticle.astro\\" data-astro-source-loc=\\"188:31\\"> <article class=\\"entry content-bg single-entry page type-page status-publish hentry codex-editorial-page\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialArticle.astro\\" data-astro-source-loc=\\"189:108\\"> <div class=\\"entry-content-wrap\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialArticle.astro\\" data-astro-source-loc=\\"190:37\\"> <div class=\\"entry-content single-content\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialArticle.astro\\" data-astro-source-loc=\\"191:49\\"> <div class=\\"codex-editorial-dates\\" hidden aria-hidden=\\"true\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialArticle.astro\\" data-astro-source-loc=\\"192:70\\"> <time class=\\"entry-date published\\" datetime=\\"2026-04-19\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialArticle.astro\\" data-astro-source-loc=\\"193:67\\">2026-04-19</time> <time class=\\"updated\\" datetime=\\"2026-07-02\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialArticle.astro\\" data-astro-source-loc=\\"194:53\\">2026-07-02</time> </div> <nav class=\\"codex-editorial-trail\\" aria-label=\\"Breadcrumb\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Trail.astro\\" data-astro-source-loc=\\"96:60\\"> <a href=\\"/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Trail.astro\\" data-astro-source-loc=\\"102:29\\">Home</a><span data-astro-source-file=\\"<project-root>/src/components/editorial/Trail.astro\\" data-astro-source-loc=\\"104:48\\">/</span><a href=\\"/resources/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Trail.astro\\" data-astro-source-loc=\\"102:29\\">Resources</a><span data-astro-source-file=\\"<project-root>/src/components/editorial/Trail.astro\\" data-astro-source-loc=\\"104:48\\">/</span><a href=\\"/resources/#resources-hub-grid-guides\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Trail.astro\\" data-astro-source-loc=\\"102:29\\">Buying Guides</a><span data-astro-source-file=\\"<project-root>/src/components/editorial/Trail.astro\\" data-astro-source-loc=\\"104:48\\">/</span><span aria-current=\\"page\\" data-astro-source-file=\\"<project-root>/src/components/editorial/Trail.astro\\" data-astro-source-loc=\\"100:35\\">ICODE SLIX / SLIX2</span> </nav> <section class=\\"codex-editorial-hero\\" data-page-type=\\"guide\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"115:106\\"> <div class=\\"codex-editorial-hero-copy\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"116:42\\"> <p class=\\"codex-editorial-kicker\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"117:39\\">NXP ICODE SLIX (SL2S2002) / SLIX2 (SL2S2602) / SLIX-S / SLIX-L Reference</p> <h1 data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"118:9\\">ICODE SLIX / SLIX2</h1> <p class=\\"codex-editorial-hero-deck\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"119:61\\">HF ISO 15693 Chip Technical Encyclopedia (Memory, EAS, Library Deployment)</p> <p class=\\"codex-editorial-byline\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"121:41\\">By <a class=\\"codex-byline-name\\" href=\\"/about/review-board/#editorial-board\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"122:63\\">Proud Tek Editorial Board</a> · Reviewed by <a class=\\"codex-byline-name\\" href=\\"/about/review-board/#peter-zhang\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"127:67\\">Peter Zhang</a> · Updated <time datetime=\\"2026-07-02\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"132:66\\">Jul 2026</time></p>  <div class=\\"codex-editorial-answer\\" aria-label=\\"Quick answer\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"213:67\\"> <p class=\\"codex-editorial-answer-label\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"214:47\\">Quick answer</p> <p class=\\"codex-editorial-summary\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"215:8\\">ICODE SLIX is NXP&#39;s ISO 15693 vicinity chip at 13.56 MHz, with 896 bits (112 bytes) of user memory and hardware EAS anti-theft. Successor SLIX2 (SL2S2602) raises user memory to 2,528 bits and adds 64-bit password protection, PRIVACY mode, and DESTROY. Read range reaches ~1.5 m on large library-gate antennas, which is why the family dominates library-book tags, HF laundry chips, and museum exhibit tagging.</p> </div> <ul class=\\"codex-editorial-points\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"217:40\\"> <li data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"218:48\\">Long-range HF: ISO 15693 operates at 13.56 MHz like 14443 but uses a different air-interface protocol (vicinity vs proximity) that allows read ranges up to 1.5 m with a large reader antenna and a large card antenna. This is the dominant reason libraries and laundry tunnels chose ICODE SLIX over MIFARE: a book tag on a shelf or a linen tunnel with 50 items per batch can be read end-to-end in one pass.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"218:48\\">Built-in EAS (Electronic Article Surveillance). A library-optimized feature. The chip has a hardware-enforced &#39;EAS bit&#39; that can be set or reset by a reader. Library gates interrogate only the EAS state (faster than a full read) and alarm if any tagged item is un-reset leaving the library. Zero middleware required: the anti-theft logic lives entirely in the chip.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"218:48\\">64-bit password protection + PRIVACY mode. SLIX2 adds 64-bit password-protected memory sections and a PRIVACY command that makes the tag unresponsive until a correct password is received. Used for reader-controlled inventory workflows where the book tag should be invisible to unauthorized readers after checkout.</li> </ul>  <div class=\\"codex-hero-cta\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"222:37\\"> <a class=\\"codex-hero-cta-btn\\" data-cta-tier=\\"hero\\" href=\\"#quick-quote\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"223:84\\">Request samples</a>  </div> <div class=\\"codex-hero-trust-bar\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"232:43\\"> <span data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"233:18\\"><strong data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"233:25\\">Since 2008</strong></span> <span data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"234:18\\"><strong data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"234:25\\">ISO 9001</strong></span> <span data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"235:18\\"><strong data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"235:25\\">500+</strong> Clients</span> <span data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"236:18\\"><strong data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialHero.astro\\" data-astro-source-loc=\\"236:25\\">50+</strong> Countries</span> </div>  </div> </section>        <section class=\\"codex-editorial-section codex-editorial-snapshot\\" id=\\"at-a-glance\\" data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"42:75\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"43:7\\">At a glance</h2> <p class=\\"codex-editorial-section-intro\\" data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"44:44\\">Use these short answers to decide whether this page matches the project before moving into the detail.</p> <div class=\\"codex-editorial-snapshot-grid\\" data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"45:46\\"> <article class=\\"codex-card codex-editorial-snapshot-card\\" data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"47:65\\"> <p class=\\"codex-editorial-answer-label\\" data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"48:49\\">Family and memory</p> <p data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"49:12\\">SLIX (SL2S2002) carries 896 bits (112 bytes) of user memory; SLIX2 (SL2S2602) carries 2,528 bits user (2,560-bit total EEPROM); SLIX-L (SL2S5502) carries 320 bits for th...</p>  </article><article class=\\"codex-card codex-editorial-snapshot-card\\" data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"47:65\\"> <p class=\\"codex-editorial-answer-label\\" data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"48:49\\">EAS anti-theft in silicon</p> <p data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"49:12\\">A hardware EAS bit answers the fast EAS Check command, so library gates alarm without a full memory read. SLIX2 adds 64-bit password protection on EAS writes plus PRIVAC...</p>  </article><article class=\\"codex-card codex-editorial-snapshot-card\\" data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"47:65\\"> <p class=\\"codex-editorial-answer-label\\" data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"48:49\\">Next step</p> <p data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"49:12\\">Ready to move forward? Start your inquiry to get specific answers for this project.</p> <a class=\\"codex-editorial-snapshot-link\\" href=\\"/contact/custom-rfid-cards/\\" data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"51:74\\">Request ICODE SLIX samples</a> </article> </div> <dl class=\\"codex-editorial-brief-grid codex-editorial-brief-grid--extra\\" data-astro-source-file=\\"<project-root>/src/components/editorial/DecisionSnapshot.astro\\" data-astro-source-loc=\\"57:78\\"> <div class=\\"codex-card codex-editorial-brief-card\\" data-astro-source-file=\\"<project-root>/src/components/editorial/BriefField.astro\\" data-astro-source-loc=\\"33:52\\"> <dt data-astro-source-file=\\"<project-root>/src/components/editorial/BriefField.astro\\" data-astro-source-loc=\\"34:7\\">Read range</dt> <dd data-astro-source-file=\\"<project-root>/src/components/editorial/BriefField.astro\\" data-astro-source-loc=\\"35:7\\"> <p data-astro-source-file=\\"<project-root>/src/components/editorial/BriefField.astro\\" data-astro-source-loc=\\"36:23\\">Up to ~1.5 m on a 50 × 50 cm library-gate portal; typical deployments see 80-100 cm on a 30 × 30 cm reader antenna. A 50-item batch resolves in under 100 ms via slotted-ALOHA anti-collision.</p>   </dd> </div><div class=\\"codex-card codex-editorial-brief-card\\" data-astro-source-file=\\"<project-root>/src/components/editorial/BriefField.astro\\" data-astro-source-loc=\\"33:52\\"> <dt data-astro-source-file=\\"<project-root>/src/components/editorial/BriefField.astro\\" data-astro-source-loc=\\"34:7\\">Where it dominates</dt> <dd data-astro-source-file=\\"<project-root>/src/components/editorial/BriefField.astro\\" data-astro-source-loc=\\"35:7\\"> <p data-astro-source-file=\\"<project-root>/src/components/editorial/BriefField.astro\\" data-astro-source-loc=\\"36:23\\">Libraries (tens of millions of books tagged since 2005 under NISO RP-6 / DIN ISO 28560 profiles), HF industrial laundry in PPS chips rated for 200+ wash cycles at 90°C, museum collections, and government archives.</p>   </dd> </div> </dl> </section>  <nav class=\\"codex-editorial-jump-nav\\" aria-label=\\"On this page\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"20:67\\"><p class=\\"codex-editorial-kicker\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"21:39\\">On this page</p><div class=\\"codex-editorial-jump-links\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"22:45\\"><a class=\\"codex-editorial-jump-link\\" href=\\"#at-a-glance\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">At a glance</a><a class=\\"codex-editorial-jump-link\\" href=\\"#family-and-part-numbers\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">Family and part numbers</a><a class=\\"codex-editorial-jump-link\\" href=\\"#memory-architecture\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">Memory architecture</a><a class=\\"codex-editorial-jump-link\\" href=\\"#iso-15693-air-interface-and-icode-slix-specifics\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">ISO 15693 air interface and ICODE SLIX specifics</a><a class=\\"codex-editorial-jump-link\\" href=\\"#eas-electronic-article-surveillance-and-library-workflows\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">EAS (Electronic Article Surveillance) and library workflows</a><a class=\\"codex-editorial-jump-link\\" href=\\"#antenna-physical-and-environmental\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">Antenna, physical, and environmental</a><a class=\\"codex-editorial-jump-link\\" href=\\"#commercial-deployments-and-application-fit\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">Commercial deployments and application fit</a><a class=\\"codex-editorial-jump-link\\" href=\\"#nxp-and-iso-reference-documents\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">NXP and ISO reference documents</a><a class=\\"codex-editorial-jump-link\\" href=\\"#typical-personalisation-and-command-sequence\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">Typical personalisation and command sequence</a><a class=\\"codex-editorial-jump-link\\" href=\\"#specifications-at-a-glance\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">Specifications at a glance</a><a class=\\"codex-editorial-jump-link\\" href=\\"#useful-next-pages\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">Useful next pages</a><a class=\\"codex-editorial-jump-link\\" href=\\"#faq\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">FAQ</a><a class=\\"codex-editorial-jump-link\\" href=\\"#sources\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">Sources</a><a class=\\"codex-editorial-jump-link\\" href=\\"#next-step\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">Next step</a><a class=\\"codex-editorial-jump-link\\" href=\\"#quick-quote\\" data-astro-source-file=\\"<project-root>/src/components/editorial/JumpNav.astro\\" data-astro-source-loc=\\"24:67\\">Get a quote</a></div></nav> <section class=\\"codex-editorial-section\\" id=\\"family-and-part-numbers\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"75:2\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"76:7\\">Family and part numbers</h2> <p class=\\"codex-editorial-section-intro\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionIntro.astro\\" data-astro-source-loc=\\"19:2\\">NXP ships a cluster of ICODE silicon variants that share the same ISO 15693 air interface but differ substantially in memory, security features and operating ranges. Choosing the right variant at the RFQ stage is worth getting correct because the inlay converters (Smartrac/Avery Dennison, LAB ID, Invengo, Identiv, HID Global) calibrate antenna tuning to the specific chip&#39;s input capacitance, and swapping from SLIX to SLIX2 mid-project typically forces an antenna re-layout. Library and laundry procurement teams routinely discover that their &#39;ICODE SLIX&#39; spec was actually filled with SLIX-S or ICODE DNA UCODE downstream, each of which has its own subtle behaviour on EAS, password protection and tag-unlock workflows.</p>        <ul class=\\"codex-editorial-list\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"38:38\\"><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">ICODE SLIX: NXP part number SL2S2002. The reference ISO 15693 / ISO 18000-3 Mode 1 chip. 896 bits (112 bytes) of user memory organized as 28 × 4-byte blocks.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">ICODE SLIX2 — SL2S2602. Launched 2013 as the capacity + security upgrade. 2,528 bits (316 bytes) of user memory organized as 79 × 4-byte blocks (2,560-bit total EEPROM = 80 blocks; last block is system) per NXP SL2S2602 datasheet. Adds 64-bit password protection, PRIVACY mode, and Originality Signature.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">ICODE SLIX-S: SL2S5002. Larger-memory variant with 2,048 bits user memory + 32-bit destroy password. Between SLIX and SLIX2 in the lineup.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">ICODE SLIX-L: SL2S5502. Compact-memory variant optimized for the smallest inlays (laundry PPS chips, pharma blister tags). 320 bits user memory.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">ICODE SLI: the pre-SLIX generation (SL2ICS50). Still supported but with less user memory and without the password features of SLIX2. Phased out of NXP catalog but still present in some long-tail library installations.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Counterfeit watch: authentic NXP ICODE SLIX returns DSFID (Data Storage Format Identifier) per ISO 15693 plus a chip-type byte in the Block Security Status response. SLIX specifically identifies as chip type 0x02 in the Get System Information response; SLIX2 as 0x01. Incoming-inspection should verify this alongside the 8-byte ISO 15693 UID format (UID[0] = 0xE0, UID[1] = 0x04 for NXP manufacturer).</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">ICODE DNA: NXP&#39;s AES-128-capable ISO 15693 chip (SL2S3002), launched 2017. Adds AES mutual authentication, SUN (Secure Unique NFC) tap-URL signing, and audit-grade anti-cloning. Where SLIX2 relies on a 64-bit password for protection, DNA uses proper AES cryptography. The right choice for brand-authentication or high-value asset-tracking deployments where CRYPTO1-equivalent weak protection is not acceptable.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Originality Signature (SLIX2 and DNA only). A 32-byte ECDSA signature over the UID, signed with NXP&#39;s private key at wafer test. Readers verify with NXP&#39;s public key (published in AN11350) to confirm authentic NXP silicon without relying on external databases. This is the strongest anti-counterfeit signal available on the ISO 15693 tier; SLIX (SL2S2002) does not have it and is fingerprintable only via SAK/ATQA.</li></ul>     </section><section class=\\"codex-editorial-section\\" id=\\"memory-architecture\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"75:2\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"76:7\\">Memory architecture</h2> <p class=\\"codex-editorial-section-intro\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionIntro.astro\\" data-astro-source-loc=\\"19:2\\">ICODE SLIX&#39;s memory map is simpler than the sector-and-block structure of <a href=\\"/compare/mifare-classic-vs-plus-vs-desfire-hotel-locks/\\" title=\\"MIFARE Classic\\">MIFARE Classic</a>, because ISO 15693 tags address memory as a flat array of 4-byte blocks rather than as segmented sectors with per-segment keys. This simplicity is part of why SLIX works well for library, laundry and museum deployments where the use case is &#39;write barcode and flags, read back at gate&#39;, but it also limits the chip&#39;s role in access control. There is no multi-application partitioning, and the 64-bit password mechanism is a uniform protection across all user memory rather than per-sector role separation.</p>        <ul class=\\"codex-editorial-list\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"38:38\\"><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">SLIX total memory — 896 bits (112 bytes) user-accessible, organized as 28 × 32-bit blocks. Block 0 is typically used for SSI/AFI system state; blocks 1-27 hold user data (librarian-determined usage: patron ID, book barcode, branch code, checkout flags).</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">SLIX2 total memory — 2,560 bits (320 bytes) organized as 80 × 32-bit blocks. Adds 64-bit EAS/AFI password area and separate 64-bit DESTROY password area.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">UID — 8 bytes (64 bits), factory-programmed and immutable. First byte 0xE0 (per ISO 15693), second byte 0x04 (NXP manufacturer code), remaining 6 bytes unique serial. The ISO 15693 UID space gives ~281 trillion unique identifiers. Sufficient for any conceivable library or industrial inventory.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">AFI (Application Family Identifier). A 1-byte field identifying the application domain (libraries, retail, transport, financial). ISO 15693 allows readers to query only tags of a specific AFI, enabling efficient multi-tenant coexistence. A library reader can ignore non-library tags in the field.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">DSFID (Data Storage Format Identifier). A 1-byte field indicating how the user memory is formatted (e.g., NDEF, library-specific schemas). Libraries often set DSFID to a specific value identifying their particular ILS (Integrated Library System) vendor&#39;s memory layout.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">EAS bit — 1-bit flag that library gates interrogate via the fast EAS Check command. Readers at checkout set or reset this bit when a book is borrowed or returned. If not reset when an item exits the library, the gate alarms.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Block lock bits: per-block lock flags. Once a block is locked, it becomes read-only permanently. Used to finalize a library tag&#39;s static data (barcode, branch code) at issuance so that only the &#39;dynamic&#39; portion (EAS, flags) can be modified thereafter.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">NFC Forum Type 5 mapping — the library-book memory map on SLIX2 can optionally be formatted as an NDEF-bearing Type 5 tag. Block 0 becomes a Capability Container (CC) with 4 bytes identifying NDEF version, memory size in 8-byte units, read/write access, and NDEF magic number 0xE1. Subsequent blocks hold the TLV-encoded NDEF message. This dual-use lets the same book carry both the library&#39;s ILS data and a consumer-phone-tappable NDEF URL for patron-facing features (read more about the author, reserve a copy of the next volume).</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">DESTROY/KILL command: SLIX2 supports a DESTROY password that, when issued, permanently disables the chip. Unlike UHF Gen2&#39;s KILL, the HF version is a proprietary NXP extension. Used at end-of-life in high-security library weeding workflows where deaccessioned books should not retain readable RFID state in the recycling or resale stream.</li></ul>     </section><section class=\\"codex-editorial-section\\" id=\\"iso-15693-air-interface-and-icode-slix-specifics\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"75:2\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"76:7\\">ISO 15693 air interface and ICODE SLIX specifics</h2> <p class=\\"codex-editorial-section-intro\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionIntro.astro\\" data-astro-source-loc=\\"19:2\\">ISO/IEC 15693 is sometimes mistaken for &#39;another version of NFC&#39; because it operates at the same 13.56 MHz carrier as ISO 14443 and NFC Forum tag types. The two standards are physically similar but protocol-distinct: 15693 uses a different modulation scheme (1/256 pulse-position or 1/4 PPM at reader-to-tag, ASK or FSK at tag-to-reader), longer read ranges achieved by weaker field coupling rather than stronger power delivery, and a slotted-ALOHA anti-collision algorithm optimised for batch reads instead of 14443&#39;s deterministic binary-tree anti-collision optimised for single-card presentation. Integrators coming from an MIFARE/14443 background often under-estimate the difference and specify the wrong reader chipset for their ICODE SLIX deployment.</p>        <ul class=\\"codex-editorial-list\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"38:38\\"><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">ISO/IEC 15693 is the &#39;vicinity card&#39; standard — 13.56 MHz carrier, different air interface from the &#39;proximity card&#39; ISO 14443. Reader-to-tag data rate 1.65 kbps or 26.48 kbps (subcarrier) / 53 kbps (ASK); tag-to-reader rate 6.62 kbps or 26.48 kbps.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">ISO/IEC 18000-3 Mode 1 — the &#39;air interface for HF items&#39; standard that ICODE SLIX is certified compliant with. Mode 1 = 15693-compatible; Mode 2 is different and not relevant to SLIX.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Read range: up to ~1.5 m on a large library-gate antenna (50 × 50 cm portal) with a library-book-sized card antenna (book-inlay is ~70 × 40 mm). Typical cost/performance sweet spot: 80-100 cm range on a 30 × 30 cm reader antenna.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Anti-collision: ISO 15693 anti-collision via slotted ALOHA using the UID. Reader broadcasts an Inventory command; tags respond in slots determined by their UID bits. Very effective for batch reads. A 50-item linen-tunnel batch is resolved in &lt;100 ms.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Command set: Inventory, Stay Quiet, Read Single Block, Read Multiple Blocks, Write Single Block, Write Multiple Blocks, Get System Information, Get Block Security Status. Plus the ICODE-specific proprietary commands: EAS Check, Set EAS, Reset EAS, Get Random Number, Set Password, Write Password, PRIVACY (SLIX2), Destroy (SLIX2).</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Power budget: ICODE SLIX has excellent sensitivity; the chip can power up from ~1.5 µW received RF power. This is what allows the long-range reads in library portal applications where the reader&#39;s field is spread over a large volume.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Reader chipset families: NXP CLRC663 plus, ST CR95HF, Texas Instruments TRF7970A, and Impinj&#39;s RFIC stack all support ISO 15693 Mode 1. Consumer-phone NFC controllers (PN7150, PN7160 in newer Android handsets; Apple&#39;s proprietary NFC-NCI module) also include ISO 15693 Mode 1 decoding, enabling NFC Forum Type 5 tag reads from phones. 14443-only chipsets (older ACR122U firmware, some budget embedded NFC modules) cannot read ISO 15693 at all.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Fast mode and high-speed flag. The ISO 15693 Inventory command carries flag bits that configure data rate, subcarrier scheme and slot count. SLIX and SLIX2 support &#39;fast mode&#39; (26.48 kbps single-subcarrier) which approximately doubles batch-read throughput at slightly reduced range. Gate-portal deployments typically keep fast mode off for range; laundry-tunnel and library-conveyor deployments usually turn it on for throughput.</li></ul>     </section><section class=\\"codex-editorial-section\\" id=\\"eas-electronic-article-surveillance-and-library-workflows\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"75:2\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"76:7\\">EAS (Electronic Article Surveillance) and library workflows</h2> <p class=\\"codex-editorial-section-intro\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionIntro.astro\\" data-astro-source-loc=\\"19:2\\">The EAS feature is the defining advantage of ICODE SLIX over every other HF chip in the market. It is a hardware-enforced, low-latency gate-interrogation mechanism that makes anti-theft practical at throughput levels impossible with full memory reads. Library deployments that want to check out 200 books in a patron&#39;s bag in under 2 seconds, or lose-leaf inventory reads across a 50-book shelf in a single swipe, can only do this because EAS reduces gate interrogation to a single bit per tag. Understanding EAS at a protocol level matters because the subtle differences between SLIX and SLIX2 (password protection on the EAS write commands, lockability) change the security posture of the entire anti-theft workflow.</p>        <ol class=\\"codex-editorial-step-list\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"29:43\\"><li class=\\"codex-editorial-step\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"31:42\\"><span class=\\"codex-editorial-step-index\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"32:52\\">Step 1</span><div class=\\"codex-editorial-step-copy\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"33:12\\">EAS bit: single-bit hardware state. Readable by the fast EAS Check command, writable by Set EAS and Reset EAS. Library-specific semantics: set on books currently on loan, reset on books returned.</div></li><li class=\\"codex-editorial-step\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"31:42\\"><span class=\\"codex-editorial-step-index\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"32:52\\">Step 2</span><div class=\\"codex-editorial-step-copy\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"33:12\\">Library checkout flow: at the self-service kiosk, the reader (1) identifies the book via Inventory, (2) reads the book&#39;s barcode from memory, (3) logs the checkout in the ILS, (4) calls Reset EAS so the item can leave the library without tripping the gate.</div></li><li class=\\"codex-editorial-step\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"31:42\\"><span class=\\"codex-editorial-step-index\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"32:52\\">Step 3</span><div class=\\"codex-editorial-step-copy\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"33:12\\">Library return flow: reverse. At the return kiosk or book drop, the reader (1) identifies the book, (2) logs the return, (3) calls Set EAS. The book goes back on the shelf with its EAS bit active.</div></li><li class=\\"codex-editorial-step\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"31:42\\"><span class=\\"codex-editorial-step-index\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"32:52\\">Step 4</span><div class=\\"codex-editorial-step-copy\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"33:12\\">Gate alarm workflow: library gates run continuous Inventory scans. When any tag responds with EAS bit set, the gate alarms. Because EAS Check is a lightweight command (no full memory read), gates can process multiple books in a patron&#39;s bag simultaneously.</div></li><li class=\\"codex-editorial-step\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"31:42\\"><span class=\\"codex-editorial-step-index\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"32:52\\">Step 5</span><div class=\\"codex-editorial-step-copy\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"33:12\\">EAS password protection: SLIX2 allows setting a 64-bit password on the EAS write commands. Once set, only readers with the password can Set/Reset EAS, preventing casual EAS tampering. Unprotected SLIX (SL2S2002) has no such protection; EAS is writable by anyone with an ISO 15693 reader.</div></li><li class=\\"codex-editorial-step\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"31:42\\"><span class=\\"codex-editorial-step-index\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"32:52\\">Step 6</span><div class=\\"codex-editorial-step-copy\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"33:12\\">PRIVACY mode (SLIX2 only). On Privacy command invocation, the chip stops responding to all ISO 15693 commands except the specific unlock sequence (using the 64-bit privacy password). Used for after-checkout mode where the book should be invisible to bookstore/library inventory systems during patron transit.</div></li><li class=\\"codex-editorial-step\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"31:42\\"><span class=\\"codex-editorial-step-index\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"32:52\\">Step 7</span><div class=\\"codex-editorial-step-copy\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"33:12\\">Multi-use laundry and linen tunnels. Same EAS mechanism is used by some industrial linen operators as a &#39;dirty/clean&#39; state flag, although laundry typically uses UHF for throughput today. SLIX still has share in high-temperature laundry where the HF + silicone/PPS chip combo tolerates the wash cycles better than UHF paper inlays.</div></li><li class=\\"codex-editorial-step\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"31:42\\"><span class=\\"codex-editorial-step-index\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"32:52\\">Step 8</span><div class=\\"codex-editorial-step-copy\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"33:12\\">AFI-filtered gates vs EAS. Some library vendors use the AFI (Application Family Identifier) byte as a secondary mechanism to distinguish loaned vs returned books. A gate reader issuing an Inventory command with a specific AFI filter (e.g., 0xC2 for &#39;libraries&#39;) will only see tags in that application domain; setting the AFI to a different value on checkout effectively &#39;hides&#39; the book from the return gate. EAS and AFI-filtered gates are complementary: EAS for fast gate checks, AFI for multi-tenant coexistence when a single reader might see library books, museum tags and laundry items in the same field.</div></li><li class=\\"codex-editorial-step\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"31:42\\"><span class=\\"codex-editorial-step-index\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"32:52\\">Step 9</span><div class=\\"codex-editorial-step-copy\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"33:12\\">NISO data profile compatibility. The NISO RP-6-2012 library RFID data profile (and its German DIN ISO 28560 cousin) specifies that library book tags store a primary item identifier in a specific block layout, with mandatory fields for owner institution and optional fields for patron ID, acquisition date and item type. ICODE SLIX memory is large enough for both the NISO required-fields subset and the extended-fields layer. SLIX2 is needed only when deployments want additional fields beyond the base profile.</div></li></ol>     </section><section class=\\"codex-editorial-section\\" id=\\"antenna-physical-and-environmental\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"75:2\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"76:7\\">Antenna, physical, and environmental</h2> <p class=\\"codex-editorial-section-intro\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionIntro.astro\\" data-astro-source-loc=\\"19:2\\">ICODE SLIX is the chip that powers tens of millions of library tags, laundry chips and museum exhibits because the antenna-substrate-packaging combinations have been industrialised at every scale and environmental class. The silicon&#39;s electrical parameters are stable enough that the major converters (Smartrac, Avery Dennison, Invengo, LAB ID, Identiv, HID Global) publish reference designs for every major form factor, and procurement teams can reliably request &#39;SLIX in a 75×15 mm book label&#39; or &#39;SLIX in a PPS 30×15 mm laundry chip&#39; and get compatible inlays across multiple suppliers.</p>        <ul class=\\"codex-editorial-list\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"38:38\\"><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Chip input impedance: approximately 23 pF parallel capacitance + 2 kΩ equivalent resistance at 13.56 MHz. ICODE SLIX antenna inlays typically use 3-5 turn rectangular or oval coils tuned to this capacitance.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Form factors: library book inlay (adhesive 50-75 mm label), ID-1 card (85.6 × 54 mm), laundry silicone/PPS tag, museum exhibit tag, pharma blister tag. Chip is identical across form factors; antenna is re-sized and re-tuned per substrate.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Book-inlay sizing: typical library book inlay is 50 × 10 mm up to 75 × 15 mm, placed in the spine or front cover. This gives 60-90 cm read range from a library-gate portal.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Operating temperature — -40 °C to +85 °C standard operation. Peak 125 °C for short excursions (allows commercial-cure lamination of PVC around the chip). For sustained high-temperature use (autoclave ~135 °C, tire-cure &gt;180 °C), switch to silicon purpose-built for that (NXP offers extended-temperature ICODE derivatives; industrial laundry vendors typically spec the PPS-housing variant).</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Water and humidity: ICODE SLIX is IP-rated via the housing material, not the chip itself. HF ISO 15693 is robust through water (library returns in rain-wet books read correctly). Typical library-book survival is ≥ 10 years before the antenna adhesive fails.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">ISO 14443 coexistence — at the same frequency (13.56 MHz), ISO 15693 and ISO 14443 tags can be read by dual-mode readers. Physical separation is by air-interface protocol, not by frequency. A library gate reader is typically ISO 15693-only; a reception desk card reader may be ISO 14443-only. Combined readers (both standards) exist for mixed-credential deployments.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Industrial PPS laundry chip specifications. The standard PPS (polyphenylene sulfide) laundry chip housing ICODE SLIX or SLIX-L measures 22 × 16 × 4 mm or 30 × 15 × 3 mm, tolerates 200+ industrial wash cycles at 90°C, 50+ tumble-dry cycles at 180°C, and 30+ autoclave cycles at 134°C. Standard chip mounting methods are silicone-RTV adhesion into garment seams (for linen tunnels) or direct pre-sewn pockets (for uniform rental). These are the numbers that matter at RFQ, not the SL2S-series datasheet numbers alone.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Antenna-tuning interaction with metal. Ferrite-backed inlays (typical 0.3–1 mm thickness) recover 80–95% of the free-air read range when the tag sits on steel. Common ferrite compositions for HF are MnZn (manganese-zinc) or NiZn (nickel-zinc); NiZn is more expensive but tolerates higher temperatures and is preferred for industrial laundry chips. Without ferrite, a SLIX tag on steel typically reads at 5% or less of its free-air range.</li></ul>     </section><section class=\\"codex-editorial-section\\" id=\\"commercial-deployments-and-application-fit\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"75:2\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"76:7\\">Commercial deployments and application fit</h2> <p class=\\"codex-editorial-section-intro\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionIntro.astro\\" data-astro-source-loc=\\"19:2\\">ICODE SLIX has the narrowest commercial profile of the major HF chips. It is genuinely dominant in libraries, present in industrial laundry and museums, and almost entirely absent from access control, payment and broad supply chain. Understanding where SLIX fits and where it doesn&#39;t prevents the most common chip-selection mistakes: specifying ISO 15693 for an access-control project (where MIFARE Plus or DESFire is the right answer), or specifying ISO 14443 MIFARE for a library deployment (where the short read range makes gate deployment impractical). The wrong chip for the application is a far more common failure mode than the wrong chip within the same family.</p>        <ul class=\\"codex-editorial-list\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"38:38\\"><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Libraries: ICODE SLIX / SLIX2 is the dominant HF chip in library RFID globally. Bibliotheca, Envisionware, 3M-RFID (Checkpoint), Innovative Interfaces, SirsiDynix, and most regional library-automation vendors specify ISO 15693 ICODE SLIX compatibility as the minimum for book tags. Tens of millions of books tagged worldwide since 2005.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Museum and exhibit tagging. Museums use ISO 15693 for exhibit RFID because of the long-range + robust single-tag read. A visitor walking past an exhibit triggers audio-guide or display content via a tag embedded in the exhibit stand. Smithsonian, The Met, V&amp;A, Louvre all have ISO 15693 installations (not always ICODE SLIX specifically, but mostly).</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Industrial laundry at the HF tier. For wash-tolerant on-textile tags where the read-range of HF is sufficient (pre-sort and post-wash inventory). UHF is dominant in tunnel reads, but HF ICODE SLIX remains competitive for laundry where water/metal/batching conditions make UHF reads unreliable.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Pharmaceutical track-and-trace. Some pharmaceutical blister-pack inventory uses ICODE SLIX for its long-range + dense-anti-collision combination. Not a volume segment but niche in hospital pharmacy and high-value cold-chain pharma.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Animal identification (niche): ISO 15693 is NOT the ISO standard for animal identification (that&#39;s ISO 11784/11785 at 134.2 kHz LF). ICODE SLIX is not suited for animal implants.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Where ICODE SLIX is NOT the right choice — payment (use MIFARE DESFire / PayPass HF 14443), secure access control (use DESFire / MIFARE Plus), UHF supply chain (use UCODE 9 / Monza R6 / Higgs 9), simple NFC tap-to-URL campaigns (use NTAG213/215/216 — ICODE SLIX is not ISO 14443 and won&#39;t be read by standard NFC phones as a plain NFC tag).</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">NFC phone compatibility: Android phones with NFC READER mode typically support ISO 15693 (NFC Forum Type 5 Tag). iPhone supports ISO 15693 via Core NFC as of iOS 13. Standard consumer NFC-tap flows (open URL on tap) work on ICODE SLIX tags configured as NFC Type 5 with NDEF records.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Healthcare linen and uniform rental. Hospital laundry operators (Unitex, CTC Group, Mewa, Elis, Alsco, Cintas) deploy ICODE SLIX-L in PPS laundry chips for high-temperature wash and autoclave cycles. Linen plants process 500-2000 items per batch through HF tunnel readers in under 60 seconds. UHF is dominant in non-medical uniform laundry where higher throughput matters more than wet-metal read robustness, but HF ICODE retains share in medical-grade deployments.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Museum collection management: the Smithsonian American Art Museum, Tate Modern, Rijksmuseum and dozens of national museums have moved to ISO 15693 tagging for collection inventory, loan tracking and conservation history. The long read range lets curators inventory a gallery wall without touching each object, and the NFC Forum Type 5 mode supports visitor-facing audio-guide tap-to-play on the same tag.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Document and archive tagging. Government archives (US National Archives, UK National Archives, Bundesarchiv, Archives Nationales de France) use ICODE SLIX for file-folder tracking in climate-controlled storage. Paper-safe inlays (archival-grade adhesives, no plasticiser migration) are a specialised converter product; Smartrac&#39;s Archive-grade line and LAB ID&#39;s ArchivHF are the common references.</li></ul>     </section><section class=\\"codex-editorial-section\\" id=\\"nxp-and-iso-reference-documents\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"75:2\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"76:7\\">NXP and ISO reference documents</h2> <p class=\\"codex-editorial-section-intro\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionIntro.astro\\" data-astro-source-loc=\\"19:2\\">The ICODE SLIX documentation layer has two tiers. A public documentation layer anyone can download from NXP, and an under-NDA detailed data-sheet layer for converters and integrators. For most deployment decisions the public layer plus the ISO 15693 standard itself are sufficient; the NDA tier becomes necessary only when building custom readers, designing novel inlays, or implementing the DESTROY and PRIVACY command sequences on SLIX2. The list below is the short-form reference library every serious SLIX integrator keeps bookmarked.</p>        <ul class=\\"codex-editorial-list\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"38:38\\"><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">NXP SL2S2002 (ICODE SLIX) and SL2S2602 (ICODE SLIX2) Product Data Sheets. The canonical references. Memory map, command set, electrical characterization, timings.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">NXP AN11809 — ICODE SLIX2 features and security application note. Documents the PRIVACY command, 64-bit password structure, and EAS password-protection workflows.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">ISO/IEC 15693-3:2019 — the air-interface standard. Defines Inventory, Stay Quiet, Read/Write Single and Multiple Block commands, AFI and DSFID, lock mechanisms.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">ISO/IEC 18000-3 Mode 1:2010 — &#39;air interface at 13.56 MHz&#39; item-management standard. Mode 1 is functionally 15693-compatible; ICODE SLIX is certified for this.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">NFC Forum Type 5 Tag Technical Specification. Defines how an ISO 15693 tag maps to the NFC Forum Type 5 tag model for consumer-phone NDEF-tap compatibility.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">NISO RP-6-2012 — library RFID data profile. Defines the recommended memory schema for library book tags (branch code + patron ID + item barcode + checkout flags), ensuring interoperability between library-automation vendors.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">DIN ISO 28560-1/-2/-3 — the international library RFID data model. Part 1 defines the general data model, Part 2 the encoding rules, Part 3 the per-country profiles. Widely adopted across European libraries as the migration target from NISO RP-6 for cross-border interoperability.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">NXP AN11350 — Originality Signature public keys and verification procedure for ICODE SLIX2 and ICODE DNA. Contains the ECC public keys and sample verification code that reader vendors use to authenticate NXP silicon at read time. Without this document, integrators cannot implement the anti-counterfeit signature layer correctly.</li></ul>     </section><section class=\\"codex-editorial-section\\" id=\\"typical-personalisation-and-command-sequence\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"75:2\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"76:7\\">Typical personalisation and command sequence</h2> <p class=\\"codex-editorial-section-intro\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionIntro.astro\\" data-astro-source-loc=\\"19:2\\">The operational flow for programming an ICODE SLIX library book tag or laundry chip is a short, well-defined sequence that hasn&#39;t changed since 2010. Integrators writing personalisation scripts for Bibliotheca Select, Envisionware EZscan, 3M/Checkpoint ScanEase or in-house library-automation stacks typically encounter the same five-to-seven-step pattern. Understanding the command sequence helps diagnose failures at the pilot stage. Almost all SLIX issuance bugs fall into the categories &#39;wrong block addressed&#39;, &#39;wrong DSFID/AFI convention&#39; or &#39;EAS password not set before lock&#39;.</p>        <ul class=\\"codex-editorial-list\\" data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"38:38\\"><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Identify the tag: Inventory command with optional AFI filter. Reader receives the 8-byte UID (UID[0]=0xE0, UID[1]=0x04 for NXP). On SLIX2, read the Originality Signature via the proprietary READ_SIGNATURE command (0xBD with vendor prefix 0x04) and verify against NXP&#39;s public key before proceeding.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Read existing state: Get System Information (0x2B) returns DSFID, AFI, memory size in blocks (27 or 28 for SLIX, 79 or 80 for SLIX2), and IC reference. Use this to confirm the chip type before writing. Assuming SLIX when SLIX2 is present (or vice versa) leads to block addresses past the end of memory returning success codes but writing nothing.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Write library data: Write Single Block (0x21 + 4-byte block address + 4 bytes data) or Write Multiple Blocks (0x24 + start address + count + data). Library data typically includes a 16-byte item identifier per DIN ISO 28560, 1 byte item type, 1 byte checkin/checkout flag, 2-4 bytes branch code, plus optional fields.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Set DSFID and AFI. Write DSFID (0x29) and Write AFI (0x27) to register the tag&#39;s data format and application domain. Libraries typically use DSFID values specified by their ILS vendor (Bibliotheca, Envisionware, Innovative, SirsiDynix) and AFI 0xC2 for &#39;libraries&#39; or a custom library-chain-specific AFI.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Set EAS: Set EAS (0xA2 with NXP vendor prefix). Now the tag will alarm library gates. For SLIX2, call the password-protected variant (0xB4) after setting the EAS password via Set Password (0xB3). Without password protection, any ISO 15693 reader can reset the EAS later. Acceptable in low-threat library environments, not acceptable in high-theft retail or high-value museum contexts.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Lock static blocks: Lock Block (0x22 + block address) to permanently freeze blocks holding the item identifier, branch code and other static data. Block lock is irreversible; verify the data is correct before locking, because a mis-locked tag becomes useless and has to be weeded from the collection.</li><li data-astro-source-file=\\"<project-root>/src/components/editorial/SectionList.astro\\" data-astro-source-loc=\\"40:10\\">Verify and archive: Read back the tag via Read Multiple Blocks to confirm all writes landed. Log the UID, item identifier, and personalisation timestamp to the ILS database for later audit. Most library automation stacks automate this entire flow at the checkout or self-issue station, but pilot deployments and custom tag programmes often write the script from scratch.</li></ul>     </section><section class=\\"codex-editorial-section\\" id=\\"specifications-at-a-glance\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"75:2\\"> <h2 data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialSection.astro\\" data-astro-source-loc=\\"76:7\\">Specifications at a glance</h2>           <div class=\\"codex-scroll-region codex-editorial-table-wrap\\" tabindex=\\"0\\" role=\\"region\\" aria-label=\\"Comparison table — scroll horizontally to see more columns\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"59:2\\"> <table class=\\"codex-editorial-table\\" data-sortable=\\"true\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"60:61\\"> <thead data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"61:12\\"> <tr data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"62:11\\"> <th scope=\\"col\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"65:29\\"> <span class=\\"codex-th-label\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"66:44\\">Parameter</span> </th><th scope=\\"col\\" data-sort-col=\\"1\\" aria-sort=\\"none\\" tabindex=\\"0\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"74:14\\"> <span class=\\"codex-th-label\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"75:44\\">ICODE SLIX (SL2S2002)</span> <span class=\\"codex-th-indicator\\" aria-hidden=\\"true\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"76:16\\"></span> </th><th scope=\\"col\\" data-sort-col=\\"2\\" aria-sort=\\"none\\" tabindex=\\"0\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"74:14\\"> <span class=\\"codex-th-label\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"75:44\\">ICODE SLIX2 (SL2S2602)</span> <span class=\\"codex-th-indicator\\" aria-hidden=\\"true\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"76:16\\"></span> </th><th scope=\\"col\\" data-sort-col=\\"3\\" aria-sort=\\"none\\" tabindex=\\"0\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"74:14\\"> <span class=\\"codex-th-label\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"75:44\\">ICODE SLIX-L (SL2S5502)</span> <span class=\\"codex-th-indicator\\" aria-hidden=\\"true\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"76:16\\"></span> </th> </tr> </thead> <tbody data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"82:12\\"> <tr data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"84:13\\"> <th scope=\\"row\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"85:27\\">Operating frequency</th> <td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">13.56 MHz</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">13.56 MHz</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">13.56 MHz</td> </tr><tr data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"84:13\\"> <th scope=\\"row\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"85:27\\">Air-interface standard</th> <td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">ISO 15693 / ISO 18000-3 Mode 1</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">ISO 15693 / ISO 18000-3 Mode 1</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">ISO 15693 / ISO 18000-3 Mode 1</td> </tr><tr data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"84:13\\"> <th scope=\\"row\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"85:27\\">User memory</th> <td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">896 bits (112 bytes)</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">2,560 bits (320 bytes)</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">320 bits (40 bytes)</td> </tr><tr data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"84:13\\"> <th scope=\\"row\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"85:27\\">UID</th> <td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">64-bit (8 bytes)</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">64-bit (8 bytes)</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">64-bit (8 bytes)</td> </tr><tr data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"84:13\\"> <th scope=\\"row\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"85:27\\">EAS (Electronic Article Surveillance)</th> <td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\"><span class=\\"codex-cell-glyph\\" data-cell-glyph=\\"yes\\" aria-label=\\"Supported\\" role=\\"img\\">Yes</span></td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">Yes (password-protected)</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\"><span class=\\"codex-cell-glyph\\" data-cell-glyph=\\"yes\\" aria-label=\\"Supported\\" role=\\"img\\">Yes</span></td> </tr><tr data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"84:13\\"> <th scope=\\"row\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"85:27\\">PRIVACY mode</th> <td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\"><span class=\\"codex-cell-glyph\\" data-cell-glyph=\\"no\\" aria-label=\\"Not supported\\" role=\\"img\\">No</span></td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">Yes (64-bit password)</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\"><span class=\\"codex-cell-glyph\\" data-cell-glyph=\\"no\\" aria-label=\\"Not supported\\" role=\\"img\\">No</span></td> </tr><tr data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"84:13\\"> <th scope=\\"row\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"85:27\\">DESTROY password</th> <td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\"><span class=\\"codex-cell-glyph\\" data-cell-glyph=\\"no\\" aria-label=\\"Not supported\\" role=\\"img\\">No</span></td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\">Yes (64-bit)</td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\"><span class=\\"codex-cell-glyph\\" data-cell-glyph=\\"no\\" aria-label=\\"Not supported\\" role=\\"img\\">No</span></td> </tr><tr data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"84:13\\"> <th scope=\\"row\\" data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"85:27\\">Originality Signature</th> <td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\"><span class=\\"codex-cell-glyph\\" data-cell-glyph=\\"no\\" aria-label=\\"Not supported\\" role=\\"img\\">No</span></td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\"><span class=\\"codex-cell-glyph\\" data-cell-glyph=\\"yes\\" aria-label=\\"Supported\\" role=\\"img\\">Yes</span></td><td data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"87:14\\"><span class=\\"codex-cell-glyph\\" data-cell-glyph=\\"no\\" aria-label=\\"Not supported\\" role=\\"img\\">No</span></td> </tr><tr data-astro-source-file=\\"<project-root>/src/components/editorial/EditorialTable.astro\\" data-astro-source-loc=\\"84:13\\"> <th scope=\\"row\\"