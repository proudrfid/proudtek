---
/**
 * Single resource card — one of N inside the "Useful next pages" grid.
 *
 * Shadow component (Stage 2). Mirrors `renderResourceCard(card)` in
 * editorial-pages.ts (~line 2155).
 *
 * Schema: src/lib/editorial-types.ts → EditorialResourceCard
 *   title:       string
 *   description: string
 *   links:       Array<{ href, label, description? }>
 */
interface ResourceLink {
  href: string;
  label: string;
  description?: string;
}

interface ResourceCardData {
  title: string;
  description: string;
  links: ResourceLink[];
}

interface Props {
  card: ResourceCardData;
}

const { card } = Astro.props;
---
<section class="codex-card codex-editorial-card">
  <h2>{card.title}</h2>
  <p>{card.description}</p>
  <div class="codex-editorial-link-list">
    {card.links.map((link) => (
      <a class="codex-editorial-link-card" href={link.href}>
        <strong>{link.label}</strong>
        {link.description && <span>{link.description}</span>}
      </a>
    ))}
  </div>
</section>
