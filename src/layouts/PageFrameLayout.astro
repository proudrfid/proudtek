---
import BaseLayout from "./BaseLayout.astro";
import SiteShell from "../components/shell/SiteShell.astro";
import codexShellCss from "../styles/codex-shell.css?inline";
import type { PageSeoData } from "../lib/seo";

interface Props {
  seo: PageSeoData;
  currentRoute: string;
  machineJsonPath?: string;
  machineTextPath?: string;
  stickyCtaHref?: string;
  stickyCtaLabel?: string;
  showStickyCta?: boolean;
}

const {
  seo,
  currentRoute,
  machineJsonPath,
  machineTextPath,
  stickyCtaHref,
  stickyCtaLabel,
  showStickyCta = true,
} = Astro.props;
---
<BaseLayout
  seo={seo}
  machineJsonPath={machineJsonPath}
  machineTextPath={machineTextPath}
  stickyCtaHref={stickyCtaHref}
  stickyCtaLabel={stickyCtaLabel}
  showStickyCta={showStickyCta}
>
  <Fragment slot="head">
    <style set:html={codexShellCss}></style>
  </Fragment>
  <SiteShell currentRoute={currentRoute}>
    <slot />
  </SiteShell>
</BaseLayout>
