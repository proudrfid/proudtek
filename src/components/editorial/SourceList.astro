---
/**
 * SourceList — renders the uniform "Sources" block at the end of an article.
 *
 * Takes definition.sources[] and renders as an ordered list with label,
 * publisher, publication date, and our access date. Each URL is marked
 * rel="noopener" (we intentionally do NOT add nofollow — we're vouching for
 * the citation, and this is a link-earning + EEAT signal).
 *
 * JSON-LD emission is handled separately in EditorialPage.astro so we avoid
 * duplicating the array.
 */
import type { EditorialDefinition } from "../../lib/editorial-types";

interface Props {
  definition: EditorialDefinition;
  id?: string;
}

const { definition, id = "sources" } = Astro.props;
const sources = definition.sources ?? [];

function formatDate(iso: string | undefined): string | null {
  if (!iso) return null;
  try {
    const d = new Date(iso.length === 4 ? `${iso}-01-01` : iso);
    if (Number.isNaN(d.getTime())) return iso;
    return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
  } catch {
    return iso;
  }
}

/** Derive the display host (e.g. "iso.org") from a URL. */
function displayHost(url: string): string {
  try {
    return new URL(url).host.replace(/^www\./, "");
  } catch {
    return url;
  }
}
---

{sources.length > 0 && (
  <section id={id} class="codex-sources" aria-labelledby={`${id}-heading`}>
    <h2 id={`${id}-heading`} class="codex-sources-heading">Sources &amp; references</h2>
    <p class="codex-sources-lead">
      Primary standards, OEM datasheets and regulatory documents cited by this article.
      All URLs were verified on the access date shown below.
    </p>
    <ol class="codex-sources-list">
      {sources.map((src) => {
        const pub = src.publisher ? src.publisher : displayHost(src.url);
        const published = formatDate(src.publishedAt);
        const accessed = formatDate(src.accessedAt);
        return (
          <li class="codex-sources-item">
            <a
              class="codex-sources-link"
              href={src.url}
              rel="noopener external"
              target="_blank"
            >{src.label}</a>
            <span class="codex-sources-meta">
              <span class="codex-sources-publisher">{pub}</span>
              {published && <span class="codex-sources-date"> · {published}</span>}
              {accessed && <span class="codex-sources-accessed"> · accessed {accessed}</span>}
            </span>
            {src.note && <p class="codex-sources-note">{src.note}</p>}
          </li>
        );
      })}
    </ol>
  </section>
)}

<style>
  .codex-sources {
    margin-top: 2.5rem;
    padding: 1.25rem 1.4rem 1.5rem;
    background: #fafbfc;
    border: 1px solid #e4e8ed;
    border-radius: 8px;
  }
  .codex-sources-heading {
    margin: 0 0 0.4rem;
    font-size: 1.2rem;
    color: #0f2333;
  }
  .codex-sources-lead {
    margin: 0 0 0.9rem;
    font-size: 0.92rem;
    color: #55687a;
  }
  .codex-sources-list {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .codex-sources-item { margin-bottom: 0.5rem; }
  .codex-sources-link {
    color: #0f6a7a;
    text-decoration: none;
    font-weight: 600;
  }
  .codex-sources-link:hover { text-decoration: underline; }
  .codex-sources-meta {
    color: #55687a;
    font-size: 0.88rem;
    margin-left: 0.35rem;
  }
  .codex-sources-publisher { font-style: italic; }
  .codex-sources-note {
    margin: 0.15rem 0 0;
    color: #55687a;
    font-size: 0.88rem;
  }
</style>
