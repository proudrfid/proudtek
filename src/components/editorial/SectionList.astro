---
/**
 * Bullet list or ordered step-list within a section.
 * Replaces renderSectionList() from editorial-pages.ts.
 */
import { isWorkflowSection, renderInlineLinks } from "../../lib/editorial-types";

interface Props {
  bullets: string[];
  sectionTitle: string;
}

const { bullets, sectionTitle } = Astro.props;
const isWorkflow = isWorkflowSection(sectionTitle);
---

{isWorkflow ? (
  <ol class="codex-editorial-step-list">
    {bullets.map((item, index) => (
      <li class="codex-editorial-step">
        <span class="codex-editorial-step-index">Step {index + 1}</span>
        <div class="codex-editorial-step-copy">
          <Fragment set:html={renderInlineLinks(item)} />
        </div>
      </li>
    ))}
  </ol>
) : (
  <ul class="codex-editorial-list">
    {bullets.map((item) => (
      <li><Fragment set:html={renderInlineLinks(item)} /></li>
    ))}
  </ul>
)}
