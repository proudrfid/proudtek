---
/**
 * Category hub page for /compare/{category}/.
 *
 * Renders 4 sub-category overview pages (one per entry in COMPARE_CATEGORIES):
 *   /compare/chip-vs-chip/
 *   /compare/reader-vs-reader/
 *   /compare/form-factor-material/
 *   /compare/frequency-tech/
 *
 * Layout matches /blog/ + /guides/ + /guides/{cluster}/ exactly:
 *   - Left rail with the active category highlighted
 *   - .codex-blog-index header with H1 + 1-line description
 *   - Flat 3-column .codex-blog-index__grid with the category's compare cards
 *
 * Architecture note: native .astro hub (path-3 pattern). Companion to
 * src/pages/compare/index.astro.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { COMPARE_CATEGORIES } from "../../data/compare-categories";
import type { CompareCategory } from "../../data/compare-categories";
import type { PageSeoData } from "../../lib/seo";
import { buildCompareCategoriesRailHtml } from "../../lib/seo/compare-rail";
import { extractChromeFromSnapshot } from "../../lib/seo/snapshot-chrome";
import { getPageByRoute } from "../../lib/site-data";
import { truncateText } from "../../lib/seo/utils";

/** See note in src/pages/compare/index.astro — strips SEO subtitle after em-dash. */
function shortenCardTitle(title: string): string {
  const headline = title.split(/\s+[—–-]\s+/u, 1)[0].trim();
  return truncateText(headline, 64);
}

interface Props {
  category: CompareCategory;
}

const SITE_ORIGIN = "https://www.proudtek.com";

function buildCategorySeo(category: CompareCategory, count: number): PageSeoData {
  const route = `/compare/${category.id}/`;
  const canonicalUrl = `${SITE_ORIGIN}${route}`;
  const title = category.seoTitle;

  const breadcrumbLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE_ORIGIN + "/" },
      { "@type": "ListItem", position: 2, name: "Resources", item: SITE_ORIGIN + "/resources/" },
      { "@type": "ListItem", position: 3, name: "Comparisons", item: SITE_ORIGIN + "/compare/" },
      { "@type": "ListItem", position: 4, name: category.label, item: canonicalUrl },
    ],
  });

  const collectionLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": canonicalUrl,
    name: category.label,
    description: category.description,
    url: canonicalUrl,
    isPartOf: { "@type": "WebSite", name: "Proud Tek", url: SITE_ORIGIN + "/" },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: count,
      itemListElement: category.slugs.map((slug, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE_ORIGIN}/compare/${slug}/`,
      })),
    },
  });

  return {
    htmlAttrs: { lang: "en" },
    bodyAttrs: { class: "page-compare-category" },
    headHtml: "",
    bodyHtml: "",
    kind: "collection",
    contentTitle: category.label,
    title,
    description: category.description,
    canonicalUrl,
    robots: "index, follow",
    indexable: true,
    jsonLd: [breadcrumbLd, collectionLd],
    imageUrl: "",
    imageAlt: `${category.label} comparison pages — Proud Tek`,
    imageGallery: [],
    faqEntries: [],
    procurementFields: [],
    collectionSummary: [],
    collectionGuidanceFields: [],
    collectionRelatedPages: [],
    collectionSourceLinks: [],
    coreSummary: category.pillars,
    coreGuidanceFields: [],
    coreRelatedPages: [],
    coreSourceLinks: [],
    articleSummary: [],
    articleGuidanceFields: [],
    articleRelatedPages: [],
    articleSourceLinks: [],
    productRelatedPages: [],
    productSourceLinks: [],
    ogType: "website",
    articleMeta: null,
  };
}

export async function getStaticPaths() {
  return COMPARE_CATEGORIES.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

const { category } = Astro.props as Props;

// Pull every compare entry once and filter to this category.
const allEditorial = await getCollection("editorial");
const comparesById = new Map<string, ReturnType<typeof Object>>();
for (const entry of allEditorial) {
  const m = entry.id.match(/^compare\/(.+)$/);
  if (m) comparesById.set(m[1], entry.data);
}

// Order matches category.slugs (curator-controlled). Skip any slug whose
// JSON went missing — defensive.
const categoryCompares = category.slugs
  .map((slug) => ({ slug, data: comparesById.get(slug) }))
  .filter((x): x is { slug: string; data: any } => Boolean(x.data));

const seo = buildCategorySeo(category, categoryCompares.length);
const railHtml = buildCompareCategoriesRailHtml(category.id);

// Pull the WP site header + footer chrome from a donor snapshot so category
// hubs render with the same masthead + footer as every other page. Prefer
// /compare/ as donor (when available), then /resources/, then /about/.
const currentRoute = `/compare/${category.id}/`;
const donorPage =
  (await getPageByRoute("/compare/")) ||
  (await getPageByRoute("/resources/")) ||
  (await getPageByRoute("/about/"));
if (!donorPage) {
  throw new Error(
    `[category].astro: no chrome donor snapshot (/compare/, /resources/, /about/ all missing)`,
  );
}
const chrome = extractChromeFromSnapshot(donorPage, currentRoute);
seo.htmlAttrs = { ...chrome.htmlAttrs, ...seo.htmlAttrs };
seo.bodyAttrs = {
  ...chrome.bodyAttrs,
  ...seo.bodyAttrs,
  class: [chrome.bodyAttrs.class, seo.bodyAttrs.class].filter(Boolean).join(" "),
};
seo.headHtml = chrome.headHtml + (seo.headHtml ?? "");
---

<BaseLayout seo={seo}>
  <Fragment set:html={chrome.beforeMainHtml} />

  <main id="main" class="site-main" role="main">
    {/* Left rail (same shape as /blog/ + /guides/ + /compare/) */}
    <Fragment set:html={railHtml} />

    <section
      class="codex-blog-index codex-blog-index--with-rail"
      aria-label={`${category.label} comparisons`}
    >
      <div class="codex-blog-index__header">
        <h1>{category.icon} {category.label}</h1>
        <p>{categoryCompares.length} comparisons — {category.description}</p>
      </div>
      <div class="codex-blog-index__grid">
        {categoryCompares.map(({ slug, data }) => (
          <a class="codex-card codex-blog-grid-card" href={`/compare/${slug}/`}>
            {data.heroImage && (
              <img
                class="codex-blog-grid-card__thumb"
                src={data.heroImage}
                alt={data.imageAlt || data.title}
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
              />
            )}
            <span class="codex-blog-grid-card__tag">{category.label}</span>
            <strong>{shortenCardTitle(data.title)}</strong>
            <p>{truncateText(data.summary, 120)}</p>
            <span class="codex-blog-grid-card__cta">Compare →</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Fragment set:html={chrome.afterMainHtml} />
</BaseLayout>
