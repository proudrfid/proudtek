---
/**
 * Section body slot — bullet list with workflow-vs-plain switch.
 *
 * Shadow component (Stage 2). Mirrors `renderSectionList()` in editorial-pages.ts
 * (~line 2010). Switches output based on the section title:
 *
 *   - Workflow titles (matching /workflow|steps|playbook/i):
 *     <ol class="codex-editorial-step-list"> with numbered Step entries.
 *   - Plain titles:
 *     <ul class="codex-editorial-list"> with simple <li> entries.
 *
 * Schema: bullets is `string[]` on EditorialSectionData. Items support inline
 * markdown + citation markers.
 */
import { renderInlineLinks, isWorkflowSection, type CitationCtx } from "../../lib/editorial-types";

interface Props {
  title: string;
  bullets: string[];
  citations?: CitationCtx;
}

const { title, bullets, citations } = Astro.props;
const isWorkflow = isWorkflowSection(title);
---
{bullets.length > 0 && (
  isWorkflow ? (
    <ol class="codex-editorial-step-list">
      {bullets.map((item, index) => (
        <li class="codex-editorial-step">
          <span class="codex-editorial-step-index">Step {index + 1}</span>
          <div class="codex-editorial-step-copy" set:html={renderInlineLinks(item, citations)} />
        </li>
      ))}
    </ol>
  ) : (
    <ul class="codex-editorial-list">
      {bullets.map((item) => (
        <li set:html={renderInlineLinks(item, citations)} />
      ))}
    </ul>
  )
)}
