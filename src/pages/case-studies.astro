---
/**
 * /case-studies/ — custom-designed case studies hub.
 *
 * Native .astro hub (path-3 pattern, mirrors /solutions/index.astro). Replaces
 * the previous WP-snapshot rendering of /case-studies/ with a bespoke design
 * (hero, stats, featured spotlight, 6-card story grid, industries strip,
 * testimonials, CTA). The design's own <header>/<footer> are intentionally
 * dropped — this page borrows the real WP masthead + footer via
 * extractChromeFromSnapshot() so its chrome matches the rest of the site.
 *
 * All design CSS is scoped under `.pt-cs` (see the <style is:global> block) so
 * the standalone page's global reset / body / section rules cannot leak onto
 * the shared site chrome.
 *
 * /case-studies/ must also be added to NATIVE_HUB_ROUTES in [...slug].astro
 * (so the catch-all slug generator doesn't also build it) and in
 * src/lib/seo-feeds.ts (so it still appears in the sitemap).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import type { PageSeoData } from "../lib/seo";
import { extractChromeFromSnapshot } from "../lib/seo/snapshot-chrome";
import { getPageByRoute } from "../lib/site-data";
import { SITE_ORIGIN } from "../lib/seo-content";

const ROUTE = "/case-studies/";
const CANONICAL_URL = `${SITE_ORIGIN}${ROUTE}`;

// Inter web font — matches the design. Kept in headHtml so it lands in <head>;
// the CSS keeps a system-font fallback if this fails to load.
const FONT_HEAD =
  '<link rel="preconnect" href="https://fonts.googleapis.com" />' +
  '<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />' +
  '<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />';

// ── SEO (built manually, mirroring solutions/index.astro) ──
// Reuse the real /case-studies/ snapshot title; description taken from the
// approved design's <meta name="description">.
const CS_TITLE = "Case Studies — Real RFID & NFC Deployments | Proud Tek";
const CS_DESCRIPTION =
  "See how organizations across hospitality, industry, and events use Proud Tek RFID & NFC to cut losses, speed up operations, and secure access — with measurable results.";

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE_ORIGIN + "/" },
    { "@type": "ListItem", position: 2, name: "Case Studies", item: CANONICAL_URL },
  ],
});

const collectionLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": CANONICAL_URL,
  name: "Proud Tek RFID & NFC Case Studies",
  description: CS_DESCRIPTION,
  url: CANONICAL_URL,
  isPartOf: { "@type": "WebSite", name: "Proud Tek", url: SITE_ORIGIN + "/" },
});

const seo: PageSeoData = {
  htmlAttrs: { lang: "en" },
  bodyAttrs: { class: "page-case-studies-hub" },
  headHtml: "",
  bodyHtml: "",
  kind: "collection",
  contentTitle: "Case Studies",
  title: CS_TITLE,
  description: CS_DESCRIPTION,
  canonicalUrl: CANONICAL_URL,
  robots: "index, follow",
  indexable: true,
  jsonLd: [breadcrumbLd, collectionLd],
  imageUrl: "",
  imageAlt: "Proud Tek RFID and NFC case studies",
  imageGallery: [],
  faqEntries: [],
  procurementFields: [],
  collectionSummary: [],
  collectionGuidanceFields: [],
  collectionRelatedPages: [],
  collectionSourceLinks: [],
  coreSummary: [],
  coreGuidanceFields: [],
  coreRelatedPages: [],
  coreSourceLinks: [],
  articleSummary: [],
  articleGuidanceFields: [],
  articleRelatedPages: [],
  articleSourceLinks: [],
  productRelatedPages: [],
  productSourceLinks: [],
  ogType: "website",
  articleMeta: null,
};

// ── WP chrome donor ──
// Prefer the /case-studies/ snapshot so the masthead + footer match the rest
// of the site. Fall back to /resources/ then /about/ (mirrors solutions).
const donorPage =
  (await getPageByRoute("/case-studies/")) ||
  (await getPageByRoute("/resources/")) ||
  (await getPageByRoute("/about/"));
if (!donorPage) {
  throw new Error(
    "case-studies.astro: no chrome donor snapshot (/case-studies/, /resources/, /about/ all missing)",
  );
}
const chrome = extractChromeFromSnapshot(donorPage, ROUTE);
seo.htmlAttrs = { ...chrome.htmlAttrs, ...seo.htmlAttrs };
seo.bodyAttrs = {
  ...chrome.bodyAttrs,
  ...seo.bodyAttrs,
  class: [chrome.bodyAttrs.class, seo.bodyAttrs.class].filter(Boolean).join(" "),
};
seo.headHtml = chrome.headHtml + FONT_HEAD + (seo.headHtml ?? "");
---

<BaseLayout seo={seo}>
  <Fragment set:html={chrome.beforeMainHtml} />

  <main id="main">
    <div class="pt-cs">
    <!-- HERO -->
    <section class="hero" style="padding:0">
      <span class="blob a"></span><span class="blob b"></span>
      <div class="wrap hero-inner">
        <span class="eyebrow">Case Studies</span>
        <h1>Real deployments.<br><span class="grad">Measurable results.</span></h1>
        <p class="lead">See how teams across hospitality, industry, and events put Proud Tek RFID &amp; NFC to work — cutting losses, speeding up operations, and securing access at scale, in the harshest field conditions.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#contact">Start your project
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="btn btn-ghost" href="#stories">Browse the stories</a>
        </div>
        <div class="hero-trust">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Manufacturing custom RFID since 2008 &nbsp;·&nbsp; Shipped to 40+ countries worldwide
        </div>
      </div>
    </section>

    <!-- STATS -->
    <div class="wrap stats">
      <div class="stats-grid reveal">
        <div class="stat"><div class="num">2008</div><div class="lbl">Building RFID since</div></div>
        <div class="stat"><div class="num">40<span>+</span></div><div class="lbl">Countries shipped to</div></div>
        <div class="stat"><div class="num">500M<span>+</span></div><div class="lbl">Tags produced annually</div></div>
        <div class="stat"><div class="num">99.9<span>%</span></div><div class="lbl">Field read reliability</div></div>
      </div>
    </div>

    <!-- SPOTLIGHT -->
    <section class="spotlight" id="spotlight">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">Featured deployment</span>
          <h2>1.8 million garments, 250+ wash cycles per tag</h2>
          <p>A closer look at a large-scale industrial laundry rollout — from the counting problem to a PPS-housed tag that outlives the garment it tracks.</p>
        </div>

        <div class="spot-card reveal">
          <div class="spot-media">
            <span class="badge">Industrial Laundry &amp; Uniform Rental</span>
            <img src="/landing-images/industrial-laundry-pps-rfid-tag-hero.jpg" alt="Proud Tek PPS-housed UHF RFID laundry tag heat-sealed into a rental garment" loading="lazy" />
          </div>
          <div class="spot-body">
            <h3>Giving 1.8 million rental garments a digital identity that survives the wash</h3>
            <div class="csr">
              <div class="row"><div class="tag">Challenge</div><div class="txt">A European uniform-rental operator ran <strong>three industrial laundries serving 14,000 B2B accounts</strong> on a textile-laminated tag that was down to <strong>91% readability by wash cycle 120</strong> — dead tags meant manual re-tagging and billing disputes.</div></div>
              <div class="row"><div class="tag">Solution</div><div class="txt">Proud Tek <strong>PPS-housed UHF laundry tags</strong> (heat-sealed, no exposed inlay) were fitted across all three rental pools — workwear, kitchen wear and healthcare uniforms — read hands-free at overhead sort-line portals.</div></div>
              <div class="row"><div class="tag">Results</div><div class="txt">Year-1 measured survival was <strong>99.4% of tags still readable at cycle 250</strong> (97.1% at cycle 350), with a <strong>99.7% sort-line portal read rate</strong> at 12 garments per second belt speed.</div></div>
            </div>
            <div class="metrics">
              <div class="metric"><div class="m-num">99.4<span>%</span></div><div class="m-lbl">Readable at cycle 250</div></div>
              <div class="metric"><div class="m-num">99.7<span>%</span></div><div class="m-lbl">Portal read rate</div></div>
              <div class="metric"><div class="m-num">2.1<span>yr</span></div><div class="m-lbl">Payback on tag cost</div></div>
            </div>
            <a class="card-link" href="/case-studies/industrial-laundry-pps-rfid-tag/" style="margin-top:22px">Read the full case study <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </div>
        </div>
      </div>
    </section>

    <!-- CASE GRID -->
    <section id="stories">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow" style="justify-content:center">More customer stories</span>
          <h2>One technology, deployed across industries</h2>
          <p>From encrypted hotel keys to DSCSA-ready pharmaceutical labels — six documented Proud Tek deployments and the numbers behind them.</p>
        </div>

        <div class="grid">

          <!-- Hotel -->
          <article class="card reveal">
            <div class="card-media">
              <span class="chip">Hospitality</span>
              <img src="/landing-images/hospitality-hotel-key-card-rollout-hero.jpg" alt="Custom-printed MIFARE Classic hotel key cards for a 28-property group" loading="lazy" />
            </div>
            <div class="card-body">
              <h3>A 28-property hotel group rolls out 2.4M key cards a year</h3>
              <p>A South-East Asia group moved 12,000 keyed rooms from magnetic-stripe to MIFARE Classic 1K contactless cards over 18 months — keeping full compatibility with its existing Saflok RFID locks.</p>
              <div class="card-metrics">
                <div><div class="cm-num">28</div><div class="cm-lbl">Properties</div></div>
                <div><div class="cm-num">2.4M<span>/yr</span></div><div class="cm-lbl">Cards supplied</div></div>
              </div>
              <a class="card-link" href="/case-studies/hospitality-hotel-key-card-rollout/">Read the story <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </article>

          <!-- Events -->
          <article class="card reveal">
            <div class="card-media">
              <span class="chip">Events &amp; Venues</span>
              <img src="/landing-images/music-festival-uhf-wristband-hero.jpg" alt="Single-use UHF RFID festival wristbands for cashless entry" loading="lazy" />
            </div>
            <div class="card-body">
              <h3>180,000 UHF wristbands run a four-day cashless festival</h3>
              <p>A European festival with a 45,000 daily peak used single-use UHF wristbands across every ticket tier for gate access, age verification, cashless top-up and re-entry tracking.</p>
              <div class="card-metrics">
                <div><div class="cm-num">180k</div><div class="cm-lbl">Wristbands</div></div>
                <div><div class="cm-num">45k</div><div class="cm-lbl">Daily peak entry</div></div>
              </div>
              <a class="card-link" href="/case-studies/music-festival-uhf-wristband/">Read the story <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </article>

          <!-- Libraries -->
          <article class="card reveal">
            <div class="card-media">
              <span class="chip">Libraries</span>
              <img src="/landing-images/library-icode-slix2-self-service-hero.jpg" alt="ICODE SLIX2 RFID labels on library books at a self-service kiosk" loading="lazy" />
            </div>
            <div class="card-body">
              <h3>A 47-branch library migrates 1.4M items to ICODE SLIX2</h3>
              <p>A US municipal library system replaced a legacy proprietary 13.56 MHz chip with ISO 15693 ICODE SLIX2 labels over 24 months — enabling self-service checkout and AFI-based security gates.</p>
              <div class="card-metrics">
                <div><div class="cm-num">1.4M</div><div class="cm-lbl">Items converted</div></div>
                <div><div class="cm-num">47</div><div class="cm-lbl">Branches</div></div>
              </div>
              <a class="card-link" href="/case-studies/library-icode-slix2-self-service/">Read the story <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </article>

          <!-- Pharmaceutical -->
          <article class="card reveal">
            <div class="card-media">
              <span class="chip">Pharmaceutical</span>
              <img src="/landing-images/pharmaceutical-dscsa-uhf-rfid-hero.jpg" alt="Item-level UHF RFID labels on prescription bottles for DSCSA compliance" loading="lazy" />
            </div>
            <div class="card-body">
              <h3>DSCSA-ready UHF labels at 380 million units a year</h3>
              <p>A US specialty-pharmacy distributor labels every prescription bottle and carton with GS1 SGTIN-96-encoded UHF RFID to satisfy the FDA's DSCSA interoperability requirements at full line speed.</p>
              <div class="card-metrics">
                <div><div class="cm-num">380M<span>/yr</span></div><div class="cm-lbl">Units labelled</div></div>
                <div><div class="cm-num">14k</div><div class="cm-lbl">Prescriber accounts</div></div>
              </div>
              <a class="card-link" href="/case-studies/pharmaceutical-dscsa-uhf-rfid/">Read the story <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </article>

          <!-- Restaurants -->
          <article class="card reveal">
            <div class="card-media">
              <span class="chip">Restaurants</span>
              <img src="/landing-images/restaurant-google-review-nfc-card-hero.jpg" alt="Tabletop Google Review NFC card in a fast-casual restaurant booth" loading="lazy" />
            </div>
            <div class="card-body">
              <h3>3.1× more Google reviews across 412 restaurants</h3>
              <p>A US fast-casual chain put an NTAG215 tap-to-review card in every booth and at every takeout counter — each encoded with that store's unique Google Review URL. Reviews per store tripled.</p>
              <div class="card-metrics">
                <div><div class="cm-num">3.1<span>×</span></div><div class="cm-lbl">Review lift</div></div>
                <div><div class="cm-num">412</div><div class="cm-lbl">Stores</div></div>
              </div>
              <a class="card-link" href="/case-studies/restaurant-google-review-nfc-card/">Read the story <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </article>

          <!-- Retail & Apparel -->
          <article class="card reveal">
            <div class="card-media">
              <span class="chip">Retail &amp; Apparel</span>
              <img src="/landing-images/retail-apparel-uhf-rfid-source-tagging-hero.jpg" alt="UHF RFID hang-tag labels source-tagged on apparel" loading="lazy" />
            </div>
            <div class="card-body">
              <h3>Source-tagging 11 million apparel units a year with UHF</h3>
              <p>A North American mid-tier retailer tags every full-price garment with Monza R6-P hang-tag labels at the factory — lifting store inventory accuracy from 67% visual counts to 98%.</p>
              <div class="card-metrics">
                <div><div class="cm-num">98<span>%</span></div><div class="cm-lbl">Inventory accuracy</div></div>
                <div><div class="cm-num">11M<span>/yr</span></div><div class="cm-lbl">Units tagged</div></div>
              </div>
              <a class="card-link" href="/case-studies/retail-apparel-uhf-rfid-source-tagging/">Read the story <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- INDUSTRIES -->
    <section id="industries" style="padding-top:20px">
      <div class="wrap">
        <div class="industries reveal">
          <div class="in-inner">
            <div>
              <span class="eyebrow" style="color:#8fb4ff">Where we deploy</span>
              <h2 style="margin-top:12px">Built for the places tags get tested</h2>
              <p>High heat, metal, moisture, chemicals, crowds. If the environment is tough on electronics, that's exactly where our engineering earns its keep.</p>
            </div>
            <div class="chips">
              <span>Hospitality</span><span>Healthcare</span><span>Events &amp; Venues</span>
              <span>Manufacturing</span><span>Retail &amp; Apparel</span><span>Logistics</span>
              <span>Laundry Services</span><span>Education</span><span>Agriculture</span>
              <span>Luxury &amp; Brand Protection</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section id="testimonials" style="background:var(--bg-alt)">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow" style="justify-content:center">In their words</span>
          <h2>Engineers who sweat the RFID physics</h2>
        </div>
        <div class="tgrid">
          <div class="tcard reveal">
            <div class="stars">★★★★★</div>
            <p>"Proud Tek engineered a tag that survives our autoclave. Nobody else would even quote it."</p>
            <div class="who"><span class="av">PL</span><div><div class="nm">Plant Manager</div><div class="rl">Industrial Laundry Group</div></div></div>
          </div>
          <div class="tcard reveal">
            <div class="stars">★★★★★</div>
            <p>"Samples in a week, production in a month. Their team actually understands read-range and antenna tuning."</p>
            <div class="who"><span class="av">SI</span><div><div class="nm">Systems Integrator</div><div class="rl">Access Control Partner</div></div></div>
          </div>
          <div class="tcard reveal">
            <div class="stars">★★★★★</div>
            <p>"Read rates held up on metal assets where our previous supplier's tags simply failed in the field."</p>
            <div class="who"><span class="av">RL</span><div><div class="nm">Reliability Lead</div><div class="rl">Aerospace MRO</div></div></div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="contact">
      <div class="wrap">
        <div class="cta-band reveal">
          <div class="c-inner">
            <span class="eyebrow" style="color:#cfe0ff;justify-content:center">Start your project</span>
            <h2 style="margin-top:14px">Have a similar challenge?</h2>
            <p>Tell us about your environment — wash cycles, materials, read range, volumes — and our engineers will spec the right tag and send free samples before you commit.</p>
            <div class="cta-actions">
              <a class="btn btn-white" href="/contact/" id="sample">Request a quote
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
              <a class="btn btn-light" href="/contact/?intent=engineering">Talk to engineering</a>
            </div>
          </div>
        </div>
      </div>
    </section>
    </div>
  </main>

  <Fragment set:html={chrome.afterMainHtml} />
</BaseLayout>

<style is:global>

  .pt-cs{
    --bg:#ffffff;
    --bg-soft:#f4f8ff;
    --bg-alt:#f7f9fc;
    --ink:#0a1a3c;
    --ink-2:#1b2a49;
    --muted:#5a6b8c;
    --muted-2:#7c89a6;
    --primary:#1d5cff;
    --primary-dark:#123fce;
    --primary-soft:#e7f0ff;
    --accent:#00b8bd;
    --border:#e6ecf5;
    --border-2:#eef2f8;
    --shadow-sm:0 1px 2px rgba(16,32,74,.05);
    --shadow-md:0 10px 30px -12px rgba(16,32,74,.18);
    --shadow-lg:0 30px 60px -22px rgba(16,32,74,.28);
    --radius:18px;
    --radius-sm:12px;
    --maxw:1200px;
  }
  .pt-cs *{box-sizing:border-box;margin:0;padding:0}
  
  .pt-cs{
    scroll-behavior:smooth;-webkit-text-size-adjust:100%;
    font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    color:var(--ink-2);
    background:var(--bg);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
  }
  .pt-cs a{color:inherit;text-decoration:none}
  .pt-cs img{max-width:100%;display:block}
  .pt-cs .wrap{width:100%;max-width:var(--maxw);margin:0 auto;padding:0 24px}
  .pt-cs h1, .pt-cs h2, .pt-cs h3{color:var(--ink);letter-spacing:-.02em;line-height:1.1;font-weight:800}
  .pt-cs .eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-size:12.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
    color:var(--primary);
  }
  .pt-cs .eyebrow::before{content:"";width:22px;height:2px;border-radius:2px;background:var(--primary)}
  .pt-cs .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:9px;
    font-weight:600;font-size:15px;line-height:1;
    padding:14px 22px;border-radius:12px;border:1px solid transparent;
    cursor:pointer;transition:transform .15s ease,box-shadow .2s ease,background .2s ease,border-color .2s ease;
    white-space:nowrap;
  }
  .pt-cs .btn svg{width:16px;height:16px}
  .pt-cs .btn-primary{background:var(--primary);color:#fff;box-shadow:0 8px 20px -8px rgba(29,92,255,.6)}
  .pt-cs .btn-primary:hover{background:var(--primary-dark);transform:translateY(-2px);box-shadow:0 14px 26px -10px rgba(29,92,255,.65)}
  .pt-cs .btn-ghost{background:#fff;color:var(--ink);border-color:var(--border)}
  .pt-cs .btn-ghost:hover{border-color:var(--primary);color:var(--primary);transform:translateY(-2px)}
  .pt-cs .btn-light{background:rgba(255,255,255,.14);color:#fff;border-color:rgba(255,255,255,.28)}
  .pt-cs .btn-light:hover{background:rgba(255,255,255,.24);transform:translateY(-2px)}
  .pt-cs .btn-white{background:#fff;color:var(--primary-dark)}
  .pt-cs .btn-white:hover{transform:translateY(-2px);box-shadow:0 14px 30px -12px rgba(0,0,0,.4)}

  /* ---------- NAV ---------- */
  .pt-cs header.nav{
    position:sticky;top:0;z-index:50;
    background:rgba(255,255,255,.82);
    backdrop-filter:saturate(180%) blur(14px);
    -webkit-backdrop-filter:saturate(180%) blur(14px);
    border-bottom:1px solid var(--border-2);
  }
  .pt-cs .nav-inner{display:flex;align-items:center;justify-content:space-between;height:70px}
  .pt-cs .logo{display:flex;align-items:center;gap:10px;font-weight:800;color:var(--ink);font-size:19px;letter-spacing:-.02em}
  .pt-cs .logo .mark{
    width:34px;height:34px;border-radius:9px;
    background:linear-gradient(135deg,var(--primary),#4f86ff);
    display:grid;place-items:center;box-shadow:0 6px 14px -6px rgba(29,92,255,.7)
  }
  .pt-cs .logo .mark svg{width:20px;height:20px}
  .pt-cs .nav-links{display:flex;align-items:center;gap:30px}
  .pt-cs .nav-links a{font-size:14.5px;font-weight:500;color:var(--ink-2);transition:color .15s}
  .pt-cs .nav-links a:hover{color:var(--primary)}
