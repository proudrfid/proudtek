   font-family: var(--codex-font-body);
@@ -375,7 +375,7 @@ html body .codex-native-shell .codex-native-header__menu .codex-mobile-menu-labe
   padding: var(--codex-space-3) 0 var(--codex-space-5) var(--codex-space-4);
 }
 
-.codex-native-mobile-menu__group h2 {
+.codex-native-mobile-menu__group .codex-nav-group-label {
   margin: 0 0 var(--codex-space-2);
   color: var(--codex-gold-muted);
   font-family: var(--codex-font-body);
@@ -484,7 +484,7 @@ html body .codex-native-shell .codex-native-header__menu .codex-mobile-menu-labe
   gap: var(--codex-space-8);
 }
 
-.codex-native-footer__nav h2 {
+.codex-native-footer__nav .codex-nav-group-label {
   margin: 0 0 var(--codex-space-3);
   color: var(--codex-gold-light);
   font-family: var(--codex-font-body);
@@ -574,7 +574,7 @@ html body .codex-native-shell .codex-native-header__menu .codex-mobile-menu-labe
     color: var(--codex-color-accent) !important;
   }
 
-  html body .codex-native-shell #mobile-drawer.codex-native-drawer #mobile-menu .codex-native-mobile-menu__group h2 {
+  html body .codex-native-shell #mobile-drawer.codex-native-drawer #mobile-menu .codex-native-mobile-menu__group .codex-nav-group-label {
     color: var(--codex-gold-muted) !important;
   }
 
