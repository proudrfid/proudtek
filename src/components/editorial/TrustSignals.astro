---
/**
 * Editorial trust signals block — static badge row at the bottom of every
 * non-contact editorial page.
 *
 * Audit 2026-09-02 (Phase 4 K-08/K-09, owner decision): the strip formerly
 * read "ISO 9001 Certified Factory · 500+ Enterprise Clients · 50+ Countries
 * Served" and promised "free samples … with every order". The certificates
 * on file cover the *sales service* scope (issuer CAIC), and the client /
 * country counts have no documentary basis, so the strip now states only
 * what the certificates and the published sample policy support.
 */
import { yearsInOperation } from "../../lib/seo-content";
---
<section class="codex-trust-signals">
  <div class="codex-trust-stats">
    <div class="codex-trust-stat">
      <strong>Since 2008</strong>
      <span>Shenzhen, China</span>
    </div>
    <div class="codex-trust-stat">
      <strong>ISO 9001:2015</strong>
      <span>Certified sales &amp; service QMS</span>
    </div>
    <div class="codex-trust-stat">
      <strong>ISO 14001 · 45001</strong>
      <span>Certificates published</span>
    </div>
    <div class="codex-trust-stat">
      <strong>{yearsInOperation()} years</strong>
      <span>In operation</span>
    </div>
  </div>
  <p class="codex-trust-note">Proud Tek is a Shenzhen-based RFID &amp; NFC manufacturing partner for hotels, laundries, events, retail and industrial programmes: we own the specification, chip sourcing and quality control, and tooling and production run on contracted partner lines to our spec. Certificate numbers and scope are published on <a href="/about/certifications/">the certifications page</a>; standard samples are free for qualified B2B buyers (DHL/FedEx freight at your cost, refunded against your first production order).</p>
</section>
